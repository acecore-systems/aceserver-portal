{
  "name": "aceserver-portal",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "vectorize": [
    {
      "binding": "WIKI_SEARCH_INDEX",
      "index_name": "aceserver-wiki-search-openai-1536-preview",
    },
    {
      "binding": "PORTAL_SEARCH_INDEX",
      "index_name": "aceserver-portal-search-openai-1536-preview",
    },
    {
      "binding": "ACECORE_SEARCH_INDEX",
      "index_name": "acecore-net-search-openai-1536-preview",
    },
    {
      "binding": "SCHOOLS_SEARCH_INDEX",
      "index_name": "acecore-schools-search-openai-1536-preview",
    },
    {
      "binding": "SYSTEMS_SEARCH_INDEX",
      "index_name": "acecore-systems-search-openai-1536-preview",
    },
    {
      "binding": "WORLD_FOUNDATION_SEARCH_INDEX",
      "index_name": "world-foundation-search-openai-1536-preview",
    },
  ],
  "vars": {
    "OPENAI_RESPONSE_MODEL": "gpt-5.6-luna",
    "OPENAI_REASONING_EFFORT": "low",
    "OPENAI_EMBEDDING_MODEL": "text-embedding-3-large",
    "OPENAI_EMBEDDING_DIMENSIONS": "1536",
    "WIKI_SEARCH_ENABLED": "true",
    "WIKI_SEARCH_MIN_SCORE": "0.40",
    "PORTAL_SEARCH_ENABLED": "true",
    "PORTAL_SEARCH_MIN_SCORE": "0.45",
    "ACECORE_SEARCH_ENABLED": "true",
    "ACECORE_SEARCH_MIN_SCORE": "0.50",
    "SCHOOLS_SEARCH_ENABLED": "true",
    "SCHOOLS_SEARCH_MIN_SCORE": "0.50",
    "SYSTEMS_SEARCH_ENABLED": "true",
    "SYSTEMS_SEARCH_MIN_SCORE": "0.50",
    "WORLD_FOUNDATION_SEARCH_ENABLED": "true",
    "WORLD_FOUNDATION_SEARCH_MIN_SCORE": "0.40",
  },
  "env": {
    "preview": {
      "vectorize": [
        {
          "binding": "WIKI_SEARCH_INDEX",
          "index_name": "aceserver-wiki-search-openai-1536-preview",
        },
        {
          "binding": "PORTAL_SEARCH_INDEX",
          "index_name": "aceserver-portal-search-openai-1536-preview",
        },
        {
          "binding": "ACECORE_SEARCH_INDEX",
          "index_name": "acecore-net-search-openai-1536-preview",
        },
        {
          "binding": "SCHOOLS_SEARCH_INDEX",
          "index_name": "acecore-schools-search-openai-1536-preview",
        },
        {
          "binding": "SYSTEMS_SEARCH_INDEX",
          "index_name": "acecore-systems-search-openai-1536-preview",
        },
        {
          "binding": "WORLD_FOUNDATION_SEARCH_INDEX",
          "index_name": "world-foundation-search-openai-1536-preview",
        },
      ],
      "vars": {
        "OPENAI_RESPONSE_MODEL": "gpt-5.6-luna",
        "OPENAI_REASONING_EFFORT": "low",
        "OPENAI_EMBEDDING_MODEL": "text-embedding-3-large",
        "OPENAI_EMBEDDING_DIMENSIONS": "1536",
        "WIKI_SEARCH_ENABLED": "true",
        "WIKI_SEARCH_MIN_SCORE": "0.40",
        "PORTAL_SEARCH_ENABLED": "true",
        "PORTAL_SEARCH_MIN_SCORE": "0.45",
        "ACECORE_SEARCH_ENABLED": "true",
        "ACECORE_SEARCH_MIN_SCORE": "0.50",
        "SCHOOLS_SEARCH_ENABLED": "true",
        "SCHOOLS_SEARCH_MIN_SCORE": "0.50",
        "SYSTEMS_SEARCH_ENABLED": "true",
        "SYSTEMS_SEARCH_MIN_SCORE": "0.50",
        "WORLD_FOUNDATION_SEARCH_ENABLED": "true",
        "WORLD_FOUNDATION_SEARCH_MIN_SCORE": "0.40",
      },
    },
    "production": {
      "vectorize": [
        {
          "binding": "WIKI_SEARCH_INDEX",
          "index_name": "aceserver-wiki-search-openai-1536-production",
        },
        {
          "binding": "PORTAL_SEARCH_INDEX",
          "index_name": "aceserver-portal-search-openai-1536-production",
        },
        {
          "binding": "ACECORE_SEARCH_INDEX",
          "index_name": "acecore-net-search-openai-1536-production",
        },
        {
          "binding": "SCHOOLS_SEARCH_INDEX",
          "index_name": "acecore-schools-search-openai-1536-production",
        },
        {
          "binding": "SYSTEMS_SEARCH_INDEX",
          "index_name": "acecore-systems-search-openai-1536-production",
        },
        {
          "binding": "WORLD_FOUNDATION_SEARCH_INDEX",
          "index_name": "world-foundation-search-openai-1536-production",
        },
      ],
      "vars": {
        "OPENAI_RESPONSE_MODEL": "gpt-5.6-luna",
        "OPENAI_REASONING_EFFORT": "low",
        "OPENAI_EMBEDDING_MODEL": "text-embedding-3-large",
        "OPENAI_EMBEDDING_DIMENSIONS": "1536",
        "WIKI_SEARCH_ENABLED": "true",
        "WIKI_SEARCH_MIN_SCORE": "0.40",
        "PORTAL_SEARCH_ENABLED": "true",
        "PORTAL_SEARCH_MIN_SCORE": "0.45",
        "ACECORE_SEARCH_ENABLED": "true",
        "ACECORE_SEARCH_MIN_SCORE": "0.50",
        "SCHOOLS_SEARCH_ENABLED": "true",
        "SCHOOLS_SEARCH_MIN_SCORE": "0.50",
        "SYSTEMS_SEARCH_ENABLED": "true",
        "SYSTEMS_SEARCH_MIN_SCORE": "0.50",
        "WORLD_FOUNDATION_SEARCH_ENABLED": "true",
        "WORLD_FOUNDATION_SEARCH_MIN_SCORE": "0.40",
      },
    },
  },
}
