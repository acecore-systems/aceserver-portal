{
  "name": "aceserver-portal",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI",
  },
  "vectorize": [
    {
      "binding": "WIKI_SEARCH_INDEX",
      "index_name": "aceserver-wiki-search-preview",
    },
    {
      "binding": "PORTAL_SEARCH_INDEX",
      "index_name": "aceserver-portal-search-preview",
    },
    {
      "binding": "ACECORE_SEARCH_INDEX",
      "index_name": "acecore-net-search-preview",
    },
    {
      "binding": "SCHOOLS_SEARCH_INDEX",
      "index_name": "acecore-schools-search-preview",
    },
    {
      "binding": "SYSTEMS_SEARCH_INDEX",
      "index_name": "acecore-systems-search-preview",
    },
    {
      "binding": "WORLD_FOUNDATION_SEARCH_INDEX",
      "index_name": "world-foundation-search-preview",
    },
  ],
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "db9b62f409f463da7acbcc374b8385d0",
    "CLOUDFLARE_AI_MODEL": "@cf/zai-org/glm-5.2",
    "WIKI_SEARCH_ENABLED": "true",
    "WIKI_SEARCH_MIN_SCORE": "0.40",
    "PORTAL_SEARCH_ENABLED": "true",
    "PORTAL_SEARCH_MIN_SCORE": "0.45",
    "ACECORE_SEARCH_ENABLED": "true",
    "ACECORE_SEARCH_MIN_SCORE": "0.50",
    "SCHOOLS_SEARCH_ENABLED": "true",
    "SCHOOLS_SEARCH_MIN_SCORE": "0.50",
    "SYSTEMS_SEARCH_ENABLED": "true",
    "SYSTEMS_SEARCH_MIN_SCORE": "0.50",
    "WORLD_FOUNDATION_SEARCH_ENABLED": "true",
    "WORLD_FOUNDATION_SEARCH_MIN_SCORE": "0.40",
  },
  "env": {
    "preview": {
      "ai": {
        "binding": "AI",
      },
      "vectorize": [
        {
          "binding": "WIKI_SEARCH_INDEX",
          "index_name": "aceserver-wiki-search-preview",
        },
        {
          "binding": "PORTAL_SEARCH_INDEX",
          "index_name": "aceserver-portal-search-preview",
        },
        {
          "binding": "ACECORE_SEARCH_INDEX",
          "index_name": "acecore-net-search-preview",
        },
        {
          "binding": "SCHOOLS_SEARCH_INDEX",
          "index_name": "acecore-schools-search-preview",
        },
        {
          "binding": "SYSTEMS_SEARCH_INDEX",
          "index_name": "acecore-systems-search-preview",
        },
        {
          "binding": "WORLD_FOUNDATION_SEARCH_INDEX",
          "index_name": "world-foundation-search-preview",
        },
      ],
      "vars": {
        "CLOUDFLARE_ACCOUNT_ID": "db9b62f409f463da7acbcc374b8385d0",
        "CLOUDFLARE_AI_MODEL": "@cf/zai-org/glm-5.2",
        "WIKI_SEARCH_ENABLED": "true",
        "WIKI_SEARCH_MIN_SCORE": "0.40",
        "PORTAL_SEARCH_ENABLED": "true",
        "PORTAL_SEARCH_MIN_SCORE": "0.45",
        "ACECORE_SEARCH_ENABLED": "true",
        "ACECORE_SEARCH_MIN_SCORE": "0.50",
        "SCHOOLS_SEARCH_ENABLED": "true",
        "SCHOOLS_SEARCH_MIN_SCORE": "0.50",
        "SYSTEMS_SEARCH_ENABLED": "true",
        "SYSTEMS_SEARCH_MIN_SCORE": "0.50",
        "WORLD_FOUNDATION_SEARCH_ENABLED": "true",
        "WORLD_FOUNDATION_SEARCH_MIN_SCORE": "0.40",
      },
    },
    "production": {
      "ai": {
        "binding": "AI",
      },
      "vectorize": [
        {
          "binding": "WIKI_SEARCH_INDEX",
          "index_name": "aceserver-wiki-search-production",
        },
        {
          "binding": "PORTAL_SEARCH_INDEX",
          "index_name": "aceserver-portal-search-production",
        },
        {
          "binding": "ACECORE_SEARCH_INDEX",
          "index_name": "acecore-net-search-production",
        },
        {
          "binding": "SCHOOLS_SEARCH_INDEX",
          "index_name": "acecore-schools-search-production",
        },
        {
          "binding": "SYSTEMS_SEARCH_INDEX",
          "index_name": "acecore-systems-search-production",
        },
        {
          "binding": "WORLD_FOUNDATION_SEARCH_INDEX",
          "index_name": "world-foundation-search-production",
        },
      ],
      "vars": {
        "CLOUDFLARE_ACCOUNT_ID": "db9b62f409f463da7acbcc374b8385d0",
        "CLOUDFLARE_AI_MODEL": "@cf/zai-org/glm-5.2",
        "WIKI_SEARCH_ENABLED": "true",
        "WIKI_SEARCH_MIN_SCORE": "0.40",
        "PORTAL_SEARCH_ENABLED": "true",
        "PORTAL_SEARCH_MIN_SCORE": "0.45",
        "ACECORE_SEARCH_ENABLED": "true",
        "ACECORE_SEARCH_MIN_SCORE": "0.50",
        "SCHOOLS_SEARCH_ENABLED": "true",
        "SCHOOLS_SEARCH_MIN_SCORE": "0.50",
        "SYSTEMS_SEARCH_ENABLED": "true",
        "SYSTEMS_SEARCH_MIN_SCORE": "0.50",
        "WORLD_FOUNDATION_SEARCH_ENABLED": "true",
        "WORLD_FOUNDATION_SEARCH_MIN_SCORE": "0.40",
      },
    },
  },
}
