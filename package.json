{
  "name": "aceserver-portal",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "predev": "node scripts/write-cms-runtime-config.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/write-cms-runtime-config.mjs && npm run validate:content",
    "build": "astro build",
    "postbuild": "node scripts/enrich-sitemap-i18n.mjs && npm run build:pagefind && npm run build:portal-corpus && npm run build:portal-meta && npm run validate:image-alts && npm run validate:story-output && npm run validate:i18n-output",
    "build:pagefind": "pagefind --site dist",
    "build:portal-corpus": "node scripts/build-portal-vector-corpus.mjs",
    "build:portal-meta": "node scripts/write-portal-build-meta.mjs",
    "preview": "astro preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "sync:youtube": "node scripts/sync-youtube-atom.mjs",
    "test:alpha": "node --experimental-strip-types --test tests/alpha-chat.test.mjs tests/alpha-chat-service-adapter.test.mjs",
    "test:portal-vectorize": "node --experimental-strip-types --test tests/portal-vectorize.test.mjs",
    "test:search": "node --experimental-strip-types --test tests/search-api.test.mjs tests/network-search-contract.test.mjs",
    "test:cms": "node --experimental-strip-types --import=./scripts/json-module-loader.mjs --test --test-concurrency=1 --test-isolation=none tests/cms-*.test.mjs",
    "test:content": "node --test tests/content-validation.test.mjs",
    "test:dynmap": "node --experimental-strip-types --test cloudflare/dynmap-r2-cache/worker.test.mjs",
    "test:i18n": "node --experimental-strip-types --test tests/i18n.test.mjs",
    "test:translation-merge": "node --test tests/translation-merge.test.mjs",
    "test:youtube-atom": "node --test tests/youtube-atom-sync.test.mjs",
    "typecheck:functions": "tsc --project tsconfig.functions.json && npm run typecheck:api",
    "typecheck:api": "tsc --project tsconfig.api.json",
    "types:functions": "wrangler types functions/worker-configuration.d.ts --config wrangler.jsonc --include-runtime false",
    "types:functions:check": "wrangler types functions/worker-configuration.d.ts --config wrangler.jsonc --include-runtime false --check",
    "types:dynmap": "wrangler types cloudflare/dynmap-r2-cache/worker-configuration.d.ts --config cloudflare/dynmap-r2-cache/wrangler.jsonc --include-runtime false",
    "types:dynmap:check": "wrangler types cloudflare/dynmap-r2-cache/worker-configuration.d.ts --config cloudflare/dynmap-r2-cache/wrangler.jsonc --include-runtime false --check",
    "typecheck:dynmap": "tsc --project cloudflare/dynmap-r2-cache/tsconfig.json",
    "validate:content": "node scripts/validate-content.mjs && node scripts/validate-i18n.mjs",
    "validate:i18n": "node scripts/validate-i18n.mjs",
    "validate:i18n-output": "node scripts/validate-i18n-output.mjs",
    "validate:image-alts": "node scripts/validate-image-alts.mjs",
    "validate:story-output": "node scripts/validate-story-output.mjs",
    "sync:portal-vectorize": "node scripts/sync-portal-vectorize.mjs",
    "sync:portal-vectorize:dry-run": "node scripts/sync-portal-vectorize.mjs --dry-run"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "astro": "^7.2.9",
    "graphql": "^17.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260827.1",
    "@iconify-json/lucide": "^1.2.126",
    "@tailwindcss/vite": "^4.3.3",
    "mdast-util-from-markdown": "^2.0.3",
    "pagefind": "^1.5.2",
    "parse5": "^8.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "4.127.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260811.1": true
  }
}
