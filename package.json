{
  "name": "aceserver-portal",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "predev": "node scripts/write-cms-runtime-config.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/write-cms-runtime-config.mjs",
    "build": "astro build",
    "postbuild": "npm run validate:image-alts",
    "preview": "astro preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test:alpha": "node --test tests/alpha-chat.test.mjs",
    "test:cms": "node --test tests/cms-proxy.test.mjs",
    "test:dynmap": "node --test cloudflare/dynmap-r2-cache/worker.test.mjs",
    "typecheck:functions": "tsc --project tsconfig.functions.json",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:image-alts": "node scripts/validate-image-alts.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@unocss/astro": "^66.7.5",
    "astro": "^7.1.3",
    "graphql": "^17.0.2",
    "unocss": "^66.7.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260723.1",
    "@iconify-json/lucide": "^1.2.118",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
