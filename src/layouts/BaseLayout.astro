---
import '@fontsource/noto-sans-jp/400.css'
import '@fontsource/noto-sans-jp/700.css'
import '@fontsource/noto-sans-jp/900.css'
import AnnouncementBanner from '../components/AnnouncementBanner.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import AdUnit from '../components/AdUnit.astro'
import AdsRuntime from '../components/AdsRuntime.astro'
import AlphaGuide from '../components/AlphaGuide.astro'
import { ADSENSE } from '../data/ads'
import { ACECORE_ORGANIZATION } from '../data/organization'
import { serializeJsonForHtmlScript } from '../data/safe-json'
import { getLocalizedSettings } from '../i18n/content'
import {
  getAlternatePaths,
  HTML_LANG_BY_LOCALE,
  localizePath,
  OGP_LOCALE_BY_LOCALE,
  type Locale,
} from '../i18n/config'
import { getUi } from '../i18n/translations'
import { buildSeoDescription, buildSeoTitle } from '../utils/seo-meta'

interface Props {
  locale?: Locale
  title?: string
  description?: string
  image?: string
  imageAlt?: string
  hideFooter?: boolean
  fullHeight?: boolean
  plainBackground?: boolean
  robots?: string
  canonical?: string | null
  showAds?: boolean
  ogType?: 'website' | 'article'
}

const {
  locale = 'ja',
  title: titleInput,
  description: descriptionInput,
  image: imageInput,
  imageAlt: imageAltInput,
  hideFooter = false,
  fullHeight = false,
  plainBackground = false,
  robots = 'index, follow',
  canonical: canonicalInput = Astro.url.pathname,
  showAds = false,
  ogType = 'website',
} = Astro.props
const settings = getLocalizedSettings(locale)
const ui = getUi(locale)
const title = titleInput ?? settings.title
const description = buildSeoDescription({
  description: descriptionInput ?? settings.description,
  shortDescriptionContext: settings.description,
})
const image = imageInput ?? settings.logo
const siteBase = Astro.site ?? new URL(settings.siteUrl)
const canonical =
  canonicalInput === null ? null : new URL(canonicalInput, siteBase)
const pageUrl = canonical ?? new URL(Astro.url.pathname, siteBase)
const pageTitle = buildSeoTitle({
  title,
  siteTitle: settings.shortTitle,
  titleContext: ui.siteTitleSuffix,
  isHome: title === settings.title,
})
const socialTitle =
  title === settings.title ? pageTitle : `${title} | ${settings.shortTitle}`
const ogImage = new URL(image, siteBase)
const socialImageAlt =
  imageAltInput ?? (image === settings.logo ? settings.logoAlt : title)
const logoUrl = new URL(settings.logo, siteBase)
const organizationHomeUrl = new URL('/', siteBase)
const homeUrl = new URL(localizePath(locale, '/'), siteBase)
const organizationId = `${organizationHomeUrl}#organization`
const acecoreOrganizationId = `${ACECORE_ORGANIZATION.url}#organization`
const websiteId = `${homeUrl}#website`
const webpageId = `${pageUrl.href}#webpage`
const shouldShowAds = showAds && ADSENSE.enabled
const alphaLogo = '/uploads/alpha-kun.png'
const alphaJoinButton = {
  label: ui.joinDiscord,
  href: settings.discordUrl,
  external: true,
}
const alphaWikiButton = {
  label: ui.openWiki,
  href: settings.wikiUrl,
  external: true,
}
const websiteJsonLd = serializeJsonForHtmlScript({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': websiteId,
  name: settings.title,
  alternateName: settings.shortTitle,
  url: homeUrl.toString(),
  description,
  inLanguage: HTML_LANG_BY_LOCALE[locale],
  publisher: { '@id': organizationId },
})
const organizationJsonLd = serializeJsonForHtmlScript({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': organizationId,
  name: settings.shortTitle,
  url: organizationHomeUrl.toString(),
  logo: logoUrl.toString(),
  parentOrganization: {
    '@type': 'Organization',
    '@id': acecoreOrganizationId,
    name: ACECORE_ORGANIZATION.name,
    legalName: ACECORE_ORGANIZATION.legalName,
    url: ACECORE_ORGANIZATION.url,
  },
  sameAs: [settings.discordUrl, settings.wikiUrl],
})
const webpageJsonLd = serializeJsonForHtmlScript({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': webpageId,
  url: pageUrl.toString(),
  name: pageTitle,
  description,
  image: ogImage.toString(),
  inLanguage: HTML_LANG_BY_LOCALE[locale],
  isPartOf: { '@id': websiteId },
  about: { '@id': organizationId },
})
const alternatePaths = getAlternatePaths(pageUrl.pathname)
const alternateUrls = alternatePaths.map((alternate) => ({
  ...alternate,
  url: new URL(alternate.href, siteBase),
}))
const defaultAlternateUrl =
  alternateUrls.find((alternate) => alternate.locale === 'ja')?.url ??
  new URL('/', siteBase)
const rssUrl = new URL(localizePath(locale, '/rss.xml'), siteBase)
---

<!doctype html>
<html lang={HTML_LANG_BY_LOCALE[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="format-detection" content="telephone=no" />
    <meta name="msvalidate.01" content="B670753BF4A50FA5437E5694CB04BAFD" />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#15130f" />
    {canonical && <link rel="canonical" href={canonical} />}
    {
      alternateUrls.map((alternate) => (
        <link
          rel="alternate"
          hreflang={HTML_LANG_BY_LOCALE[alternate.locale]}
          href={alternate.url}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={defaultAlternateUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={ui.rssTitle}
      href={rssUrl}
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/uploads/legacy-acico.png" />
    {
      shouldShowAds && (
        <>
          <meta name="google-adsense-account" content={ADSENSE.clientId} />
          <link
            rel="dns-prefetch"
            href="https://pagead2.googlesyndication.com"
          />
          <link rel="dns-prefetch" href="https://googleads.g.doubleclick.net" />
          <link
            rel="preconnect"
            href="https://pagead2.googlesyndication.com"
            crossorigin="anonymous"
          />
        </>
      )
    }
    <title>{pageTitle}</title>
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={OGP_LOCALE_BY_LOCALE[locale]} />
    {
      alternateUrls
        .filter((alternate) => alternate.locale !== locale)
        .map((alternate) => (
          <meta
            property="og:locale:alternate"
            content={OGP_LOCALE_BY_LOCALE[alternate.locale]}
          />
        ))
    }
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={settings.title} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <script type="application/ld+json" set:html={websiteJsonLd} />
    <script type="application/ld+json" set:html={organizationJsonLd} />
    <script type="application/ld+json" set:html={webpageJsonLd} />
  </head>
  <body
    class:list={[
      {
        'has-plain-background': plainBackground,
        'is-article': ogType === 'article',
        'is-full-height': fullHeight,
      },
    ]}
  >
    <a class="skip-link" href="#main">{ui.skipToContent}</a>
    <Header locale={locale} />
    <AnnouncementBanner locale={locale} />
    <main id="main" tabindex="-1">
      <slot />
      {shouldShowAds && <AdUnit locale={locale} />}
    </main>
    {!hideFooter && <Footer locale={locale} />}
    <AlphaGuide
      locale={locale}
      logo={alphaLogo}
      joinButton={alphaJoinButton}
      wikiButton={alphaWikiButton}
    />
    {shouldShowAds && <AdsRuntime />}
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --asv-ink: #15130f;
    --asv-wood: #2b2118;
    --asv-parchment: #fff5dc;
    --asv-gold: #ffd84d;
    --asv-green: #35aa2f;
    --asv-blue: #0aa7e2;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
  }

  body {
    background:
      linear-gradient(180deg, #87dfff 0, #f9efd0 45%, #15130f 100%), #fff5dc;
    color: var(--asv-ink);
    font-family:
      'Noto Sans JP', 'Hiragino Sans', 'Yu Gothic UI', 'Yu Gothic', Meiryo,
      system-ui, sans-serif;
    line-height: 1.7;
    overflow-wrap: anywhere;
    text-rendering: optimizeLegibility;
  }

  body.is-article,
  body.has-plain-background {
    background: #fff5dc;
  }

  body.is-full-height main {
    min-height: calc(100vh - 72px);
  }

  img,
  iframe {
    max-width: 100%;
  }

  img {
    display: block;
  }

  a {
    color: inherit;
  }

  main:focus {
    outline: none;
  }

  main table {
    width: 100%;
    margin: clamp(24px, 4vw, 36px) 0;
    border: 2px solid #1e1710;
    border-spacing: 0;
    border-radius: 12px;
    background: #fffdf5;
    color: #1e1710;
    font-size: 0.92em;
    line-height: 1.65;
    overflow: hidden;
    box-shadow: 0 6px 0 rgba(21, 19, 15, 0.18);
  }

  main th,
  main td {
    text-align: left;
    vertical-align: top;
  }

  main th {
    border-right: 1px solid rgba(255, 248, 230, 0.32);
    background: #1e1710;
    padding: 14px 16px;
    color: #fff8e6;
    font-weight: 900;
  }

  main th:last-child {
    border-right: 0;
  }

  main td {
    border-top: 1px solid #d7c9ae;
    border-right: 1px solid #d7c9ae;
    padding: 15px 16px;
  }

  main td:last-child {
    border-right: 0;
  }

  .skip-link {
    position: fixed;
    top: 10px;
    left: 10px;
    z-index: 100;
    border-radius: 8px;
    background: #15130f;
    color: #fff5dc;
    font-weight: 900;
    padding: 10px 14px;
    text-decoration: none;
    transform: translateY(-160%);
    transition: transform 160ms ease;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  button,
  input,
  textarea,
  select {
    font: inherit;
  }

  .pixel-border {
    box-shadow:
      0 0 0 2px rgba(46, 34, 22, 0.92),
      inset 0 0 0 2px rgba(255, 255, 255, 0.18),
      0 8px 0 rgba(34, 23, 13, 0.25);
  }

  @media (max-width: 700px) {
    main table[data-responsive-table] {
      display: block;
      border: 0;
      border-radius: 0;
      background: transparent;
      font-size: 0.96em;
      overflow: visible;
      box-shadow: none;
    }

    main table[data-responsive-table] thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      white-space: nowrap;
    }

    main table[data-responsive-table] tbody {
      display: grid;
      gap: 14px;
    }

    main table[data-responsive-table] tbody tr {
      display: block;
      overflow: hidden;
      border: 2px solid #1e1710;
      border-radius: 12px;
      background: #fffdf5;
      box-shadow: 0 5px 0 rgba(21, 19, 15, 0.16);
    }

    main table[data-responsive-table] tbody td {
      display: grid;
      grid-template-columns: minmax(86px, 0.7fr) minmax(0, 1.3fr);
      gap: 8px 14px;
      border: 0;
      border-top: 1px solid #d7c9ae;
      padding: 11px 13px;
    }

    main table[data-responsive-table] tbody td:first-child {
      border-top: 0;
    }

    main table[data-responsive-table] tbody td::before {
      content: attr(data-label);
      color: #514331;
      font-size: 0.82em;
      font-weight: 900;
      line-height: 1.45;
    }

    main table:not([data-responsive-table]) {
      display: block;
      max-width: 100%;
      overflow-x: auto;
    }

    main table:not([data-responsive-table]) th,
    main table:not([data-responsive-table]) td {
      min-width: 9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.001ms !important;
    }
  }
</style>
