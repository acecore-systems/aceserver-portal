---
import type { Locale } from '../i18n/config'
import { localizePath } from '../i18n/config'
import { getUi } from '../i18n/translations'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const ui = getUi(locale)
---

<section
  class="site-search"
  data-site-search
  data-locale={locale}
  data-own-source="portal"
  data-loading={ui.search.loading}
  data-no-results={ui.search.noResults}
  data-pagefind-ignore
>
  <h1>{ui.search.title}</h1>
  <form
    class="site-search__form"
    action={localizePath(locale, '/search/')}
    method="get"
    role="search"
  >
    <label class="sr-only" for="site-search-query">{ui.search.title}</label>
    <input
      id="site-search-query"
      data-search-query
      name="q"
      type="search"
      placeholder={ui.search.placeholder}
      autocomplete="off"
    />
    <button class="asv-btn-primary" type="submit">{ui.search.link}</button>
  </form>
  <p class="site-search__privacy">{ui.search.privacy}</p>
  <p class="site-search__status" data-search-status aria-live="polite">
    {ui.search.placeholder}
  </p>

  <section
    class="site-search__results"
    data-local-search-results
    aria-labelledby="site-search-local-title"
    hidden
  >
    <h2 id="site-search-local-title">{ui.search.localResults}</h2>
    <ol class="site-search__list" data-local-search-list></ol>
  </section>

  <section
    class="site-search__results site-search__results--network"
    data-network-search-results
    aria-labelledby="site-search-network-title"
    hidden
  >
    <h2 id="site-search-network-title">{ui.search.relatedSites}</h2>
    <ol class="site-search__list" data-network-search-list></ol>
  </section>
</section>

<script>
  import { initSiteSearch } from '../scripts/site-search'

  initSiteSearch()
  document.addEventListener('astro:after-swap', initSiteSearch)
</script>

<style>
  .site-search {
    width: min(100% - 32px, 850px);
    min-height: 56vh;
    margin: 0 auto;
    padding: clamp(52px, 9vw, 96px) 0;
  }

  h1,
  h2 {
    margin: 0;
    color: #25180f;
    font-weight: 900;
    line-height: 1.25;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.8rem);
  }

  h2 {
    font-size: clamp(1.3rem, 3vw, 1.8rem);
  }

  .site-search__form {
    display: flex;
    gap: 10px;
    margin-top: 28px;
  }

  .site-search__form input {
    width: 100%;
    min-width: 0;
    min-height: 50px;
    border: 2px solid rgba(75, 51, 30, 0.75);
    border-radius: 8px;
    background: #fffdf5;
    color: #25180f;
    padding: 0 14px;
  }

  .site-search__form input:focus-visible {
    outline: 3px solid #0aa7e2;
    outline-offset: 2px;
  }

  .site-search__privacy,
  .site-search__status {
    margin: 12px 0 0;
    color: rgba(37, 24, 15, 0.78);
    font-size: 0.9rem;
  }

  .site-search__status {
    min-height: 1.7em;
    font-weight: 700;
  }

  .site-search__results {
    margin-top: 40px;
    border-radius: 14px;
    background: rgba(255, 253, 245, 0.8);
    box-shadow: 0 8px 0 rgba(34, 23, 13, 0.18);
    padding: clamp(20px, 4vw, 32px);
  }

  .site-search__results--network {
    margin-top: 26px;
    border: 2px solid rgba(10, 167, 226, 0.35);
    background: rgba(235, 250, 255, 0.82);
  }

  .site-search__list {
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .site-search__list > :global(li) {
    border-top: 1px solid rgba(75, 51, 30, 0.24);
    padding: 18px 0;
  }

  .site-search__list > :global(li:last-child) {
    border-bottom: 1px solid rgba(75, 51, 30, 0.24);
  }

  .site-search__list :global(a) {
    color: #1b5f20;
    font-size: 1.05rem;
    font-weight: 900;
  }

  .site-search__list :global(a:hover) {
    color: #0b8a3b;
  }

  .site-search__list :global(p) {
    margin: 6px 0 0;
  }

  :global(.site-search__source) {
    display: inline-flex;
    margin-left: 8px;
    border: 1px solid rgba(10, 167, 226, 0.6);
    border-radius: 999px;
    color: #075779;
    font-size: 0.78rem;
    font-weight: 900;
    padding: 2px 8px;
    vertical-align: 0.1em;
  }

  @media (max-width: 560px) {
    .site-search__form {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
