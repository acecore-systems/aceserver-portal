---
import { ADSENSE } from '../data/ads'
import type { Locale } from '../i18n/config'
import { getUi } from '../i18n/translations'

interface Props {
  slotId?: string
  containerClass?: string
  locale?: Locale
}

const { slotId = ADSENSE.slotId, containerClass, locale = 'ja' } = Astro.props
const ui = getUi(locale)
---

<aside
  class:list={['ad-unit', containerClass]}
  aria-label={ui.advertisement}
  data-asv-ad-container
  data-asv-ad-state="pending"
  data-pagefind-ignore
>
  <span class="ad-label">{ui.advertisement}</span>
  <ins
    class="adsbygoogle"
    data-asv-ad-slot
    style="display:block"
    data-ad-client={ADSENSE.clientId}
    data-ad-slot={slotId}
    data-ad-format="auto"
    data-full-width-responsive="true"></ins>
</aside>

<style>
  .ad-unit {
    width: min(calc(100% - 36px), 980px);
    min-height: 132px;
    margin: clamp(30px, 5vw, 56px) auto;
    border: 2px solid rgba(43, 33, 24, 0.18);
    border-radius: 8px;
    background: rgba(255, 245, 220, 0.72);
    padding: 12px;
  }

  .ad-label {
    display: block;
    margin-bottom: 8px;
    color: rgba(21, 19, 15, 0.54);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1;
    text-align: center;
  }

  .adsbygoogle {
    min-height: 96px;
  }

  .ad-unit[data-asv-ad-state='empty'],
  .ad-unit[data-asv-ad-state='error'] {
    display: none;
  }

  @media (max-width: 640px) {
    .ad-unit {
      width: min(calc(100% - 24px), 980px);
      margin-block: 24px;
    }
  }
</style>
