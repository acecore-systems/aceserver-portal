---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import { serializeJsonForHtmlScript } from '../data/safe-json'
import { getLocalizedPages } from '../i18n/content'
import {
  DATE_LOCALE_BY_LOCALE,
  HTML_LANG_BY_LOCALE,
  localizePath,
  type Locale,
} from '../i18n/config'
import { getUi } from '../i18n/translations'
import BaseLayout from '../layouts/BaseLayout.astro'

interface Props {
  locale: Locale
  story: CollectionEntry<'stories'>
}

type RelatedContent = {
  kind: 'page' | 'story'
  href: string
  title: string
  description: string
  image?: string
  imageAlt?: string
}

const { locale, story } = Astro.props
const ui = getUi(locale)
const updatedLabelByLocale: Record<Locale, string> = {
  ja: '更新',
  en: 'Updated',
  'zh-cn': '更新',
  es: 'Actualizado',
  pt: 'Atualizado',
  fr: 'Mis à jour',
  ko: '업데이트',
  de: 'Aktualisiert',
  ru: 'Обновлено',
}
const { Content } = await render(story)
const storySlug = story.id.split('/').at(-1) ?? story.id
const allStories = await getCollection('stories')
const relationSource =
  allStories.find((candidate) => candidate.id === storySlug) ?? story
const sameLocaleStories = allStories.filter((candidate) =>
  locale === 'ja'
    ? !candidate.id.includes('/')
    : candidate.id.startsWith(`${locale}/`),
)
const localizedStoriesBySlug = new Map(
  sameLocaleStories.map((candidate) => [
    candidate.id.split('/').at(-1) ?? candidate.id,
    candidate,
  ]),
)
const relatedStories: RelatedContent[] =
  relationSource.data.relatedStories.flatMap((slug) => {
    const relatedStory = localizedStoriesBySlug.get(slug)
    if (!relatedStory) return []

    return [
      {
        kind: 'story',
        href: localizePath(locale, `/stories/${slug}/`),
        title: relatedStory.data.title,
        description: relatedStory.data.description,
        image: relatedStory.data.image,
        imageAlt: relatedStory.data.imageAlt,
      },
    ]
  })
const localizedPagesBySlug = new Map(
  getLocalizedPages(locale).map((page) => [page.slug, page]),
)
const relatedPages: RelatedContent[] = relationSource.data.relatedPages.flatMap(
  (slug) => {
    const relatedPage = localizedPagesBySlug.get(slug)
    if (!relatedPage) return []

    return [
      {
        kind: 'page',
        href: localizePath(
          locale,
          relatedPage.slug === 'top' ? '/' : `/${relatedPage.slug}/`,
        ),
        title: relatedPage.meta.title,
        description: relatedPage.meta.description,
      },
    ]
  },
)
const relatedContent = [...relatedStories, ...relatedPages]
const siteBase = Astro.site ?? new URL('https://asv.acecore.net')
const storyPath = localizePath(locale, `/stories/${storySlug}/`)
const homePath = localizePath(locale, '/')
const storiesPath = localizePath(locale, '/stories/')
const storyUrl = new URL(storyPath, siteBase)
const homeUrl = new URL(homePath, siteBase)
const organizationHomeUrl = new URL('/', siteBase)
const storiesUrl = new URL(storiesPath, siteBase)
const storyImageUrl = story.data.image
  ? new URL(story.data.image, storyUrl)
  : null
const articleJsonLd = serializeJsonForHtmlScript({
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${storyUrl}#article`,
  url: storyUrl.toString(),
  headline: story.data.title,
  description: story.data.description,
  datePublished: story.data.date.toISOString(),
  ...(story.data.lastUpdated
    ? { dateModified: story.data.lastUpdated.toISOString() }
    : {}),
  inLanguage: HTML_LANG_BY_LOCALE[locale],
  mainEntityOfPage: {
    '@id': `${storyUrl}#webpage`,
  },
  author: {
    '@type': 'Person',
    name: story.data.author,
  },
  publisher: {
    '@id': `${organizationHomeUrl}#organization`,
  },
  ...(storyImageUrl ? { image: storyImageUrl.toString() } : {}),
})
const breadcrumbJsonLd = serializeJsonForHtmlScript({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: ui.homeLabel,
      item: homeUrl.toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: ui.storiesTitle,
      item: storiesUrl.toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: story.data.title,
      item: storyUrl.toString(),
    },
  ],
})
---

<BaseLayout
  locale={locale}
  title={story.data.title}
  description={story.data.description}
  image={story.data.image}
  imageAlt={story.data.imageAlt}
  canonical={storyPath}
  ogType="article"
>
  <script type="application/ld+json" set:html={articleJsonLd} />
  <script type="application/ld+json" set:html={breadcrumbJsonLd} />
  <article class="story-shell">
    <nav class="story-breadcrumb" aria-label={ui.breadcrumbLabel}>
      <ol>
        <li><a href={homePath}>{ui.homeLabel}</a></li>
        <li><a href={storiesPath}>{ui.storiesTitle}</a></li>
        <li aria-current="page">{story.data.title}</li>
      </ol>
    </nav>
    <header class="story-header">
      <p class="story-kicker">ACESERVER STORY</p>
      <h1>{story.data.title}</h1>
      <p class="story-description">{story.data.description}</p>
      <div class="story-meta">
        <time datetime={story.data.date.toISOString()}>
          {
            story.data.date.toLocaleDateString(DATE_LOCALE_BY_LOCALE[locale], {
              timeZone: 'Asia/Tokyo',
            })
          }
        </time>
        {
          story.data.lastUpdated && (
            <span>
              {updatedLabelByLocale[locale]}{' '}
              <time datetime={story.data.lastUpdated.toISOString()}>
                {story.data.lastUpdated.toLocaleDateString(
                  DATE_LOCALE_BY_LOCALE[locale],
                  { timeZone: 'Asia/Tokyo' },
                )}
              </time>
            </span>
          )
        }
        <span>{ui.byAuthor.replace('{author}', story.data.author)}</span>
      </div>
    </header>
    {
      story.data.image && story.data.imageAlt && (
        <figure class="story-hero">
          <img
            src={story.data.image}
            alt={story.data.imageAlt}
            loading="eager"
            decoding="async"
          />
        </figure>
      )
    }
    <div class="story-body">
      <Content />
    </div>
    {
      relatedContent.length > 0 && (
        <section class="story-related" aria-labelledby="story-related-title">
          <h2 id="story-related-title">{ui.relatedContentTitle}</h2>
          <div class="story-related-grid">
            {relatedContent.map((item) => (
              <a
                class:list={{
                  'story-related-card': true,
                  'story-related-card--page': item.kind === 'page',
                  'story-related-card--story': item.kind === 'story',
                }}
                href={item.href}
              >
                {item.image && item.imageAlt && (
                  <img
                    class="story-related-image"
                    src={item.image}
                    alt={item.imageAlt}
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <span class="story-related-copy">
                  {item.kind === 'page' && (
                    <span class="story-related-label">
                      {ui.relatedPageLabel}
                    </span>
                  )}
                  <strong>{item.title}</strong>
                  <span>{item.description}</span>
                </span>
              </a>
            ))}
          </div>
        </section>
      )
    }
    <footer class="story-footer">
      <a href={storiesPath}>{ui.backToStories}</a>
      <a href={homePath}>{ui.joinAceserver}</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .story-shell {
    width: min(880px, calc(100% - 36px));
    margin-inline: auto;
    padding-block: clamp(56px, 8vw, 104px);
  }

  .story-breadcrumb {
    margin-bottom: clamp(24px, 4vw, 40px);
    color: #514331;
    font-size: 0.88rem;
    font-weight: 700;
  }

  .story-breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .story-breadcrumb li {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .story-breadcrumb li:not(:last-child)::after {
    content: '/';
    color: rgba(21, 19, 15, 0.48);
  }

  .story-breadcrumb a {
    color: #0756a8;
    text-underline-offset: 0.16em;
  }

  .story-header {
    border-bottom: 4px solid #1e1710;
    padding-bottom: clamp(30px, 5vw, 54px);
  }

  .story-kicker {
    margin: 0 0 16px;
    color: #0862c4;
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  .story-header h1 {
    margin: 0;
    font-size: clamp(2.3rem, 6vw, 4.9rem);
    letter-spacing: -0.03em;
    line-height: 1.18;
  }

  .story-description {
    max-width: 720px;
    margin: 24px 0 0;
    color: #514331;
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-weight: 700;
  }

  .story-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-top: 24px;
    font-size: 0.9rem;
    font-weight: 800;
  }

  .story-hero {
    overflow: hidden;
    margin: clamp(30px, 5vw, 54px) 0 0;
    border: 3px solid #1e1710;
    border-radius: 12px;
    background: #1e1710;
    box-shadow: 0 8px 0 rgba(21, 19, 15, 0.22);
  }

  .story-hero img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .story-body {
    padding-block: clamp(36px, 6vw, 68px);
    font-size: clamp(1rem, 1.5vw, 1.08rem);
    line-height: 2;
  }

  .story-body :global(h2) {
    margin: 2.5em 0 0.8em;
    border-left: 8px solid #35aa2f;
    padding-left: 18px;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.45;
  }

  .story-body :global(p) {
    margin: 1.25em 0;
  }

  .story-body :global(p > img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border: 3px solid #1e1710;
    border-radius: 12px;
    object-fit: cover;
    box-shadow: 0 7px 0 rgba(21, 19, 15, 0.18);
  }

  .story-body :global(a) {
    color: #0756a8;
    font-weight: 700;
    text-underline-offset: 0.18em;
  }

  .story-related {
    border-top: 4px solid #1e1710;
    padding-block: clamp(34px, 5vw, 54px);
  }

  .story-related h2 {
    margin: 0 0 22px;
    font-size: clamp(1.55rem, 3vw, 2.2rem);
    line-height: 1.35;
  }

  .story-related-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
  }

  .story-related-card {
    display: grid;
    min-height: 100%;
    overflow: hidden;
    border: 2px solid #1e1710;
    border-radius: 10px;
    background: #fff8e6;
    color: #15130f;
    text-decoration: none;
    box-shadow: 0 4px 0 rgba(21, 19, 15, 0.22);
    transition:
      background-color 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .story-related-card:hover,
  .story-related-card:focus-visible {
    background: #fff1b5;
    transform: translateY(-2px);
    box-shadow: 0 6px 0 rgba(21, 19, 15, 0.26);
  }

  .story-related-card:focus-visible {
    outline: 4px solid #0862c4;
    outline-offset: 3px;
  }

  .story-related-card--page {
    border-left: 8px solid #35aa2f;
    background: #e9f8ff;
  }

  .story-related-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .story-related-copy {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 18px;
  }

  .story-related-label {
    color: #0862c4;
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .story-related-copy strong {
    font-size: 1.08rem;
    line-height: 1.45;
  }

  .story-related-copy > span:last-child {
    color: #514331;
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.65;
  }

  .story-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    border-top: 4px solid #1e1710;
    padding-top: 28px;
  }

  .story-footer a {
    border: 2px solid #1e1710;
    border-radius: 8px;
    background: #ffd84d;
    padding: 10px 16px;
    font-weight: 900;
    text-decoration: none;
    box-shadow: 0 4px 0 rgba(21, 19, 15, 0.28);
  }
</style>
