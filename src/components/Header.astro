---
import { getLocalizedNavigation, getLocalizedSettings } from '../i18n/content'
import {
  getAlternatePaths,
  LOCALE_LABELS,
  localizePath,
  type Locale,
} from '../i18n/config'
import { getUi } from '../i18n/translations'
import { externalLinkAttrs } from '../utils/links'
import Icon from './Icon.astro'

interface Props {
  locale?: Locale
}

const { locale = 'ja' } = Astro.props
const navigation = getLocalizedNavigation(locale)
const settings = getLocalizedSettings(locale)
const ui = getUi(locale)
const currentPath = Astro.url.pathname
const alternatePaths = getAlternatePaths(currentPath)
const isCurrentNavigationItem = (href: string) =>
  href.startsWith('/') &&
  (currentPath === href || (href !== '/' && currentPath.startsWith(href)))
---

<header class="site-header" data-header>
  <a
    class="brand"
    href={localizePath(locale, '/')}
    aria-label={ui.homeAriaLabel}
  >
    <img
      src={settings.logo}
      alt={settings.logoAlt}
      aria-hidden="true"
      width="44"
      height="44"
    />
    <span>{settings.shortTitle}</span>
  </a>

  <nav class="desktop-nav" aria-label={ui.mainNavigation}>
    <a
      href={localizePath(locale, '/search/')}
      class:list={[
        {
          'is-active': isCurrentNavigationItem(
            localizePath(locale, '/search/'),
          ),
        },
      ]}
      aria-current={isCurrentNavigationItem(localizePath(locale, '/search/'))
        ? 'page'
        : undefined}
    >
      <Icon name="search" />
      <span>{ui.search.link}</span>
    </a>
    {
      navigation.map((item) => (
        <a
          href={item.href}
          class:list={[{ 'is-active': isCurrentNavigationItem(item.href) }]}
          aria-current={isCurrentNavigationItem(item.href) ? 'page' : undefined}
          {...externalLinkAttrs(item.href, item.external)}
        >
          <Icon name={item.icon} />
          <span>{item.text}</span>
        </a>
      ))
    }
  </nav>

  <label class="language-switcher language-switcher--desktop">
    <span class="sr-only">{ui.languageSelector}</span>
    <Icon name="globe-2" />
    <select aria-label={ui.languageSelector} data-locale-select>
      {
        alternatePaths.map((item) => (
          <option value={item.href} selected={item.locale === locale}>
            {LOCALE_LABELS[item.locale]}
          </option>
        ))
      }
    </select>
  </label>

  <button
    class="menu-button"
    type="button"
    aria-label={ui.menuOpen}
    aria-expanded="false"
    aria-controls="mobile-menu"
    data-label-open={ui.menuOpen}
    data-label-close={ui.menuClose}
    data-menu-button
  >
    <Icon name="menu" class="menu-open" />
    <Icon name="x" class="menu-close" />
  </button>

  <nav
    id="mobile-menu"
    class="mobile-nav"
    aria-label={ui.mobileNavigation}
    data-mobile-nav
  >
    <label class="language-switcher language-switcher--mobile">
      <Icon name="globe-2" />
      <span class="sr-only">{ui.languageSelector}</span>
      <select aria-label={ui.languageSelector} data-locale-select>
        {
          alternatePaths.map((item) => (
            <option value={item.href} selected={item.locale === locale}>
              {LOCALE_LABELS[item.locale]}
            </option>
          ))
        }
      </select>
    </label>
    <a
      href={localizePath(locale, '/search/')}
      class:list={[
        {
          'is-active': isCurrentNavigationItem(
            localizePath(locale, '/search/'),
          ),
        },
      ]}
      aria-current={isCurrentNavigationItem(localizePath(locale, '/search/'))
        ? 'page'
        : undefined}
    >
      <Icon name="search" />
      <span>{ui.search.link}</span>
    </a>
    {
      navigation.map((item) => (
        <a
          href={item.href}
          class:list={[{ 'is-active': isCurrentNavigationItem(item.href) }]}
          aria-current={isCurrentNavigationItem(item.href) ? 'page' : undefined}
          {...externalLinkAttrs(item.href, item.external)}
        >
          <Icon name={item.icon} />
          <span>{item.text}</span>
        </a>
      ))
    }
  </nav>
</header>

<script>
  function setMenuState(expanded: boolean, focusMenu = false) {
    const header = document.querySelector<HTMLElement>('[data-header]')
    const button =
      document.querySelector<HTMLButtonElement>('[data-menu-button]')
    const menu = document.querySelector<HTMLElement>('[data-mobile-nav]')

    if (!header || !button || !menu) return

    header.toggleAttribute('data-menu-open', expanded)
    button.setAttribute('aria-expanded', String(expanded))
    button.setAttribute(
      'aria-label',
      expanded
        ? button.dataset.labelClose || 'メニューを閉じる'
        : button.dataset.labelOpen || 'メニューを開く',
    )

    if (expanded && focusMenu) {
      menu.querySelector<HTMLElement>('a')?.focus()
    }
  }

  function initHeaderMenu() {
    const button =
      document.querySelector<HTMLButtonElement>('[data-menu-button]')
    const menu = document.querySelector<HTMLElement>('[data-mobile-nav]')
    if (!button || !menu || button.dataset.menuBound === 'true') return

    button.dataset.menuBound = 'true'
    setMenuState(false)

    button.addEventListener('click', () => {
      const expanded = button.getAttribute('aria-expanded') === 'true'
      setMenuState(!expanded, !expanded)
    })

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenuState(false))
    })
  }

  function initLocaleSelectors() {
    document
      .querySelectorAll<HTMLSelectElement>('[data-locale-select]')
      .forEach((select) => {
        if (select.dataset.localeBound === 'true') return
        select.dataset.localeBound = 'true'
        select.addEventListener('change', () => {
          window.location.assign(select.value)
        })
      })
  }

  initHeaderMenu()
  initLocaleSelectors()

  if (!(window as any).__asvHeaderKeyboardBound) {
    ;(window as any).__asvHeaderKeyboardBound = true
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return

      const button =
        document.querySelector<HTMLButtonElement>('[data-menu-button]')
      if (button?.getAttribute('aria-expanded') === 'true') {
        setMenuState(false)
        button.focus()
      }
    })
  }

  document.addEventListener('astro:after-swap', () => {
    initHeaderMenu()
    initLocaleSelectors()
  })
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    min-height: 72px;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    border-bottom: 3px solid rgba(255, 216, 77, 0.75);
    background:
      linear-gradient(180deg, rgba(48, 36, 24, 0.96), rgba(24, 19, 14, 0.96)),
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.05) 0 1px,
        transparent 1px 28px
      );
    box-shadow: 0 12px 30px rgba(16, 12, 8, 0.28);
    padding: 10px clamp(16px, 4vw, 48px);
  }

  .brand,
  .desktop-nav a,
  .mobile-nav a,
  .menu-button {
    color: #fffaf0;
    text-decoration: none;
  }

  .brand {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 12px;
    font-size: clamp(1.1rem, 2.1vw, 1.6rem);
    font-weight: 900;
    letter-spacing: 0;
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.35);
  }

  .brand img {
    width: 44px;
    height: 44px;
    filter: drop-shadow(0 4px 0 rgba(0, 0, 0, 0.28));
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .language-switcher {
    align-items: center;
    gap: 6px;
    border: 2px solid rgba(255, 216, 77, 0.55);
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.18);
    color: #fffaf0;
    padding: 0 8px;
  }

  .language-switcher--desktop {
    display: inline-flex;
    min-height: 42px;
  }

  .language-switcher--mobile {
    display: none;
  }

  .language-switcher select {
    max-width: 112px;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 900;
    outline: 0;
  }

  .language-switcher option {
    background: #1c150f;
    color: #fffaf0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    padding: 0;
    border: 0;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .desktop-nav a,
  .mobile-nav a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 2px solid transparent;
    border-radius: 8px;
    font-weight: 800;
    line-height: 1;
    transition:
      background-color 160ms ease,
      border-color 160ms ease;
  }

  .desktop-nav a {
    min-height: 46px;
    padding: 0 14px;
  }

  .desktop-nav a:hover,
  .desktop-nav a.is-active,
  .mobile-nav a:hover,
  .mobile-nav a.is-active {
    border-color: rgba(255, 216, 77, 0.65);
    background: rgba(255, 216, 77, 0.12);
    color: #ffd84d;
  }

  .menu-button {
    display: none;
    width: 48px;
    height: 48px;
    align-items: center;
    justify-content: center;
    border: 2px solid rgba(255, 216, 77, 0.55);
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.18);
    font-size: 1.5rem;
  }

  .menu-button :global(.menu-close),
  [data-menu-open] .menu-button :global(.menu-open) {
    display: none;
  }

  [data-menu-open] .menu-button :global(.menu-close) {
    display: inline-block;
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 1536px) {
    .desktop-nav,
    .language-switcher--desktop {
      display: none;
    }

    .menu-button {
      display: inline-flex;
    }

    [data-menu-open] .mobile-nav {
      position: absolute;
      top: calc(100% + 2px);
      right: 12px;
      left: 12px;
      display: grid;
      gap: 8px;
      border: 2px solid rgba(255, 216, 77, 0.72);
      border-radius: 12px;
      background: rgba(28, 21, 15, 0.98);
      padding: 10px;
      box-shadow: 0 18px 48px rgba(0, 0, 0, 0.35);
    }

    [data-menu-open] .language-switcher--mobile {
      display: flex;
      min-height: 48px;
    }

    .language-switcher select {
      width: 100%;
      max-width: none;
    }

    .mobile-nav a {
      min-height: 48px;
      padding: 0 12px;
    }
  }
</style>
