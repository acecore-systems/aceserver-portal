---
import type { LinkItem } from '../types'
import { externalLinkAttrs } from '../utils/links'
import Icon from './Icon.astro'

interface Props {
  logo: string
  joinButton: LinkItem
  wikiButton: LinkItem
}

const { logo, joinButton, wikiButton } = Astro.props

const worldMapButton: LinkItem = {
  label: 'ワールドマップを見る',
  href: '/world-map/',
}

const alphaPrompts = [
  {
    label: '参加したい',
    icon: 'message-circle',
    question: 'どうやって参加するの？',
    title: '参加方法',
    answer:
      'まずは公式ディスコードに来てね。お知らせとルールを確認したら、Java版・統合版どちらからでも遊びに行けるよ。迷ったらWIKIの案内もいっしょに見ると安心だよ。',
    keywords: [
      '参加',
      '入り',
      '入る',
      'はじめ',
      '始め',
      'discord',
      'ディスコード',
      'java',
      '統合版',
    ],
  },
  {
    label: 'ストーリー',
    icon: 'sparkles',
    question: 'アルファくんはどんな案内をしてくれるの？',
    title: 'アルファくんの紹介',
    answer:
      'ぼくはエースサーバーの入口で、はじめて来た人をワールドまで案内する係だよ。街を見たい人、資源を集めたい人、RPGで冒険したい人に、次の行き先をわかりやすく紹介するね。',
    keywords: ['ストーリー', '物語', 'アルファ', 'キャラ', '紹介', '案内'],
  },
  {
    label: 'ワールド案内',
    icon: 'map',
    question: 'どのワールドに行けばいい？',
    title: 'ワールド案内',
    answer:
      '建築や生活を楽しむならメイン、素材集めなら資源、冒険気分ならRPGがおすすめ。今見られるワールドはワールドマップから確認できるよ。',
    keywords: ['ワールド', 'マップ', '地図', 'メイン', '資源', 'rpg', 'ロビー'],
  },
  {
    label: 'ルール確認',
    icon: 'book-open',
    question: '遊ぶ前に何を見ればいい？',
    title: '遊ぶ前の確認',
    answer:
      '自由に遊べるサーバーだけど、みんなで気持ちよく過ごすためのルールは大事だよ。参加前にWIKIとディスコードのお知らせを確認してね。',
    keywords: ['ルール', 'wiki', 'ウィキ', '注意', '禁止', '確認'],
  },
]
---

<div
  id="alpha-guide"
  class="alpha-widget"
  data-alpha-widget
  data-alpha-fallback-title="アルファくんからの案内"
  data-alpha-fallback-answer="その内容はまだ練習中だよ。参加方法、ストーリー、ワールド、ルールのどれかを聞いてくれたら、今すぐ案内するね。"
>
  <section
    id="alpha-guide-panel"
    class="alpha-panel pixel-border"
    aria-labelledby="alpha-title"
    data-alpha-panel
    hidden
  >
    <header class="alpha-panel-header">
      <img src={logo} alt="" width="48" height="48" />
      <div>
        <h2 id="alpha-title">アルファくん案内所</h2>
        <p>キャラクターとして参加方法やワールドを案内します</p>
      </div>
      <button
        type="button"
        class="alpha-close"
        aria-label="アルファくん案内所を閉じる"
        data-alpha-close
      >
        <Icon name="x" />
      </button>
    </header>

    <div class="alpha-chat-log" aria-live="polite">
      <p class="alpha-message alpha-message--user" data-alpha-user>
        はじめて来たよ。何から見ればいい？
      </p>
      <div class="alpha-message alpha-message--alpha">
        <img src={logo} alt="" width="40" height="40" />
        <div>
          <strong data-alpha-title>参加方法</strong>
          <p data-alpha-answer>
            まずは公式ディスコードに来てね。お知らせとルールを確認したら、Java版・統合版どちらからでも遊びに行けるよ。迷ったらWIKIの案内もいっしょに見ると安心だよ。
          </p>
        </div>
      </div>
    </div>

    <div class="alpha-prompts" aria-label="アルファくんへの質問例">
      {
        alphaPrompts.map((prompt) => (
          <button
            type="button"
            data-alpha-prompt
            data-alpha-question={prompt.question}
            data-alpha-title={prompt.title}
            data-alpha-answer={prompt.answer}
            data-alpha-keywords={prompt.keywords.join('|')}
          >
            <Icon name={prompt.icon} />
            <span>{prompt.label}</span>
          </button>
        ))
      }
    </div>

    <form class="alpha-form" data-alpha-form>
      <label class="alpha-sr-only" for="alpha-question">
        アルファくんに質問
      </label>
      <input
        id="alpha-question"
        name="alpha-question"
        type="text"
        autocomplete="off"
        placeholder="例: 参加方法、ワールド、ストーリー"
      />
      <button type="submit" aria-label="アルファくんに聞く">
        <Icon name="send-horizontal" />
        <span>聞く</span>
      </button>
    </form>

    <div class="alpha-links" aria-label="案内リンク">
      <a
        href={joinButton.href}
        {...externalLinkAttrs(joinButton.href, joinButton.external)}
      >
        <Icon name="message-circle" />
        <span>{joinButton.label}</span>
      </a>
      <a
        href={worldMapButton.href}
        {...externalLinkAttrs(worldMapButton.href, worldMapButton.external)}
      >
        <Icon name="map" />
        <span>{worldMapButton.label}</span>
      </a>
      <a
        href={wikiButton.href}
        {...externalLinkAttrs(wikiButton.href, wikiButton.external)}
      >
        <Icon name="book-open" />
        <span>{wikiButton.label}</span>
      </a>
    </div>
  </section>

  <button
    type="button"
    class="alpha-toggle"
    aria-controls="alpha-guide-panel"
    aria-expanded="false"
    aria-label="アルファくんに聞く"
    data-alpha-toggle
  >
    <img src={logo} alt="" width="56" height="56" />
    <span>聞く</span>
  </button>
</div>

<script>
  function getAlphaPromptData(button: HTMLButtonElement) {
    return {
      question:
        button.dataset.alphaQuestion || button.textContent?.trim() || '',
      title: button.dataset.alphaTitle || 'アルファくんからの案内',
      answer: button.dataset.alphaAnswer || '',
      keywords: (button.dataset.alphaKeywords || '')
        .split('|')
        .map((keyword) => keyword.trim().toLowerCase())
        .filter(Boolean),
    }
  }

  function updateAlphaChat(
    widget: HTMLElement,
    prompt: ReturnType<typeof getAlphaPromptData>,
    userText?: string,
  ) {
    const user = widget.querySelector<HTMLElement>('[data-alpha-user]')
    const title = widget.querySelector<HTMLElement>('[data-alpha-title]')
    const answer = widget.querySelector<HTMLElement>('[data-alpha-answer]')

    if (user) {
      user.textContent = userText || prompt.question
    }

    if (title) {
      title.textContent = prompt.title
    }

    if (answer) {
      answer.textContent = prompt.answer
    }
  }

  function findAlphaPrompt(widget: HTMLElement, rawValue: string) {
    const value = rawValue.trim().toLowerCase()
    const prompts = Array.from(
      widget.querySelectorAll<HTMLButtonElement>('[data-alpha-prompt]'),
    ).map(getAlphaPromptData)

    return (
      prompts.find((prompt) =>
        prompt.keywords.some((keyword) => value.includes(keyword)),
      ) || {
        question: rawValue,
        title: widget.dataset.alphaFallbackTitle || 'アルファくんからの案内',
        answer:
          widget.dataset.alphaFallbackAnswer ||
          'その内容はまだ練習中だよ。質問例から聞いてみてね。',
        keywords: [],
      }
    )
  }

  function setAlphaWidgetOpen(widget: HTMLElement, open: boolean) {
    const panel = widget.querySelector<HTMLElement>('[data-alpha-panel]')
    const toggle = widget.querySelector<HTMLButtonElement>(
      '[data-alpha-toggle]',
    )
    const input = widget.querySelector<HTMLInputElement>('#alpha-question')

    if (!panel || !toggle) return

    panel.hidden = !open
    widget.classList.toggle('is-open', open)
    toggle.setAttribute('aria-expanded', String(open))

    if (open) {
      window.setTimeout(() => input?.focus(), 0)
    } else {
      toggle.focus()
    }
  }

  function initAlphaGuide() {
    const widget = document.querySelector<HTMLElement>('[data-alpha-widget]')
    if (!widget || widget.dataset.alphaBound === 'true') return

    widget.dataset.alphaBound = 'true'

    const toggle = widget.querySelector<HTMLButtonElement>(
      '[data-alpha-toggle]',
    )
    const form = widget.querySelector<HTMLFormElement>('[data-alpha-form]')
    const input = form?.querySelector<HTMLInputElement>('input')

    toggle?.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true'
      setAlphaWidgetOpen(widget, !isOpen)
    })

    widget.querySelectorAll('[data-alpha-close]').forEach((button) => {
      button.addEventListener('click', () => setAlphaWidgetOpen(widget, false))
    })

    widget
      .querySelectorAll<HTMLButtonElement>('[data-alpha-prompt]')
      .forEach((button) => {
        button.addEventListener('click', () => {
          updateAlphaChat(widget, getAlphaPromptData(button))
        })
      })

    form?.addEventListener('submit', (event) => {
      event.preventDefault()

      const question = input?.value.trim() || ''
      const prompt = findAlphaPrompt(widget, question)
      updateAlphaChat(widget, prompt, question || prompt.question)

      if (input) {
        input.value = ''
      }
    })

    document.addEventListener('click', (event) => {
      const target = event.target
      if (!(target instanceof Element)) return

      const opener = target.closest('[data-alpha-open]')
      if (!opener) return

      event.preventDefault()
      setAlphaWidgetOpen(widget, true)
    })

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !widget.classList.contains('is-open')) {
        return
      }

      setAlphaWidgetOpen(widget, false)
    })
  }

  initAlphaGuide()
  document.addEventListener('astro:after-swap', initAlphaGuide)
</script>

<style>
  .alpha-widget {
    position: fixed;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 70;
    display: grid;
    justify-items: end;
    pointer-events: none;
  }

  .alpha-panel,
  .alpha-toggle {
    pointer-events: auto;
  }

  .alpha-panel {
    display: grid;
    width: min(390px, calc(100vw - 32px));
    max-height: min(620px, calc(100vh - 112px));
    gap: 14px;
    overflow: hidden;
    border-radius: 18px;
    background:
      linear-gradient(180deg, rgba(31, 24, 18, 0.98), rgba(16, 18, 19, 0.98)),
      #15130f;
    color: #fff7df;
    padding: 16px;
    box-shadow:
      0 0 0 2px rgba(255, 216, 77, 0.42),
      0 22px 70px rgba(0, 0, 0, 0.38);
  }

  .alpha-panel[hidden] {
    display: none;
  }

  .alpha-panel-header {
    display: grid;
    align-items: center;
    gap: 10px;
    grid-template-columns: auto minmax(0, 1fr) auto;
  }

  .alpha-panel-header img {
    width: 48px;
    height: 48px;
    object-fit: contain;
    border-radius: 12px;
    background: rgba(255, 216, 77, 0.16);
    padding: 2px;
    filter: drop-shadow(0 4px 0 rgba(0, 0, 0, 0.2));
  }

  .alpha-panel-header h2,
  .alpha-panel-header p {
    margin: 0;
  }

  .alpha-panel-header h2 {
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1.25;
  }

  .alpha-panel-header p {
    color: rgba(255, 247, 223, 0.78);
    font-size: 0.78rem;
    font-weight: 800;
    line-height: 1.45;
  }

  .alpha-close,
  .alpha-toggle {
    border: 2px solid rgba(255, 216, 77, 0.66);
    color: #fff7df;
    cursor: pointer;
  }

  .alpha-close {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.08);
    font-size: 1.15rem;
  }

  .alpha-chat-log {
    display: grid;
    max-height: min(36vh, 230px);
    gap: 12px;
    overflow-y: auto;
    padding-right: 2px;
  }

  .alpha-message {
    max-width: 100%;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .alpha-message--user {
    justify-self: end;
    border: 2px solid rgba(7, 77, 143, 0.86);
    border-radius: 14px 14px 4px;
    background: #1877f2;
    color: white;
    font-size: 0.92rem;
    font-weight: 900;
    line-height: 1.55;
    padding: 10px 12px;
    box-shadow: 0 4px 0 rgba(0, 0, 0, 0.24);
  }

  .alpha-message--alpha {
    display: grid;
    align-items: start;
    gap: 10px;
    grid-template-columns: auto 1fr;
  }

  .alpha-message--alpha img {
    width: 40px;
    height: 40px;
    object-fit: contain;
    border-radius: 10px;
    background: rgba(255, 216, 77, 0.16);
    padding: 2px;
  }

  .alpha-message--alpha div {
    border: 2px solid rgba(255, 216, 77, 0.78);
    border-radius: 4px 14px 14px;
    background: rgba(255, 245, 220, 0.1);
    padding: 12px 13px;
  }

  .alpha-message--alpha strong {
    display: block;
    margin-bottom: 5px;
    color: #ffd84d;
    font-size: 0.95rem;
    line-height: 1.35;
  }

  .alpha-message--alpha p {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 800;
    line-height: 1.7;
  }

  .alpha-prompts {
    display: grid;
    gap: 8px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .alpha-prompts button,
  .alpha-form button,
  .alpha-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 42px;
    border: 2px solid rgba(255, 216, 77, 0.62);
    border-radius: 8px;
    font-size: 0.86rem;
    font-weight: 900;
    line-height: 1.2;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      transform 160ms ease;
  }

  .alpha-prompts button {
    background: rgba(255, 216, 77, 0.12);
    color: #fff7df;
    padding: 0 10px;
  }

  .alpha-prompts button:hover,
  .alpha-prompts button:focus-visible,
  .alpha-links a:hover,
  .alpha-links a:focus-visible,
  .alpha-close:hover,
  .alpha-close:focus-visible {
    border-color: #ffd84d;
    background: rgba(255, 216, 77, 0.2);
    transform: translateY(-1px);
  }

  .alpha-form {
    display: grid;
    gap: 8px;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .alpha-form input {
    min-height: 44px;
    min-width: 0;
    border: 2px solid rgba(255, 216, 77, 0.6);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.96);
    color: #15130f;
    font-size: 0.9rem;
    font-weight: 800;
    padding: 0 12px;
  }

  .alpha-form input:focus {
    border-color: #ffd84d;
    outline: 3px solid rgba(255, 216, 77, 0.34);
    outline-offset: 2px;
  }

  .alpha-form button {
    background: #35aa2f;
    color: white;
    padding: 0 14px;
  }

  .alpha-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .alpha-links a {
    min-height: 38px;
    color: #fff7df;
    padding: 0 10px;
  }

  .alpha-toggle {
    display: inline-grid;
    width: 76px;
    min-height: 76px;
    place-items: center;
    border-radius: 18px;
    background: #ffd84d;
    color: #15130f;
    font-size: 0.78rem;
    font-weight: 900;
    line-height: 1;
    box-shadow:
      0 8px 0 rgba(21, 19, 15, 0.24),
      0 18px 42px rgba(0, 0, 0, 0.28);
    transition:
      background-color 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .alpha-panel + .alpha-toggle {
    margin-top: 12px;
  }

  .alpha-toggle img {
    width: 54px;
    height: 44px;
    object-fit: contain;
    filter: drop-shadow(0 3px 0 rgba(0, 0, 0, 0.16));
  }

  .alpha-toggle:hover,
  .alpha-toggle:focus-visible,
  .alpha-widget.is-open .alpha-toggle {
    background: #fff06f;
    transform: translateY(-2px);
  }

  .alpha-toggle:active {
    transform: translateY(1px);
    box-shadow:
      0 4px 0 rgba(21, 19, 15, 0.24),
      0 12px 32px rgba(0, 0, 0, 0.24);
  }

  .alpha-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .alpha-widget {
      right: 12px;
      bottom: max(12px, env(safe-area-inset-bottom));
    }

    .alpha-panel {
      width: calc(100vw - 24px);
      max-height: calc(100vh - 104px);
      padding: 14px;
    }

    .alpha-chat-log {
      max-height: min(32vh, 220px);
    }

    .alpha-prompts,
    .alpha-form {
      grid-template-columns: 1fr;
    }

    .alpha-message--alpha {
      grid-template-columns: 1fr;
    }

    .alpha-message--alpha img {
      display: none;
    }

    .alpha-toggle {
      width: 68px;
      min-height: 68px;
      border-radius: 16px;
    }

    .alpha-toggle img {
      width: 48px;
      height: 38px;
    }
  }
</style>
