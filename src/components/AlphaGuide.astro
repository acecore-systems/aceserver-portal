---
import type { LinkItem } from '../types'
import { externalLinkAttrs } from '../utils/links'
import Icon from './Icon.astro'

interface Props {
  logo: string
  joinButton: LinkItem
  wikiButton: LinkItem
}

const { logo, joinButton, wikiButton } = Astro.props

const worldMapButton: LinkItem = {
  label: 'ワールドマップを見る',
  href: '/world-map/',
}

const alphaPrompts = [
  {
    label: '参加したい',
    icon: 'message-circle',
    question: 'どうやって参加するの？',
    title: '参加方法',
    answer:
      'まずは公式ディスコードに来てね。お知らせとルールを確認したら、Java版・統合版どちらからでも遊びに行けるよ。迷ったらWIKIの案内もいっしょに見ると安心だよ。',
    keywords: [
      '参加',
      '入り',
      '入る',
      'はじめ',
      '始め',
      'discord',
      'ディスコード',
      'java',
      '統合版',
    ],
  },
  {
    label: 'ストーリー',
    icon: 'sparkles',
    question: 'アルファくんはどんな案内をしてくれるの？',
    title: 'アルファくんの紹介',
    answer:
      'ぼくはエースサーバーの入口で、はじめて来た人をワールドまで案内する係だよ。街を見たい人、資源を集めたい人、RPGで冒険したい人に、次の行き先をわかりやすく紹介するね。',
    keywords: ['ストーリー', '物語', 'アルファ', 'キャラ', '紹介', '案内'],
  },
  {
    label: 'ワールド案内',
    icon: 'map',
    question: 'どのワールドに行けばいい？',
    title: 'ワールド案内',
    answer:
      '建築や生活を楽しむならメイン、素材集めなら資源、冒険気分ならRPGがおすすめ。今見られるワールドはワールドマップから確認できるよ。',
    keywords: ['ワールド', 'マップ', '地図', 'メイン', '資源', 'rpg', 'ロビー'],
  },
  {
    label: 'ルール確認',
    icon: 'book-open',
    question: '遊ぶ前に何を見ればいい？',
    title: '遊ぶ前の確認',
    answer:
      '自由に遊べるサーバーだけど、みんなで気持ちよく過ごすためのルールは大事だよ。参加前にWIKIとディスコードのお知らせを確認してね。',
    keywords: ['ルール', 'wiki', 'ウィキ', '注意', '禁止', '確認'],
  },
]
---

<section id="alpha-guide" class="alpha-guide" aria-labelledby="alpha-title">
  <div class="alpha-copy">
    <div class="alpha-avatar pixel-border">
      <img src={logo} alt="アルファくん" width="220" height="220" />
      <span>案内中</span>
    </div>
    <div class="alpha-heading">
      <p class="alpha-name">アルファくん</p>
      <h2 id="alpha-title">案内はアルファくんにおまかせ</h2>
      <p>
        エースサーバーのキャラクターとして、参加方法、ワールド、WIKI、はじめての遊び方をアルファくんの口調で案内します。
      </p>
    </div>
    <ul class="alpha-story" aria-label="アルファくんが紹介できること">
      <li>
        <Icon name="compass" />
        <span>はじめて来た人を、参加まで迷わせない</span>
      </li>
      <li>
        <Icon name="scroll-text" />
        <span>サーバーの世界観や遊び方をキャラの口調で紹介</span>
      </li>
      <li>
        <Icon name="map-pinned" />
        <span>ワールドマップやWIKIへすぐ案内</span>
      </li>
    </ul>
  </div>

  <div
    class="alpha-chat pixel-border"
    data-alpha-chat
    data-alpha-fallback-title="アルファくんからの案内"
    data-alpha-fallback-answer="その内容はまだ練習中だよ。参加方法、ストーリー、ワールド、ルールのどれかを聞いてくれたら、今すぐ案内するね。"
  >
    <div class="alpha-chat-header">
      <img src={logo} alt="" width="52" height="52" />
      <div>
        <p>アルファくん案内所</p>
        <span>キャラクターとして返答します</span>
      </div>
    </div>

    <div class="alpha-chat-log" aria-live="polite">
      <p class="alpha-message alpha-message--user" data-alpha-user>
        はじめて来たよ。何から見ればいい？
      </p>
      <div class="alpha-message alpha-message--alpha">
        <img src={logo} alt="" width="44" height="44" />
        <div>
          <strong data-alpha-title>参加方法</strong>
          <p data-alpha-answer>
            まずは公式ディスコードに来てね。お知らせとルールを確認したら、Java版・統合版どちらからでも遊びに行けるよ。迷ったらWIKIの案内もいっしょに見ると安心だよ。
          </p>
        </div>
      </div>
    </div>

    <div class="alpha-prompts" aria-label="アルファくんへの質問例">
      {
        alphaPrompts.map((prompt) => (
          <button
            type="button"
            data-alpha-prompt
            data-alpha-question={prompt.question}
            data-alpha-title={prompt.title}
            data-alpha-answer={prompt.answer}
            data-alpha-keywords={prompt.keywords.join('|')}
          >
            <Icon name={prompt.icon} />
            <span>{prompt.label}</span>
          </button>
        ))
      }
    </div>

    <form class="alpha-form" data-alpha-form>
      <label class="alpha-sr-only" for="alpha-question">
        アルファくんに質問
      </label>
      <input
        id="alpha-question"
        name="alpha-question"
        type="text"
        autocomplete="off"
        placeholder="例: 参加方法、ワールド、ストーリー"
      />
      <button type="submit">
        <Icon name="send-horizontal" />
        <span>聞く</span>
      </button>
    </form>

    <div class="alpha-links" aria-label="案内リンク">
      <a
        href={joinButton.href}
        {...externalLinkAttrs(joinButton.href, joinButton.external)}
      >
        <Icon name="message-circle" />
        <span>{joinButton.label}</span>
      </a>
      <a
        href={worldMapButton.href}
        {...externalLinkAttrs(worldMapButton.href, worldMapButton.external)}
      >
        <Icon name="map" />
        <span>{worldMapButton.label}</span>
      </a>
      <a
        href={wikiButton.href}
        {...externalLinkAttrs(wikiButton.href, wikiButton.external)}
      >
        <Icon name="book-open" />
        <span>{wikiButton.label}</span>
      </a>
    </div>
  </div>
</section>

<script>
  function getAlphaPromptData(button: HTMLButtonElement) {
    return {
      question:
        button.dataset.alphaQuestion || button.textContent?.trim() || '',
      title: button.dataset.alphaTitle || 'アルファくんからの案内',
      answer: button.dataset.alphaAnswer || '',
      keywords: (button.dataset.alphaKeywords || '')
        .split('|')
        .map((keyword) => keyword.trim().toLowerCase())
        .filter(Boolean),
    }
  }

  function updateAlphaChat(
    chat: HTMLElement,
    prompt: ReturnType<typeof getAlphaPromptData>,
    userText?: string,
  ) {
    const user = chat.querySelector<HTMLElement>('[data-alpha-user]')
    const title = chat.querySelector<HTMLElement>('[data-alpha-title]')
    const answer = chat.querySelector<HTMLElement>('[data-alpha-answer]')

    if (user) {
      user.textContent = userText || prompt.question
    }

    if (title) {
      title.textContent = prompt.title
    }

    if (answer) {
      answer.textContent = prompt.answer
    }
  }

  function findAlphaPrompt(chat: HTMLElement, rawValue: string) {
    const value = rawValue.trim().toLowerCase()
    const prompts = Array.from(
      chat.querySelectorAll<HTMLButtonElement>('[data-alpha-prompt]'),
    ).map(getAlphaPromptData)

    return (
      prompts.find((prompt) =>
        prompt.keywords.some((keyword) => value.includes(keyword)),
      ) || {
        question: rawValue,
        title: chat.dataset.alphaFallbackTitle || 'アルファくんからの案内',
        answer:
          chat.dataset.alphaFallbackAnswer ||
          'その内容はまだ練習中だよ。質問例から聞いてみてね。',
        keywords: [],
      }
    )
  }

  function initAlphaGuide() {
    document
      .querySelectorAll<HTMLElement>('[data-alpha-chat]')
      .forEach((chat) => {
        if (chat.dataset.alphaBound === 'true') return

        chat.dataset.alphaBound = 'true'

        chat
          .querySelectorAll<HTMLButtonElement>('[data-alpha-prompt]')
          .forEach((button) => {
            button.addEventListener('click', () => {
              updateAlphaChat(chat, getAlphaPromptData(button))
            })
          })

        const form = chat.querySelector<HTMLFormElement>('[data-alpha-form]')
        const input = form?.querySelector<HTMLInputElement>('input')

        form?.addEventListener('submit', (event) => {
          event.preventDefault()

          const question = input?.value.trim() || ''
          const prompt = findAlphaPrompt(chat, question)
          updateAlphaChat(chat, prompt, question || prompt.question)

          if (input) {
            input.value = ''
          }
        })
      })
  }

  initAlphaGuide()
  document.addEventListener('astro:after-swap', initAlphaGuide)
</script>

<style>
  .alpha-guide {
    position: relative;
    display: grid;
    align-items: center;
    gap: clamp(28px, 5vw, 76px);
    grid-template-columns: minmax(260px, 0.86fr) minmax(320px, 1.14fr);
    overflow: hidden;
    padding: clamp(58px, 8vw, 108px) clamp(18px, 6vw, 86px);
    background:
      linear-gradient(
        135deg,
        rgba(255, 248, 230, 0.98),
        rgba(220, 248, 255, 0.94) 52%,
        rgba(230, 255, 222, 0.98)
      ),
      repeating-linear-gradient(
        90deg,
        rgba(21, 19, 15, 0.04) 0 2px,
        transparent 2px 28px
      );
  }

  .alpha-guide::before {
    position: absolute;
    inset: 24px auto auto 42%;
    width: 280px;
    height: 280px;
    border-radius: 999px;
    background: radial-gradient(
      circle,
      rgba(255, 216, 77, 0.38),
      rgba(255, 216, 77, 0)
    );
    content: '';
    pointer-events: none;
  }

  .alpha-copy,
  .alpha-chat {
    position: relative;
    z-index: 1;
  }

  .alpha-copy {
    display: grid;
    gap: 22px;
  }

  .alpha-avatar {
    position: relative;
    display: grid;
    width: min(260px, 62vw);
    aspect-ratio: 1;
    place-items: center;
    border-radius: 24px;
    background:
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.88),
        rgba(255, 240, 184, 0.92)
      ),
      #fff5dc;
  }

  .alpha-avatar img {
    width: 82%;
    height: 82%;
    object-fit: contain;
    filter: drop-shadow(0 12px 0 rgba(21, 19, 15, 0.18));
  }

  .alpha-avatar span {
    position: absolute;
    right: 12px;
    bottom: 12px;
    border: 2px solid rgba(21, 19, 15, 0.78);
    border-radius: 8px;
    background: #35aa2f;
    color: white;
    font-size: 0.86rem;
    font-weight: 900;
    line-height: 1;
    padding: 8px 10px;
    box-shadow: 0 4px 0 rgba(21, 19, 15, 0.22);
  }

  .alpha-heading {
    max-width: 620px;
  }

  .alpha-name {
    width: fit-content;
    margin: 0 0 10px;
    border: 2px solid rgba(21, 19, 15, 0.7);
    border-radius: 8px;
    background: #ffd84d;
    color: #15130f;
    font-size: 0.95rem;
    font-weight: 900;
    line-height: 1;
    padding: 8px 12px;
    box-shadow: 0 4px 0 rgba(21, 19, 15, 0.18);
  }

  .alpha-heading h2 {
    margin: 0 0 16px;
    font-size: clamp(2.2rem, 4.6vw, 4.6rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1.05;
  }

  .alpha-heading p:last-child {
    margin: 0;
    font-size: clamp(1rem, 1.45vw, 1.2rem);
    font-weight: 800;
  }

  .alpha-story {
    display: grid;
    max-width: 620px;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .alpha-story li {
    display: flex;
    align-items: center;
    gap: 12px;
    border-left: 6px solid #35aa2f;
    background: rgba(255, 255, 255, 0.54);
    font-weight: 900;
    padding: 12px 14px;
  }

  .alpha-story :global(.asv-icon) {
    color: #0aa7e2;
    font-size: 1.35rem;
  }

  .alpha-chat {
    display: grid;
    min-width: 0;
    gap: 18px;
    border-radius: 22px;
    background:
      linear-gradient(180deg, rgba(31, 24, 18, 0.98), rgba(16, 18, 19, 0.98)),
      #15130f;
    color: #fff7df;
    padding: clamp(18px, 3vw, 28px);
  }

  .alpha-chat-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .alpha-chat-header img {
    width: 52px;
    height: 52px;
    object-fit: contain;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.12);
    padding: 3px;
  }

  .alpha-chat-header p,
  .alpha-chat-header span {
    margin: 0;
  }

  .alpha-chat-header p {
    font-size: 1.08rem;
    font-weight: 900;
  }

  .alpha-chat-header span {
    display: block;
    color: rgba(255, 247, 223, 0.78);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .alpha-chat-log {
    display: grid;
    gap: 14px;
  }

  .alpha-message {
    max-width: min(100%, 660px);
    margin: 0;
    overflow-wrap: anywhere;
  }

  .alpha-message--user {
    justify-self: end;
    border: 2px solid rgba(7, 77, 143, 0.86);
    border-radius: 16px 16px 4px;
    background: #1877f2;
    color: white;
    font-weight: 900;
    padding: 12px 14px;
    box-shadow: 0 4px 0 rgba(0, 0, 0, 0.24);
  }

  .alpha-message--alpha {
    display: grid;
    align-items: start;
    gap: 12px;
    grid-template-columns: auto 1fr;
  }

  .alpha-message--alpha img {
    width: 44px;
    height: 44px;
    object-fit: contain;
    border-radius: 10px;
    background: rgba(255, 216, 77, 0.16);
    padding: 2px;
  }

  .alpha-message--alpha div {
    border: 2px solid rgba(255, 216, 77, 0.78);
    border-radius: 4px 16px 16px;
    background: rgba(255, 245, 220, 0.1);
    padding: 14px 16px;
  }

  .alpha-message--alpha strong {
    display: block;
    margin-bottom: 6px;
    color: #ffd84d;
    font-size: 1rem;
    line-height: 1.3;
  }

  .alpha-message--alpha p {
    margin: 0;
    font-weight: 800;
  }

  .alpha-prompts {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .alpha-prompts button,
  .alpha-form button,
  .alpha-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 46px;
    border: 2px solid rgba(255, 216, 77, 0.62);
    border-radius: 8px;
    font-weight: 900;
    line-height: 1.2;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      transform 160ms ease;
  }

  .alpha-prompts button {
    background: rgba(255, 216, 77, 0.12);
    color: #fff7df;
    padding: 0 12px;
  }

  .alpha-prompts button:hover,
  .alpha-prompts button:focus-visible,
  .alpha-links a:hover,
  .alpha-links a:focus-visible {
    border-color: #ffd84d;
    background: rgba(255, 216, 77, 0.2);
    transform: translateY(-1px);
  }

  .alpha-form {
    display: grid;
    gap: 10px;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .alpha-form input {
    min-height: 50px;
    min-width: 0;
    border: 2px solid rgba(255, 216, 77, 0.6);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.96);
    color: #15130f;
    font-weight: 800;
    padding: 0 14px;
  }

  .alpha-form input:focus {
    border-color: #ffd84d;
    outline: 3px solid rgba(255, 216, 77, 0.34);
    outline-offset: 2px;
  }

  .alpha-form button {
    background: #35aa2f;
    color: white;
    padding: 0 18px;
  }

  .alpha-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .alpha-links a {
    min-height: 44px;
    color: #fff7df;
    padding: 0 12px;
  }

  .alpha-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (max-width: 980px) {
    .alpha-guide {
      grid-template-columns: 1fr;
    }

    .alpha-avatar {
      width: min(220px, 58vw);
    }
  }

  @media (max-width: 640px) {
    .alpha-prompts,
    .alpha-form {
      grid-template-columns: 1fr;
    }

    .alpha-message--alpha {
      grid-template-columns: 1fr;
    }

    .alpha-message--alpha img {
      display: none;
    }
  }
</style>
