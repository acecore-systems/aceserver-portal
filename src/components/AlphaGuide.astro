---
import type { LinkItem } from '../types'
import { localizePath, type Locale } from '../i18n/config'
import { getUi } from '../i18n/translations'
import { externalLinkAttrs } from '../utils/links'
import Icon from './Icon.astro'

interface Props {
  locale?: Locale
  logo: string
  joinButton: LinkItem
  wikiButton: LinkItem
}

const { locale = 'ja', logo, joinButton, wikiButton } = Astro.props
const ui = getUi(locale)

const worldMapButton: LinkItem = {
  label: ui.alpha.mapLabel,
  href: localizePath(locale, '/world-map/'),
}

const worldFoundationUrl = 'https://world-foundation.acecore.net/'
const schoolsUrl = 'https://schools.acecore.net/'
const systemsUrl = 'https://systems.acecore.net/'

const alphaPrompts = ui.alpha.prompts
const alphaError = ui.alpha.error
  .replace('{discord}', joinButton.href)
  .replace('{wiki}', wikiButton.href)
const alphaLinkResources = [
  {
    href: joinButton.href,
    label: joinButton.label,
    terms: [joinButton.label, 'Discord'],
  },
  {
    href: wikiButton.href,
    label: 'Aceserver WIKI',
    terms: ['Aceserver WIKI', wikiButton.label, 'WIKI', 'Wiki'],
  },
  {
    href: worldMapButton.href,
    label: worldMapButton.label,
    terms: [
      worldMapButton.label,
      ui.worldMapTitleParts.join(' '),
      ui.worldMapTitleParts.join(''),
    ],
  },
]
---

<div
  id="alpha-guide"
  class="alpha-widget"
  data-alpha-widget
  data-alpha-endpoint="/api/alpha-chat"
  data-alpha-locale={locale}
  data-alpha-discord-url={joinButton.href}
  data-alpha-wiki-url={wikiButton.href}
  data-alpha-world-map-url={worldMapButton.href}
  data-alpha-world-foundation-url={worldFoundationUrl}
  data-alpha-schools-url={schoolsUrl}
  data-alpha-systems-url={systemsUrl}
  data-alpha-link-resources={JSON.stringify(alphaLinkResources)}
  data-alpha-avatar-alt={ui.alphaImageAlt}
  data-alpha-greeting={ui.alpha.greeting}
  data-alpha-loading={ui.alpha.loading}
  data-alpha-error={alphaError}
>
  <section
    id="alpha-guide-panel"
    class="alpha-panel"
    aria-labelledby="alpha-title"
    data-alpha-panel
    hidden
  >
    <header class="alpha-header">
      <img
        src={logo}
        alt={ui.alphaImageAlt}
        aria-hidden="true"
        width="40"
        height="40"
      />
      <div>
        <h2 id="alpha-title">{ui.alphaName}</h2>
        <p>{ui.alpha.chatSubtitle}</p>
      </div>
      <button
        type="button"
        class="alpha-icon-button"
        aria-label={ui.alpha.close}
        data-alpha-close
      >
        <Icon name="x" />
      </button>
    </header>

    <div
      class="alpha-messages"
      aria-live="polite"
      aria-label={ui.alpha.conversation}
      data-alpha-messages
    >
    </div>

    <div class="alpha-prompt-row" aria-label={ui.alpha.promptExamples}>
      {
        alphaPrompts.map((prompt) => (
          <button
            type="button"
            data-alpha-prompt={prompt.question}
            title={prompt.question}
          >
            {prompt.label}
          </button>
        ))
      }
    </div>

    <form class="alpha-form" data-alpha-form>
      <label class="alpha-sr-only" for="alpha-question">
        {ui.alpha.questionLabel}
      </label>
      <textarea
        id="alpha-question"
        name="alpha-question"
        rows="2"
        maxlength="500"
        autocomplete="off"
        placeholder={ui.alpha.placeholder}
        data-alpha-input></textarea>
      <button type="submit" aria-label={ui.alpha.send} data-alpha-send>
        <Icon name="send-horizontal" />
      </button>
    </form>

    <nav class="alpha-links" aria-label={ui.alpha.majorLinks}>
      <a
        href={joinButton.href}
        {...externalLinkAttrs(joinButton.href, joinButton.external)}
      >
        <Icon name="message-circle" />
        <span>Discord</span>
      </a>
      <a
        href={worldMapButton.href}
        {...externalLinkAttrs(worldMapButton.href, worldMapButton.external)}
      >
        <Icon name="map" />
        <span>{worldMapButton.label}</span>
      </a>
      <a
        href={wikiButton.href}
        {...externalLinkAttrs(wikiButton.href, wikiButton.external)}
      >
        <Icon name="book-open" />
        <span>WIKI</span>
      </a>
    </nav>
  </section>

  <button
    type="button"
    class="alpha-toggle"
    aria-controls="alpha-guide-panel"
    aria-expanded="false"
    aria-label={ui.alpha.toggle}
    data-alpha-toggle
  >
    <img
      src={logo}
      alt={ui.alphaImageAlt}
      aria-hidden="true"
      width="56"
      height="56"
    />
    <span>{ui.alpha.toggleShort}</span>
  </button>
</div>

<script>
  import { createAlphaInlineMarkdownPattern } from '../utils/alpha-link-pattern'

  type AlphaRole = 'user' | 'assistant'

  type AlphaMessage = {
    content: string
    role: AlphaRole
  }

  type AlphaConversationContext = Record<string, unknown>

  type AlphaConversationState = {
    context: AlphaConversationContext | null
    loreRevisionId?: string
  }

  // A lore continuation can require planning, writing, and review calls.
  const ALPHA_RESPONSE_TIMEOUT_MS = 240_000
  const ALPHA_CONVERSATION_CONTEXT_MAX_BYTES = 64 * 1024

  type AlphaLinkResource = {
    href: string
    label: string
    terms: string[]
  }

  type AlphaLinkContext = {
    allowedExternalLinks: string[]
    resources: AlphaLinkResource[]
  }

  const ALPHA_INLINE_MARKDOWN_SOURCE =
    /\[([^\]\n]{1,80})\]\(\s*([^\s)]{1,240})\s*\)|(https?:\/\/[^\s<>"']{1,240})|\*\*([^*\n]{1,160})\*\*|__([^_\n]{1,160})__|`([^`\n]{1,160})`|\*([^*\n]{1,160})\*|_([^_\n]{1,160})_/
      .source

  function normalizeAlphaHref(rawHref: string, context: AlphaLinkContext) {
    if (!rawHref || rawHref.includes('\\')) return null
    try {
      const hrefUrl = new URL(rawHref, window.location.href)
      if (hrefUrl.origin === window.location.origin) {
        if (!rawHref.startsWith('/') || rawHref.startsWith('//')) return null
        return `${hrefUrl.pathname}${hrefUrl.search}${hrefUrl.hash}`
      }

      const allowed = context.allowedExternalLinks.some((allowedHref) => {
        const allowedUrl = new URL(allowedHref)
        if (hrefUrl.origin !== allowedUrl.origin) return false

        if (allowedUrl.origin === 'https://discord.gg') {
          return (
            hrefUrl.pathname === allowedUrl.pathname &&
            !hrefUrl.search &&
            !hrefUrl.hash
          )
        }

        return true
      })
      return allowed ? hrefUrl.href : null
    } catch {
      return null
    }
  }

  function getAlphaLinkContext(widget: HTMLElement): AlphaLinkContext {
    const discordHref =
      widget.dataset.alphaDiscordUrl || 'https://discord.gg/acsv'
    const wikiHref =
      widget.dataset.alphaWikiUrl || 'https://asv-wiki.acecore.net'
    const worldMapHref = widget.dataset.alphaWorldMapUrl || '/world-map/'
    const worldFoundationHref =
      widget.dataset.alphaWorldFoundationUrl ||
      'https://world-foundation.acecore.net/'
    const schoolsHref =
      widget.dataset.alphaSchoolsUrl || 'https://schools.acecore.net/'
    const systemsHref =
      widget.dataset.alphaSystemsUrl || 'https://systems.acecore.net/'

    let configuredResources: AlphaLinkResource[] = []
    try {
      const parsed = JSON.parse(widget.dataset.alphaLinkResources || '[]')
      if (Array.isArray(parsed)) {
        configuredResources = parsed
          .filter(
            (resource) =>
              resource &&
              typeof resource.href === 'string' &&
              typeof resource.label === 'string' &&
              Array.isArray(resource.terms),
          )
          .map((resource) => ({
            href: resource.href,
            label: resource.label,
            terms: resource.terms.filter(
              (term: unknown): term is string => typeof term === 'string',
            ),
          }))
      }
    } catch {
      configuredResources = []
    }

    const resources =
      configuredResources.length > 0
        ? configuredResources
        : [
            {
              href: discordHref,
              label: 'Official Discord',
              terms: ['Official Discord', 'Discord'],
            },
            {
              href: wikiHref,
              label: 'Aceserver WIKI',
              terms: ['Aceserver WIKI', 'WIKI', 'Wiki'],
            },
            {
              href: worldMapHref,
              label: 'World map',
              terms: ['World map'],
            },
          ]

    return {
      allowedExternalLinks: [
        discordHref,
        wikiHref,
        'https://acecore.net/',
        worldFoundationHref,
        schoolsHref,
        systemsHref,
      ],
      resources,
    }
  }

  function splitAlphaTrailingPunctuation(rawHref: string) {
    const trailingPunctuation = '。、,.!！?？'
    let href = rawHref
    let trailing = ''

    while (
      href.length > 0 &&
      trailingPunctuation.includes(href[href.length - 1])
    ) {
      trailing = href[href.length - 1] + trailing
      href = href.slice(0, -1)
    }

    return { href, trailing }
  }

  function getAlphaResourceByTerm(
    term: string,
    resources: AlphaLinkResource[],
  ) {
    return resources.find((resource) => resource.terms.includes(term))
  }

  function getAlphaResourceLabelForHref(
    href: string,
    fallback: string,
    resources: AlphaLinkResource[],
  ) {
    const normalizedHref = new URL(href, window.location.href).href
    const resource = resources.find(
      (item) =>
        new URL(item.href, window.location.href).href === normalizedHref,
    )
    return resource?.label || fallback
  }

  function createAlphaAnchor(
    label: string,
    href: string,
    linkedHrefs: Set<string>,
  ) {
    const anchor = document.createElement('a')
    anchor.href = href
    anchor.textContent = label
    if (new URL(href, window.location.href).origin !== window.location.origin) {
      anchor.target = '_blank'
      anchor.rel = 'noopener noreferrer'
    }
    linkedHrefs.add(href)
    return anchor
  }

  function renderAlphaMarkdownText(
    container: HTMLElement,
    content: string,
    widget: HTMLElement,
  ) {
    container.textContent = ''
    const linkContext = getAlphaLinkContext(widget)
    const lines = String(content || '')
      .replace(/\r\n?/g, '\n')
      .trim()
      .split('\n')
    const linkedHrefs = new Set<string>()

    let paragraphLines: string[] = []
    let list: HTMLElement | null = null
    let listType = ''

    function flushParagraph() {
      if (paragraphLines.length === 0) return
      const paragraph = document.createElement('p')
      appendInlineAlphaMarkdown(
        paragraph,
        paragraphLines.join('\n'),
        linkedHrefs,
        linkContext,
      )
      container.append(paragraph)
      paragraphLines = []
    }

    function flushList() {
      list = null
      listType = ''
    }

    function ensureList(type: 'ul' | 'ol') {
      if (list && listType === type) return list
      flushParagraph()
      list = document.createElement(type)
      listType = type
      container.append(list)
      return list
    }

    lines.forEach((line) => {
      const trimmed = line.trim()
      if (!trimmed) {
        flushParagraph()
        flushList()
        return
      }

      const unorderedMatch = trimmed.match(/^[-*+・]\s+(.+)$/)
      const orderedMatch = trimmed.match(/^\d+\.\s+(.+)$/)

      if (unorderedMatch) {
        const item = document.createElement('li')
        appendInlineAlphaMarkdown(
          item,
          unorderedMatch[1],
          linkedHrefs,
          linkContext,
        )
        ensureList('ul').append(item)
        return
      }

      if (orderedMatch) {
        const item = document.createElement('li')
        appendInlineAlphaMarkdown(
          item,
          orderedMatch[1],
          linkedHrefs,
          linkContext,
        )
        ensureList('ol').append(item)
        return
      }

      flushList()
      paragraphLines.push(trimmed.replace(/^#{1,3}\s+/, ''))
    })

    flushParagraph()
  }

  function appendInlineAlphaMarkdown(
    parent: HTMLElement,
    text: string,
    linkedHrefs: Set<string>,
    linkContext: AlphaLinkContext,
  ) {
    const pattern = createAlphaInlineMarkdownPattern(
      ALPHA_INLINE_MARKDOWN_SOURCE,
      linkContext.resources,
    )
    let index = 0
    let match: RegExpExecArray | null

    while ((match = pattern.exec(text))) {
      if (match.index > index) {
        parent.append(document.createTextNode(text.slice(index, match.index)))
      }

      const [
        matchedText,
        markdownLabel,
        markdownHref,
        rawHref,
        strongAsterisk,
        strongUnderscore,
        inlineCode,
        emphasisAsterisk,
        emphasisUnderscore,
        autoLinkTerm,
      ] = match

      if (markdownLabel) {
        const href = normalizeAlphaHref(markdownHref.trim(), linkContext)
        if (href && !linkedHrefs.has(href)) {
          parent.append(createAlphaAnchor(markdownLabel, href, linkedHrefs))
        } else {
          parent.append(document.createTextNode(markdownLabel))
        }
      } else if (rawHref) {
        const rawLinkParts = splitAlphaTrailingPunctuation(rawHref)
        const href = normalizeAlphaHref(rawLinkParts.href, linkContext)
        if (href) {
          const label = getAlphaResourceLabelForHref(
            href,
            rawLinkParts.href,
            linkContext.resources,
          )
          parent.append(
            linkedHrefs.has(href)
              ? document.createTextNode(label)
              : createAlphaAnchor(label, href, linkedHrefs),
          )
          if (rawLinkParts.trailing) {
            parent.append(document.createTextNode(rawLinkParts.trailing))
          }
        } else {
          parent.append(document.createTextNode(matchedText))
        }
      } else if (strongAsterisk || strongUnderscore) {
        const strong = document.createElement('strong')
        appendInlineAlphaMarkdown(
          strong,
          strongAsterisk || strongUnderscore,
          linkedHrefs,
          linkContext,
        )
        parent.append(strong)
      } else if (inlineCode) {
        const code = document.createElement('code')
        code.textContent = inlineCode
        parent.append(code)
      } else if (emphasisAsterisk || emphasisUnderscore) {
        const emphasis = document.createElement('em')
        appendInlineAlphaMarkdown(
          emphasis,
          emphasisAsterisk || emphasisUnderscore,
          linkedHrefs,
          linkContext,
        )
        parent.append(emphasis)
      } else if (autoLinkTerm) {
        const resource = getAlphaResourceByTerm(
          autoLinkTerm,
          linkContext.resources,
        )
        const href = resource
          ? normalizeAlphaHref(resource.href, linkContext)
          : null
        if (resource && href && !linkedHrefs.has(href)) {
          parent.append(createAlphaAnchor(autoLinkTerm, href, linkedHrefs))
        } else {
          parent.append(document.createTextNode(autoLinkTerm))
        }
      } else {
        parent.append(document.createTextNode(matchedText))
      }

      index = pattern.lastIndex
    }

    if (index < text.length) {
      parent.append(document.createTextNode(text.slice(index)))
    }
  }

  function createAlphaMessage(
    widget: HTMLElement,
    role: AlphaRole,
    content: string,
    transient = false,
  ) {
    const messagesContainer = widget.querySelector<HTMLElement>(
      '[data-alpha-messages]',
    )
    if (!messagesContainer) return null

    const message = document.createElement('div')
    message.className = `alpha-message alpha-message--${role}`
    if (transient) {
      message.dataset.alphaTransient = 'true'
    }

    if (role === 'assistant') {
      const avatar = document.createElement('img')
      const toggleImage = widget.querySelector<HTMLImageElement>(
        '[data-alpha-toggle] img',
      )
      avatar.src = toggleImage?.src || ''
      avatar.alt = widget.dataset.alphaAvatarAlt || 'Alpha'
      avatar.ariaHidden = 'true'
      avatar.width = 32
      avatar.height = 32
      message.append(avatar)
    }

    const bubble = document.createElement('div')
    bubble.className = 'alpha-message__bubble'
    if (role === 'assistant') {
      renderAlphaMarkdownText(bubble, content, widget)
    } else {
      bubble.textContent = content
    }
    message.append(bubble)
    messagesContainer.append(message)
    messagesContainer.scrollTop = messagesContainer.scrollHeight

    return message
  }

  function setAlphaSending(widget: HTMLElement, sending: boolean) {
    widget.classList.toggle('is-sending', sending)
    widget
      .querySelector<HTMLElement>('[data-alpha-messages]')
      ?.setAttribute('aria-busy', String(sending))
    widget
      .querySelectorAll<HTMLButtonElement>(
        '[data-alpha-send], [data-alpha-prompt]',
      )
      .forEach((button) => {
        button.disabled = sending
      })
  }

  function ensureAlphaGreeting(widget: HTMLElement, messages: AlphaMessage[]) {
    if (messages.length > 0) return

    const greeting =
      widget.dataset.alphaGreeting ||
      'やあ、アルファくんだよ。エースサーバーの案内をするね。'
    messages.push({ role: 'assistant', content: greeting })
    createAlphaMessage(widget, 'assistant', greeting)
  }

  function showAlphaStatusNotice(
    widget: HTMLElement,
    message: string,
    transient = false,
  ) {
    const messagesContainer = widget.querySelector<HTMLElement>(
      '[data-alpha-messages]',
    )
    if (!messagesContainer || !message) return

    const notice = document.createElement('p')
    notice.className = 'alpha-context-notice'
    notice.setAttribute('role', 'status')
    notice.textContent = message
    messagesContainer.append(notice)
    messagesContainer.scrollTop = messagesContainer.scrollHeight
    if (transient) window.setTimeout(() => notice.remove(), 8_000)
  }

  function readAlphaConversationContext(
    value: unknown,
  ): AlphaConversationContext | null {
    if (!value || typeof value !== 'object' || Array.isArray(value)) return null

    try {
      return new TextEncoder().encode(JSON.stringify(value)).byteLength <=
        ALPHA_CONVERSATION_CONTEXT_MAX_BYTES
        ? (value as AlphaConversationContext)
        : null
    } catch {
      return null
    }
  }

  function isAlphaResponsePayload(
    value: unknown,
  ): value is Record<string, unknown> {
    return Boolean(value && typeof value === 'object' && !Array.isArray(value))
  }

  function isResettableConversationResponse(
    response: Response,
    payload: unknown,
  ) {
    return (
      response.status === 400 ||
      response.status === 413 ||
      response.status === 422 ||
      (isAlphaResponsePayload(payload) &&
        payload.conversationContextReset === true)
    )
  }

  async function requestAlphaResponse(
    widget: HTMLElement,
    conversation: AlphaConversationState,
    question: string,
    signal: AbortSignal,
    allowContextResetRetry = true,
  ) {
    const response = await fetch(
      widget.dataset.alphaEndpoint || '/api/alpha-chat',
      {
        method: 'POST',
        headers: {
          Accept: 'application/json',
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          question,
          locale: widget.dataset.alphaLocale || 'ja',
          ...(conversation.context
            ? { conversationContext: conversation.context }
            : {}),
          ...(conversation.loreRevisionId
            ? { loreRevisionId: conversation.loreRevisionId }
            : {}),
        }),
        signal,
      },
    )
    const payload: unknown = await response.json().catch(() => null)
    const answer =
      isAlphaResponsePayload(payload) && typeof payload.answer === 'string'
        ? payload.answer.trim()
        : ''

    if (
      response.ok &&
      isAlphaResponsePayload(payload) &&
      payload.ok === true &&
      answer
    ) {
      return { answer, payload }
    }

    if (
      allowContextResetRetry &&
      conversation.context &&
      isResettableConversationResponse(response, payload)
    ) {
      conversation.context = null
      showAlphaStatusNotice(
        widget,
        '会話の継続情報を更新しました。表示中のメッセージはそのままです。',
      )
      return requestAlphaResponse(widget, conversation, question, signal, false)
    }

    throw new Error('AlphaChatRequestFailed')
  }

  async function sendAlphaQuestion(
    widget: HTMLElement,
    messages: AlphaMessage[],
    conversation: AlphaConversationState,
    rawQuestion: string,
  ) {
    const question = rawQuestion.trim()
    if (!question || widget.classList.contains('is-sending')) return

    const input =
      widget.querySelector<HTMLTextAreaElement>('[data-alpha-input]')
    if (input) {
      input.value = ''
    }

    messages.push({ role: 'user', content: question })
    createAlphaMessage(widget, 'user', question)
    setAlphaSending(widget, true)

    const loadingMessage = createAlphaMessage(
      widget,
      'assistant',
      widget.dataset.alphaLoading || 'アルファくんが考え中...',
      true,
    )

    const requestController = new AbortController()
    const requestTimeout = window.setTimeout(
      () => requestController.abort(),
      ALPHA_RESPONSE_TIMEOUT_MS,
    )

    try {
      const { answer, payload } = await requestAlphaResponse(
        widget,
        conversation,
        question,
        requestController.signal,
      )

      loadingMessage?.remove()
      const loreRevisionId =
        typeof payload.loreRevisionId === 'string' &&
        payload.loreRevisionId.length <= 128
          ? payload.loreRevisionId
          : undefined
      conversation.loreRevisionId = loreRevisionId

      const nextContext = readAlphaConversationContext(
        payload.nextConversationContext,
      )
      const contextReset =
        payload.conversationContextReset === true ||
        (conversation.context !== null && nextContext === null)
      conversation.context = nextContext
      if (contextReset) {
        showAlphaStatusNotice(
          widget,
          '会話の継続情報を更新しました。表示中のメッセージはそのままです。',
        )
      }

      messages.push({ role: 'assistant', content: answer })
      createAlphaMessage(widget, 'assistant', answer)
    } catch {
      const errorNotice =
        widget.dataset.alphaError ||
        'いまはAI応答につながらなかったよ。あとでもう一度聞いてね。'
      loadingMessage?.remove()
      showAlphaStatusNotice(widget, errorNotice, true)
    } finally {
      window.clearTimeout(requestTimeout)
      setAlphaSending(widget, false)
      window.setTimeout(() => input?.focus(), 0)
    }
  }

  function setAlphaWidgetOpen(
    widget: HTMLElement,
    open: boolean,
    messages: AlphaMessage[],
  ) {
    const panel = widget.querySelector<HTMLElement>('[data-alpha-panel]')
    const toggle = widget.querySelector<HTMLButtonElement>(
      '[data-alpha-toggle]',
    )
    const input =
      widget.querySelector<HTMLTextAreaElement>('[data-alpha-input]')

    if (!panel || !toggle) return

    panel.hidden = !open
    widget.classList.toggle('is-open', open)
    toggle.setAttribute('aria-expanded', String(open))

    if (open) {
      ensureAlphaGreeting(widget, messages)
      window.setTimeout(() => input?.focus(), 0)
    } else {
      toggle.focus()
    }
  }

  let alphaGuideController: AbortController | null = null

  function initAlphaGuide() {
    const widget = document.querySelector<HTMLElement>('[data-alpha-widget]')
    if (!widget || widget.dataset.alphaBound === 'true') return

    alphaGuideController?.abort()
    alphaGuideController = new AbortController()
    const listenerOptions = { signal: alphaGuideController.signal }
    widget.dataset.alphaBound = 'true'

    const messages: AlphaMessage[] = []
    const conversation: AlphaConversationState = { context: null }
    const toggle = widget.querySelector<HTMLButtonElement>(
      '[data-alpha-toggle]',
    )
    const form = widget.querySelector<HTMLFormElement>('[data-alpha-form]')
    const input =
      widget.querySelector<HTMLTextAreaElement>('[data-alpha-input]')

    toggle?.addEventListener(
      'click',
      () => {
        const isOpen = toggle.getAttribute('aria-expanded') === 'true'
        setAlphaWidgetOpen(widget, !isOpen, messages)
      },
      listenerOptions,
    )

    widget.querySelectorAll('[data-alpha-close]').forEach((button) => {
      button.addEventListener(
        'click',
        () => setAlphaWidgetOpen(widget, false, messages),
        listenerOptions,
      )
    })

    widget
      .querySelectorAll<HTMLButtonElement>('[data-alpha-prompt]')
      .forEach((button) => {
        button.addEventListener(
          'click',
          () => {
            setAlphaWidgetOpen(widget, true, messages)
            void sendAlphaQuestion(
              widget,
              messages,
              conversation,
              button.dataset.alphaPrompt || button.textContent || '',
            )
          },
          listenerOptions,
        )
      })

    form?.addEventListener(
      'submit',
      (event) => {
        event.preventDefault()
        void sendAlphaQuestion(
          widget,
          messages,
          conversation,
          input?.value || '',
        )
      },
      listenerOptions,
    )

    input?.addEventListener(
      'keydown',
      (event) => {
        if (event.key !== 'Enter' || event.shiftKey) return

        event.preventDefault()
        void sendAlphaQuestion(widget, messages, conversation, input.value)
      },
      listenerOptions,
    )

    document.addEventListener(
      'click',
      (event) => {
        const target = event.target
        if (!(target instanceof Element)) return

        const opener = target.closest('[data-alpha-open]')
        if (!opener) return

        event.preventDefault()
        setAlphaWidgetOpen(widget, true, messages)
      },
      listenerOptions,
    )

    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key !== 'Escape' || !widget.classList.contains('is-open')) {
          return
        }

        setAlphaWidgetOpen(widget, false, messages)
      },
      listenerOptions,
    )
  }

  initAlphaGuide()
  document.addEventListener('astro:before-swap', () => {
    alphaGuideController?.abort()
    alphaGuideController = null
  })
  document.addEventListener('astro:after-swap', initAlphaGuide)
</script>

