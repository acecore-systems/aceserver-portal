---
import type { LinkItem } from '../types'
import { externalLinkAttrs } from '../utils/links'
import Icon from './Icon.astro'

interface Props {
  logo: string
  joinButton: LinkItem
  wikiButton: LinkItem
}

const { logo, joinButton, wikiButton } = Astro.props

const worldMapButton: LinkItem = {
  label: 'マップ',
  href: '/world-map/',
}

const alphaPrompts = [
  {
    label: '参加方法',
    question: 'エースサーバーへの参加方法を教えて',
  },
  {
    label: 'ワールド',
    question: 'どのワールドから見ればいい？',
  },
  {
    label: 'ルール',
    question: '遊ぶ前に確認するルールを教えて',
  },
]
---

<div
  id="alpha-guide"
  class="alpha-widget"
  data-alpha-widget
  data-alpha-endpoint="/api/alpha-chat"
  data-alpha-greeting="やあ、アルファくんだよ。エースサーバーの案内をするね。"
  data-alpha-loading="アルファくんが考え中..."
  data-alpha-error="いまはAI応答につながらなかったよ。参加方法はディスコード、詳しい案内はWIKIを見てね。"
>
  <section
    id="alpha-guide-panel"
    class="alpha-panel"
    aria-labelledby="alpha-title"
    data-alpha-panel
    hidden
  >
    <header class="alpha-header">
      <img src={logo} alt="" width="40" height="40" />
      <div>
        <h2 id="alpha-title">アルファくん</h2>
        <p>エースサーバー案内チャット</p>
      </div>
      <button
        type="button"
        class="alpha-icon-button"
        aria-label="アルファくんチャットを閉じる"
        data-alpha-close
      >
        <Icon name="x" />
      </button>
    </header>

    <div
      class="alpha-messages"
      aria-live="polite"
      aria-label="アルファくんとの会話"
      data-alpha-messages
    >
    </div>

    <div class="alpha-prompt-row" aria-label="質問例">
      {
        alphaPrompts.map((prompt) => (
          <button
            type="button"
            data-alpha-prompt={prompt.question}
            title={prompt.question}
          >
            {prompt.label}
          </button>
        ))
      }
    </div>

    <form class="alpha-form" data-alpha-form>
      <label class="alpha-sr-only" for="alpha-question">
        アルファくんに質問
      </label>
      <textarea
        id="alpha-question"
        name="alpha-question"
        rows="2"
        maxlength="500"
        autocomplete="off"
        placeholder="例: 参加方法を教えて"
        data-alpha-input></textarea>
      <button type="submit" aria-label="送信" data-alpha-send>
        <Icon name="send-horizontal" />
      </button>
    </form>

    <nav class="alpha-links" aria-label="主要リンク">
      <a
        href={joinButton.href}
        {...externalLinkAttrs(joinButton.href, joinButton.external)}
      >
        <Icon name="message-circle" />
        <span>Discord</span>
      </a>
      <a
        href={worldMapButton.href}
        {...externalLinkAttrs(worldMapButton.href, worldMapButton.external)}
      >
        <Icon name="map" />
        <span>{worldMapButton.label}</span>
      </a>
      <a
        href={wikiButton.href}
        {...externalLinkAttrs(wikiButton.href, wikiButton.external)}
      >
        <Icon name="book-open" />
        <span>WIKI</span>
      </a>
    </nav>
  </section>

  <button
    type="button"
    class="alpha-toggle"
    aria-controls="alpha-guide-panel"
    aria-expanded="false"
    aria-label="アルファくんに聞く"
    data-alpha-toggle
  >
    <img src={logo} alt="" width="56" height="56" />
    <span>聞く</span>
  </button>
</div>

<script>
  type AlphaRole = 'user' | 'assistant'

  type AlphaMessage = {
    role: AlphaRole
    content: string
  }

  const ALPHA_ALLOWED_EXTERNAL_LINKS = [
    'https://discord.gg/vKTdU4k8ur',
    'https://asv-wiki.acecore.net',
    'https://acecore.net',
  ]

  function isAllowedAlphaHref(rawHref: string) {
    if (rawHref.startsWith('/') && !rawHref.startsWith('//')) return true

    try {
      const hrefUrl = new URL(rawHref)
      return ALPHA_ALLOWED_EXTERNAL_LINKS.some((allowedHref) => {
        const allowedUrl = new URL(allowedHref)
        if (hrefUrl.origin !== allowedUrl.origin) return false

        if (allowedUrl.origin === 'https://discord.gg') {
          return hrefUrl.pathname === allowedUrl.pathname
        }

        return true
      })
    } catch {
      return false
    }
  }

  function splitAlphaTrailingPunctuation(rawHref: string) {
    const trailingPunctuation = '。、,.!！?？'
    let href = rawHref
    let trailing = ''

    while (
      href.length > 0 &&
      trailingPunctuation.includes(href[href.length - 1])
    ) {
      trailing = href[href.length - 1] + trailing
      href = href.slice(0, -1)
    }

    return { href, trailing }
  }

  function appendAlphaMessageContent(
    bubble: HTMLElement,
    content: string,
    renderLinks: boolean,
  ) {
    if (!renderLinks) {
      bubble.textContent = content
      return
    }

    const linkPattern =
      /\[([^\]\n]{1,80})\]\(([^)\s]{1,240})\)|(https?:\/\/[^\s<>"']{1,240})/g
    let lastIndex = 0
    let match: RegExpExecArray | null

    while ((match = linkPattern.exec(content))) {
      const [matchedText, markdownLabel, markdownHref, rawHref] = match
      const matchIndex = match.index

      if (matchIndex > lastIndex) {
        bubble.append(
          document.createTextNode(content.slice(lastIndex, matchIndex)),
        )
      }

      const rawLinkParts = rawHref
        ? splitAlphaTrailingPunctuation(rawHref)
        : null
      const label = markdownLabel || rawLinkParts?.href || ''
      const href = markdownHref || rawLinkParts?.href || ''

      if (isAllowedAlphaHref(href)) {
        const anchor = document.createElement('a')
        anchor.href = href
        anchor.textContent = label
        if (!href.startsWith('/')) {
          anchor.target = '_blank'
          anchor.rel = 'noopener noreferrer'
        }
        bubble.append(anchor)
        if (rawLinkParts?.trailing) {
          bubble.append(document.createTextNode(rawLinkParts.trailing))
        }
      } else {
        bubble.append(document.createTextNode(matchedText))
      }

      lastIndex = matchIndex + matchedText.length
    }

    if (lastIndex < content.length) {
      bubble.append(document.createTextNode(content.slice(lastIndex)))
    }
  }

  function createAlphaMessage(
    widget: HTMLElement,
    role: AlphaRole,
    content: string,
    transient = false,
  ) {
    const messagesContainer = widget.querySelector<HTMLElement>(
      '[data-alpha-messages]',
    )
    if (!messagesContainer) return null

    const message = document.createElement('div')
    message.className = `alpha-message alpha-message--${role}`
    if (transient) {
      message.dataset.alphaTransient = 'true'
    }

    if (role === 'assistant') {
      const avatar = document.createElement('img')
      const toggleImage = widget.querySelector<HTMLImageElement>(
        '[data-alpha-toggle] img',
      )
      avatar.src = toggleImage?.src || ''
      avatar.alt = ''
      avatar.width = 32
      avatar.height = 32
      message.append(avatar)
    }

    const bubble = document.createElement('p')
    appendAlphaMessageContent(bubble, content, role === 'assistant')
    message.append(bubble)
    messagesContainer.append(message)
    messagesContainer.scrollTop = messagesContainer.scrollHeight

    return message
  }

  function setAlphaSending(widget: HTMLElement, sending: boolean) {
    widget.classList.toggle('is-sending', sending)
    widget
      .querySelectorAll<HTMLButtonElement>(
        '[data-alpha-send], [data-alpha-prompt]',
      )
      .forEach((button) => {
        button.disabled = sending
      })
  }

  function ensureAlphaGreeting(widget: HTMLElement, messages: AlphaMessage[]) {
    if (messages.length > 0) return

    const greeting =
      widget.dataset.alphaGreeting ||
      'やあ、アルファくんだよ。エースサーバーの案内をするね。'
    messages.push({ role: 'assistant', content: greeting })
    createAlphaMessage(widget, 'assistant', greeting)
  }

  async function sendAlphaQuestion(
    widget: HTMLElement,
    messages: AlphaMessage[],
    rawQuestion: string,
  ) {
    const question = rawQuestion.trim()
    if (!question || widget.classList.contains('is-sending')) return

    const input =
      widget.querySelector<HTMLTextAreaElement>('[data-alpha-input]')
    if (input) {
      input.value = ''
    }

    messages.push({ role: 'user', content: question })
    createAlphaMessage(widget, 'user', question)
    setAlphaSending(widget, true)

    const loadingMessage = createAlphaMessage(
      widget,
      'assistant',
      widget.dataset.alphaLoading || 'アルファくんが考え中...',
      true,
    )

    try {
      const response = await fetch(
        widget.dataset.alphaEndpoint || '/api/alpha-chat',
        {
          method: 'POST',
          headers: {
            Accept: 'application/json',
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            question,
            messages: messages.slice(-8),
          }),
        },
      )

      const payload = await response
        .json()
        .catch(() => ({ ok: false, answer: '' }))
      const fallback =
        widget.dataset.alphaError ||
        'いまはAI応答につながらなかったよ。あとでもう一度聞いてね。'
      const answer =
        typeof payload?.answer === 'string' && payload.answer.trim()
          ? payload.answer.trim()
          : fallback

      loadingMessage?.remove()
      messages.push({ role: 'assistant', content: answer })
      createAlphaMessage(widget, 'assistant', answer)
    } catch {
      const fallback =
        widget.dataset.alphaError ||
        'いまはAI応答につながらなかったよ。あとでもう一度聞いてね。'
      loadingMessage?.remove()
      messages.push({ role: 'assistant', content: fallback })
      createAlphaMessage(widget, 'assistant', fallback)
    } finally {
      setAlphaSending(widget, false)
      window.setTimeout(() => input?.focus(), 0)
    }
  }

  function setAlphaWidgetOpen(
    widget: HTMLElement,
    open: boolean,
    messages: AlphaMessage[],
  ) {
    const panel = widget.querySelector<HTMLElement>('[data-alpha-panel]')
    const toggle = widget.querySelector<HTMLButtonElement>(
      '[data-alpha-toggle]',
    )
    const input =
      widget.querySelector<HTMLTextAreaElement>('[data-alpha-input]')

    if (!panel || !toggle) return

    panel.hidden = !open
    widget.classList.toggle('is-open', open)
    toggle.setAttribute('aria-expanded', String(open))

    if (open) {
      ensureAlphaGreeting(widget, messages)
      window.setTimeout(() => input?.focus(), 0)
    } else {
      toggle.focus()
    }
  }

  function initAlphaGuide() {
    const widget = document.querySelector<HTMLElement>('[data-alpha-widget]')
    if (!widget || widget.dataset.alphaBound === 'true') return

    widget.dataset.alphaBound = 'true'

    const messages: AlphaMessage[] = []
    const toggle = widget.querySelector<HTMLButtonElement>(
      '[data-alpha-toggle]',
    )
    const form = widget.querySelector<HTMLFormElement>('[data-alpha-form]')
    const input =
      widget.querySelector<HTMLTextAreaElement>('[data-alpha-input]')

    toggle?.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true'
      setAlphaWidgetOpen(widget, !isOpen, messages)
    })

    widget.querySelectorAll('[data-alpha-close]').forEach((button) => {
      button.addEventListener('click', () =>
        setAlphaWidgetOpen(widget, false, messages),
      )
    })

    widget
      .querySelectorAll<HTMLButtonElement>('[data-alpha-prompt]')
      .forEach((button) => {
        button.addEventListener('click', () => {
          setAlphaWidgetOpen(widget, true, messages)
          void sendAlphaQuestion(
            widget,
            messages,
            button.dataset.alphaPrompt || button.textContent || '',
          )
        })
      })

    form?.addEventListener('submit', (event) => {
      event.preventDefault()
      void sendAlphaQuestion(widget, messages, input?.value || '')
    })

    input?.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' || event.shiftKey) return

      event.preventDefault()
      void sendAlphaQuestion(widget, messages, input.value)
    })

    document.addEventListener('click', (event) => {
      const target = event.target
      if (!(target instanceof Element)) return

      const opener = target.closest('[data-alpha-open]')
      if (!opener) return

      event.preventDefault()
      setAlphaWidgetOpen(widget, true, messages)
    })

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !widget.classList.contains('is-open')) {
        return
      }

      setAlphaWidgetOpen(widget, false, messages)
    })
  }

  initAlphaGuide()
  document.addEventListener('astro:after-swap', initAlphaGuide)
</script>

<style>
  .alpha-widget {
    position: fixed;
    right: max(18px, env(safe-area-inset-right));
    bottom: max(18px, env(safe-area-inset-bottom));
    z-index: 70;
    display: grid;
    justify-items: end;
    pointer-events: none;
  }

  .alpha-panel,
  .alpha-toggle {
    pointer-events: auto;
  }

  .alpha-panel {
    display: grid;
    width: min(360px, calc(100vw - 32px));
    max-height: min(540px, calc(100vh - 108px));
    overflow: hidden;
    border: 1px solid rgba(255, 216, 77, 0.46);
    border-radius: 16px;
    background: rgba(21, 19, 15, 0.96);
    color: #fff8e6;
    box-shadow: 0 18px 52px rgba(0, 0, 0, 0.34);
  }

  .alpha-panel[hidden] {
    display: none;
  }

  .alpha-header {
    display: grid;
    align-items: center;
    gap: 10px;
    grid-template-columns: auto minmax(0, 1fr) auto;
    border-bottom: 1px solid rgba(255, 216, 77, 0.18);
    padding: 12px;
  }

  .alpha-header img,
  .alpha-message--assistant img {
    object-fit: contain;
    border-radius: 10px;
    background: rgba(255, 216, 77, 0.14);
  }

  .alpha-header img {
    width: 40px;
    height: 40px;
    padding: 2px;
  }

  .alpha-header h2,
  .alpha-header p,
  .alpha-message p {
    margin: 0;
  }

  .alpha-header h2 {
    font-size: 0.98rem;
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1.25;
  }

  .alpha-header p {
    color: rgba(255, 248, 230, 0.72);
    font-size: 0.76rem;
    font-weight: 800;
    line-height: 1.35;
  }

  .alpha-icon-button,
  .alpha-toggle,
  .alpha-form button,
  .alpha-prompt-row button {
    cursor: pointer;
  }

  .alpha-icon-button {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border: 1px solid rgba(255, 216, 77, 0.34);
    border-radius: 9px;
    background: transparent;
    color: #fff8e6;
  }

  .alpha-messages {
    display: grid;
    max-height: min(310px, 46vh);
    gap: 10px;
    overflow-y: auto;
    padding: 12px;
    scroll-behavior: smooth;
  }

  .alpha-message {
    display: grid;
    max-width: 100%;
    gap: 8px;
    overflow-wrap: anywhere;
  }

  .alpha-message--assistant {
    grid-template-columns: auto minmax(0, 1fr);
    justify-self: start;
  }

  .alpha-message--assistant img {
    width: 32px;
    height: 32px;
    padding: 2px;
  }

  .alpha-message p {
    border-radius: 14px;
    font-size: 0.86rem;
    font-weight: 800;
    line-height: 1.65;
    padding: 9px 11px;
    white-space: pre-line;
  }

  .alpha-message--assistant p {
    border-top-left-radius: 4px;
    background: rgba(255, 245, 220, 0.1);
    color: #fff8e6;
  }

  .alpha-message--assistant p a {
    color: #ffd84d;
    font-weight: 900;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .alpha-message--assistant p a:focus-visible {
    outline: 2px solid #ffd84d;
    outline-offset: 2px;
  }

  .alpha-message--user {
    justify-self: end;
  }

  .alpha-message--user p {
    border-bottom-right-radius: 4px;
    background: #1877f2;
    color: white;
  }

  .alpha-prompt-row {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    border-top: 1px solid rgba(255, 216, 77, 0.14);
    padding: 10px 12px 0;
  }

  .alpha-prompt-row button {
    flex: 0 0 auto;
    min-height: 34px;
    border: 1px solid rgba(255, 216, 77, 0.38);
    border-radius: 999px;
    background: rgba(255, 216, 77, 0.1);
    color: #fff8e6;
    font-size: 0.78rem;
    font-weight: 900;
    line-height: 1;
    padding: 0 12px;
  }

  .alpha-form {
    display: grid;
    align-items: end;
    gap: 8px;
    grid-template-columns: minmax(0, 1fr) auto;
    padding: 10px 12px 8px;
  }

  .alpha-form textarea {
    width: 100%;
    min-height: 44px;
    max-height: 104px;
    resize: vertical;
    border: 1px solid rgba(255, 216, 77, 0.34);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.96);
    color: #15130f;
    font-size: 0.86rem;
    font-weight: 800;
    line-height: 1.45;
    padding: 8px 10px;
  }

  .alpha-form textarea:focus {
    border-color: #ffd84d;
    outline: 3px solid rgba(255, 216, 77, 0.24);
    outline-offset: 1px;
  }

  .alpha-form button {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 0;
    border-radius: 10px;
    background: #35aa2f;
    color: white;
    font-size: 1.1rem;
  }

  .alpha-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0 12px 12px;
  }

  .alpha-links a {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: rgba(255, 248, 230, 0.86);
    font-size: 0.78rem;
    font-weight: 900;
    line-height: 1;
    text-decoration: none;
  }

  .alpha-icon-button:hover,
  .alpha-icon-button:focus-visible,
  .alpha-prompt-row button:hover,
  .alpha-prompt-row button:focus-visible,
  .alpha-links a:hover,
  .alpha-links a:focus-visible {
    color: #ffd84d;
  }

  .alpha-form button:hover,
  .alpha-form button:focus-visible {
    background: #2f9829;
  }

  .alpha-prompt-row button:disabled,
  .alpha-form button:disabled {
    cursor: wait;
    opacity: 0.55;
  }

  .alpha-toggle {
    display: inline-grid;
    width: 76px;
    min-height: 76px;
    place-items: center;
    border: 2px solid #1b24d8;
    border-radius: 18px;
    background: #ffd84d;
    color: #15130f;
    font-size: 0.78rem;
    font-weight: 900;
    line-height: 1;
    box-shadow:
      0 8px 0 rgba(21, 19, 15, 0.22),
      0 18px 42px rgba(0, 0, 0, 0.26);
    transition:
      background-color 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .alpha-panel + .alpha-toggle {
    margin-top: 10px;
  }

  .alpha-toggle img {
    width: 54px;
    height: 44px;
    object-fit: contain;
    filter: drop-shadow(0 3px 0 rgba(0, 0, 0, 0.16));
  }

  .alpha-toggle:hover,
  .alpha-toggle:focus-visible,
  .alpha-widget.is-open .alpha-toggle {
    background: #fff06f;
    transform: translateY(-2px);
  }

  .alpha-toggle:active {
    transform: translateY(1px);
    box-shadow:
      0 4px 0 rgba(21, 19, 15, 0.22),
      0 12px 32px rgba(0, 0, 0, 0.22);
  }

  .alpha-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .alpha-widget {
      right: 12px;
      bottom: max(12px, env(safe-area-inset-bottom));
    }

    .alpha-panel {
      max-height: calc(100vh - 96px);
    }

    .alpha-message--assistant {
      grid-template-columns: minmax(0, 1fr);
    }

    .alpha-message--assistant img {
      display: none;
    }

    .alpha-toggle {
      width: 68px;
      min-height: 68px;
      border-radius: 16px;
    }

    .alpha-toggle img {
      width: 48px;
      height: 38px;
    }
  }
</style>
