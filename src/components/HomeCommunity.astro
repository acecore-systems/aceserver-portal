---
import type { PortalPage } from '../types'
import { getCommunityUi } from '../data/community-ui'
import { getUi } from '../i18n/translations'
import {
  getLocalizedAnnouncements,
  getLocalizedSettings,
} from '../i18n/content'
import {
  DATE_LOCALE_BY_LOCALE,
  localizePath,
  type Locale,
} from '../i18n/config'
import { isWithinPublicationWindow } from '../utils/publication-window'
import { externalLinkAttrs } from '../utils/links'
import youtube from '../data/external/youtube-videos.json'
import activity from '../data/external/community-activity.json'
import Icon from './Icon.astro'

interface Props {
  page: PortalPage
  locale: Locale
  mode: 'status' | 'discover'
}
const { page, locale, mode } = Astro.props
const community = page.community
if (!community) throw new Error('Home community content is missing')
const ui = getCommunityUi(locale)
const sharedUi = getUi(locale)
const settings = getLocalizedSettings(locale)
const notices = getLocalizedAnnouncements(locale)
const worlds = settings.worlds
const selectedWorld =
  worlds.find((world) => world.slug === community.mapWorld) ?? worlds[0]
const mapHost = community.mapWorld === 'resource' ? 'sigen' : community.mapWorld
const mapUrl = `https://mc-map-${mapHost}.acecore.net/`
const discordSourceUrl = settings.discordUrl
const date = (value: string) =>
  new Intl.DateTimeFormat(DATE_LOCALE_BY_LOCALE[locale], {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'Asia/Tokyo',
  }).format(new Date(value))
const fullDate = (value: string) =>
  new Intl.DateTimeFormat(DATE_LOCALE_BY_LOCALE[locale], {
    dateStyle: 'medium',
    timeStyle: 'short',
    timeZone: 'Asia/Tokyo',
  }).format(new Date(value))
---

{mode === 'status' && (
  <section
    class="community community--status"
    aria-labelledby="community-title"
    data-community-status
    data-copy={JSON.stringify(ui)}
    data-locale={locale}
  >
    <header class="community-heading">
      <div>
        <>
          <p class="eyebrow">LIVE COMMUNITY</p>
          <h2 id="community-title">{community.title}</h2>
          <p>{community.intro}</p>
        </>
      </div>
      <button class="small-button" type="button" data-refresh hidden>
        <Icon name="refresh-cw" />
        {ui.refresh}
      </button>
    </header>
    <div class="status-layout">
      <article class="community-card discord-card">
        <h3>
          <Icon name="message-circle" />
          {ui.discordTitle}
        </h3>
        <dl class="discord-counts">
          <div>
            <>
              <dt>{ui.members}</dt>
              <dd data-discord-members>—</dd>
            </>
          </div>
          <div>
            <>
              <dt>{ui.online}</dt>
              <dd data-discord-online>—</dd>
            </>
          </div>
        </dl>
        <p class="state-label" data-discord-state aria-live="polite">
          {ui.loading}
        </p>
        <p class="fine-print">{ui.approximate}</p>
        <time class="fine-print" data-discord-time />
        <a
          class="text-link"
          href={settings.discordUrl}
          {...externalLinkAttrs(settings.discordUrl, true)}
        >
          {ui.moreNotices}
          <Icon name="arrow-up-right" />
        </a>
      </article>
      <article class="community-card minecraft-card">
        <h3>
          <Icon name="gamepad-2" />
          {ui.minecraftTitle}
        </h3>
        <ul class="world-status-grid">
          {worlds.map((world) => (
            <li data-world={world.slug}>
              <a href={world.href}>
                <span>{world.title}</span>
                <strong data-world-count>—</strong>
              </a>
              <span class="state-label" data-world-state>
                {ui.loading}
              </span>
              <time data-world-time />
            </li>
          ))}
        </ul>
        <p class="fine-print">{ui.mapCaution}</p>
      </article>
    </div>
    <noscript>
      <p class="fine-print">
        {ui.unavailable} <a href={settings.discordUrl}>{ui.moreNotices}</a>
      </p>
    </noscript>
    <p class="checked-line" data-status-checked aria-live="polite" />
    <details class="source-details">
      <>
        <summary>{ui.dataSources}</summary>
        <a
          href={discordSourceUrl}
          {...externalLinkAttrs(discordSourceUrl, true)}
        >
          Discord
        </a>
      </>{' '}
      · <a href={localizePath(locale, '/world-map/')}>Dynmap</a>
    </details>
    <aside
      class="notice-strip"
      aria-labelledby="community-notices-title"
      data-community-notices
    >
      <h3 id="community-notices-title">
        <Icon name="calendar-days" />
        {ui.noticesTitle}
      </h3>
      <div class="notice-items">
        <section class="discord-feed" data-feed-events>
          <h4>{ui.eventsTitle}</h4>
          <p class="state-label" data-feed-state aria-live="polite">
            {ui.loading}
          </p>
          <p class="fine-print" data-feed-time />
          <div data-feed-items />
        </section>
        <section class="discord-feed" data-feed-announcements>
          <h4>{ui.announcementsTitle}</h4>
          <p class="fine-print">{ui.originalText}</p>
          <p class="state-label" data-feed-state aria-live="polite">
            {ui.loading}
          </p>
          <p class="fine-print" data-feed-time />
          <div data-feed-items />
        </section>
        {community.events.map((event) => (
          <article
            class="notice-item"
            data-community-event
            data-publication-window
            data-publication-ends-at={event.endsAt}
            hidden={Date.parse(event.endsAt) < Date.now()}
          >
            <time datetime={event.startsAt}>
              {fullDate(event.startsAt)} – {fullDate(event.endsAt)}
            </time>
            <h4>
              <a href={event.href} {...externalLinkAttrs(event.href, true)}>
                {event.title}
              </a>
            </h4>
            <p>{event.text}</p>
          </article>
        ))}
        {notices.map((notice) => (
          <article
            class="notice-item"
            data-community-notice
            data-publication-window
            data-publication-starts-at={notice.startsAt}
            data-publication-ends-at={notice.endsAt}
            hidden={!isWithinPublicationWindow(notice.startsAt, notice.endsAt)}
          >
            <h4>{notice.title}</h4>
            {notice.text && <p>{notice.text}</p>}
            {notice.href && (
              <a
                href={notice.href}
                {...externalLinkAttrs(notice.href, notice.external)}
              >
                {notice.linkLabel ?? notice.title}
              </a>
            )}
          </article>
        ))}
      </div>
    </aside>
  </section>
)}

{mode === 'discover' && (
  <div class="community community--discover">
    <section class="gallery-section" aria-labelledby="community-gallery-title">
      <header class="community-heading">
        <div>
          <>
            <p class="eyebrow">MADE IN ACESERVER</p>
            <h2 id="community-gallery-title">{ui.galleryTitle}</h2>
            <p>{ui.galleryIntro}</p>
          </>
        </div>
      </header>
      <div class="build-gallery">
        {community.gallery.map((item) => (
          <article class="build-card">
            <div class="build-image">
              <img
                src={item.image}
                alt={item.imageAlt}
                width="960"
                height="540"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="build-copy">
              <p class="capture-label">{item.periodLabel}</p>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              {item.context === 'current' && item.href && (
                <a class="text-link" href={item.href}>
                  {ui.openMap}
                  <Icon name="arrow-up-right" />
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
    <div class="explore-grid">
      <section
        class="community-card map-card"
        aria-labelledby="community-map-title"
      >
        <>
          <p class="eyebrow">EXPLORE</p>
          <h2 id="community-map-title">{ui.mapTitle}</h2>
        </>
        <div
          class="map-preview"
          data-map-preview
          data-map-url={mapUrl}
          data-map-title={selectedWorld.title}
        >
          <div class="map-placeholder" aria-hidden="true">
            <>
              <Icon name="map" />
              <span>{ui.mapPlaceholder}</span>
            </>
          </div>
          <button class="small-button" type="button" data-load-map hidden>
            <Icon name="map" />
            {ui.loadMap}
          </button>
        </div>
        <>
          <p class="fine-print">{ui.mapHelp}</p>
          <a class="text-link" href={localizePath(locale, '/world-map/')}>
            {ui.openMap}
            <Icon name="arrow-up-right" />
          </a>
        </>
      </section>
      <section
        class="community-card activity-card"
        aria-labelledby="community-activity-title"
        data-community-history
        data-history={JSON.stringify(activity)}
        data-copy={JSON.stringify(ui)}
        data-locale={locale}
      >
        <>
          <p class="eyebrow">COMMUNITY LOG</p>
          <h2 id="community-activity-title">{ui.activityTitle}</h2>
          <p class="fine-print">{ui.activityIntro}</p>
        </>
        <label class="series-label">
          {ui.historySeries}
          <select data-history-series>
            {worlds.map((world) => (
              <option value={world.slug}>{world.title}</option>
            ))}
            <>
              <option value="discord-online">Discord · {ui.online}</option>
              <option value="discord-members">Discord · {ui.members}</option>
            </>
          </select>
        </label>
        <p class="empty-note" data-history-empty>
          {ui.noHistory}
        </p>
        <svg
          class="activity-chart"
          data-history-chart
          viewBox="0 0 560 200"
          role="img"
          aria-label={ui.activityTitle}
          hidden
        />
        <details class="history-table" data-history-details hidden>
          <>
            <summary>{ui.historyTable}</summary>
            <div class="table-scroll">
              <table>
                <>
                  <thead>
                    <tr>
                      <>
                        <th>{ui.sampleTime} (JST)</th>
                        <th data-series-name>{selectedWorld.title}</th>
                      </>
                    </tr>
                  </thead>
                  <tbody data-history-rows />
                </>
              </table>
            </div>
          </>
        </details>
        <noscript>
          <p class="fine-print">
            {ui.sampleTime}: {activity.samples.at(-1)?.observedAt ?? '—'}
          </p>
        </noscript>
      </section>
    </div>
    <div class="media-grid">
      <section
        class="community-card social-card"
        aria-labelledby="community-social-title"
      >
        <>
          <p class="eyebrow">FROM X</p>
          <h2 id="community-social-title">{ui.socialTitle}</h2>
          <p class="fine-print">{ui.socialIntro}</p>
        </>
        <div class="post-list">
          {community.xPosts.map((post) => (
            <article
              class="post-card"
              data-selected-post
              data-post-url={post.url}
            >
              <time datetime={post.publishedAt}>{date(post.publishedAt)}</time>
              <h3>{post.label}</h3>
              <div class="post-actions">
                <button
                  type="button"
                  class="small-button"
                  data-load-post
                  hidden
                >
                  {ui.loadPost}
                </button>
                <a href={post.url} {...externalLinkAttrs(post.url, true)}>
                  {ui.openPost}
                  <Icon name="arrow-up-right" />
                </a>
              </div>
              <div data-post-embed />
              <p class="fine-print" data-embed-help hidden>
                {ui.embedHelp}
              </p>
            </article>
          ))}
        </div>
      </section>
      <section
        class="community-card recent-card"
        aria-labelledby="community-videos-title"
      >
        <>
          <p class="eyebrow">WATCH & READ</p>
          <h2 id="community-videos-title">{ui.videosTitle}</h2>
        </>
        <div class="recent-videos">
          {youtube.videos.slice(0, 3).map((video) => (
            <a
              class="recent-video"
              href={video.url}
              {...externalLinkAttrs(video.url, true)}
            >
              <img
                src={video.thumbnailUrl}
                alt={video.title}
                loading="lazy"
                width="240"
                height="135"
              />
              <span>
                <strong>{video.title}</strong>
                <time datetime={video.publishedAt}>
                  {date(video.publishedAt)}
                </time>
              </span>
            </a>
          ))}
        </div>
        <a
          class="text-link"
          href={localizePath(locale, '/youtube-search-aceserver/')}
        >
          {ui.allVideos}
          <Icon name="arrow-up-right" />
        </a>
        <article class="diary-teaser">
          <>
            <img
              src="/uploads/alpha-kun.png"
              alt={sharedUi.alphaImageAlt}
              width="76"
              height="76"
              loading="lazy"
            />
            <div>
              <>
                <h3>{ui.diaryTitle}</h3>
                <p>{ui.diaryIntro}</p>
                <a
                  class="text-link"
                  href={localizePath(locale, '/alpha-diary/')}
                >
                  {ui.readDiary}
                  <Icon name="arrow-up-right" />
                </a>
              </>
            </div>
          </>
        </article>
      </section>
    </div>
  </div>
)}

<script>
  import '../scripts/home-community'
  import { initPublicationWindowRuntime } from '../scripts/publication-window'
  initPublicationWindowRuntime()
</script>

<style>
  .community {
    padding: clamp(30px, 5vw, 64px) clamp(18px, 5vw, 76px);
    color: #262014;
  }
  .community--status {
    background: #f9f4e8;
  }
  .community--discover {
    display: grid;
    gap: clamp(32px, 5vw, 64px);
    background: #f4f0e3;
  }
  .community-heading {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }
  .community-heading > div {
    max-width: 760px;
  }
  .eyebrow {
    margin: 0 0 8px;
    color: #39644d;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.12em;
  }
  h2 {
    margin: 0 0 12px;
    font-size: clamp(1.55rem, 3vw, 2.7rem);
    font-weight: 900;
    line-height: 1.25;
  }
  h3 {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 12px;
    font-size: 1.12rem;
    font-weight: 900;
    line-height: 1.4;
  }
  p {
    margin: 0 0 12px;
    line-height: 1.7;
  }
  .status-layout,
  .explore-grid,
  .media-grid,
  .build-gallery {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 20px;
  }
  .status-layout {
    grid-template-columns: minmax(240px, 0.65fr) minmax(0, 1.35fr);
  }
  .community-card {
    min-width: 0;
    border: 2px solid #d4cebc;
    border-radius: 14px;
    padding: clamp(18px, 2.6vw, 30px);
    background: #fffdf7;
    box-shadow: 0 4px 0 #d4cebc;
  }
  .discord-card {
    background: #eceeff;
    border-color: #bec3eb;
    box-shadow: 0 4px 0 #bec3eb;
  }
  .discord-counts {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 28px;
    margin: 12px 0;
  }
  .discord-counts dt {
    color: #4a4960;
    font-size: 0.86rem;
    font-weight: 700;
  }
  .discord-counts dd {
    margin: 0;
    font-size: clamp(2.1rem, 4vw, 3.4rem);
    line-height: 1.25;
    font-weight: 900;
    font-variant-numeric: tabular-nums;
  }
  .fine-print,
  .empty-note,
  .checked-line,
  .source-details {
    color: #645e50;
    font-size: 0.82rem;
  }
  .state-label {
    display: block;
    font-size: 0.73rem;
    color: #50634c;
    line-height: 1.5;
  }
  [data-state='stale'] .state-label,
  .state-label[data-state='stale'] {
    color: #895321;
  }
  [data-state='unavailable'] .state-label,
  .state-label[data-state='unavailable'] {
    color: #6b6262;
  }
  .world-status-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px 14px;
    margin: 0 0 12px;
    padding: 0;
    list-style: none;
  }
  .world-status-grid li {
    min-width: 0;
    padding: 7px 0;
    border-top: 1px solid #ddd8c9;
  }
  .world-status-grid a {
    display: grid;
    gap: 4px;
    color: #313a29;
    font-size: 0.8rem;
    text-decoration: none;
    font-weight: 800;
    overflow-wrap: anywhere;
  }
  .world-status-grid strong {
    font-size: 1.6rem;
    font-variant-numeric: tabular-nums;
  }
  .world-status-grid time {
    display: block;
    color: #756e61;
    font-size: 0.65rem;
  }
  .small-button {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 8px 12px;
    border: 2px solid #496850;
    border-radius: 7px;
    background: #fffdf7;
    color: #29432f;
    font-size: 0.8rem;
    font-weight: 800;
    cursor: pointer;
  }
  .small-button:hover {
    background: #edf4df;
  }
  .small-button:disabled {
    cursor: wait;
    opacity: 0.6;
  }
  a:focus-visible,
  button:focus-visible,
  select:focus-visible,
  summary:focus-visible {
    outline: 3px solid #0862c4;
    outline-offset: 3px;
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #25603b;
    font-size: 0.86rem;
    font-weight: 900;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .checked-line {
    margin: 14px 0 4px;
  }
  .source-details summary,
  .history-table summary {
    cursor: pointer;
  }
  .source-details a {
    display: inline-block;
    margin: 8px 0;
  }
  .notice-strip {
    display: grid;
    align-items: start;
    grid-template-columns: minmax(150px, 0.36fr) minmax(0, 1fr);
    gap: 18px;
    border-top: 2px solid #ded5bd;
    margin-top: 20px;
    padding-top: 22px;
  }
  .notice-strip h3 {
    font-size: 1rem;
  }
  .notice-items {
    min-width: 0;
  }
  .notice-item {
    border-bottom: 1px solid #ddd4c0;
    padding: 0 0 10px;
    margin-bottom: 12px;
  }
  .notice-item h4 {
    margin: 5px 0;
    font-weight: 900;
  }
  .notice-item p {
    font-size: 0.86rem;
  }
  .notice-item time {
    color: #6a5b39;
    font-size: 0.8rem;
  }
  .discord-feed {
    margin-bottom: 18px;
  }
  .discord-feed h4 {
    font-weight: 900;
    margin-bottom: 8px;
  }
  .discord-feed :global(.feed-item) {
    border-top: 1px solid #ddd4c0;
    padding: 9px 0;
  }
  .discord-feed :global(summary) {
    cursor: pointer;
    font-size: 0.86rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .discord-feed :global(.feed-title) {
    font-weight: 800;
  }
  .discord-feed :global(.feed-item--featured .feed-title) {
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0;
    overflow-wrap: anywhere;
  }
  .discord-feed :global(.feed-body) {
    overflow-wrap: anywhere;
    font-size: 0.86rem;
    line-height: 1.85;
    margin: 8px 0;
  }
  .discord-feed :global(.feed-body p) {
    white-space: pre-line;
    margin: 0.6em 0;
  }
  .discord-feed :global(.feed-body h6) {
    font-size: 0.98rem;
    font-weight: 800;
    line-height: 1.6;
    margin: 1.1em 0 0.4em;
  }
  .discord-feed :global(.feed-body h6[data-markdown-level='1']) {
    font-size: 1.03rem;
  }
  .discord-feed :global(.feed-body h6[data-markdown-level='3']),
  .discord-feed :global(.feed-body h6[data-markdown-level='4']),
  .discord-feed :global(.feed-body h6[data-markdown-level='5']),
  .discord-feed :global(.feed-body h6[data-markdown-level='6']) {
    font-size: 0.9rem;
  }
  .discord-feed :global(.feed-body blockquote) {
    border-left: 3px solid #91a77c;
    background: #f4f2e8;
    color: #514c3e;
    margin: 0.7em 0;
    padding: 0.25em 0.8em;
  }
  .discord-feed :global(.feed-body ul),
  .discord-feed :global(.feed-body ol) {
    margin: 0.6em 0;
    padding-left: 1.6em;
  }
  .discord-feed :global(.feed-body ul) {
    list-style: disc;
  }
  .discord-feed :global(.feed-body ol) {
    list-style: decimal;
  }
  .discord-feed :global(.feed-body li + li) {
    margin-top: 0.25em;
  }
  .discord-feed :global(.feed-body strong) {
    font-weight: 800;
  }
  .discord-feed :global(.feed-body em) {
    font-style: italic;
  }
  .discord-feed :global(.feed-body code) {
    border-radius: 3px;
    background: #ece7d9;
    padding: 0.1em 0.3em;
    font-size: 0.9em;
  }
  .discord-feed :global(.feed-body pre) {
    overflow-x: auto;
    white-space: pre-wrap;
    background: #ece7d9;
    padding: 0.7em;
    border-radius: 6px;
  }
  .discord-feed :global(.feed-body pre code) {
    padding: 0;
  }
  .discord-feed :global(.feed-body hr) {
    border: 0;
    border-top: 1px solid #ddd4c0;
    margin: 1em 0;
  }
  .discord-feed :global(time),
  .discord-feed :global(a) {
    font-size: 0.78rem;
  }
  .discord-feed :global(a) {
    color: #356d45;
    text-decoration: underline;
  }
  .discord-feed :global(.feed-body a) {
    font-size: inherit;
  }
  .discord-feed :global(time) {
    display: block;
    color: #6a5b39;
    margin-bottom: 4px;
  }
  .empty-note {
    margin: 0 0 6px;
  }
  .build-card {
    overflow: hidden;
    border: 2px solid #cac1a9;
    border-radius: 14px;
    background: #fffdf7;
    box-shadow: 0 4px 0 #d4cebc;
