---
import { getAlphaDiaryUi } from '../data/alpha-diary-ui'
import { serializeJsonForHtmlScript } from '../data/safe-json'
import type { Locale } from '../i18n/config'
import Icon from './Icon.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = getAlphaDiaryUi(locale)
const fixturesEnabled = import.meta.env.DEV
---

<section
  class="alpha-diary"
  data-alpha-diary
  data-endpoint="/api/alpha-diary"
  data-fixtures={String(fixturesEnabled)}
  data-locale={locale}
>
  <script
    type="application/json"
    data-alpha-diary-copy
    set:html={serializeJsonForHtmlScript(copy)}
  />

  <header class="diary-hero">
    <div class="diary-hero__sky" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
    <div class="diary-hero__inner">
      <div class="diary-hero__copy">
        <p class="diary-eyebrow">{copy.eyebrow}</p>
        <h1>{copy.title}</h1>
      </div>
      <div class="diary-hero__portrait" aria-hidden="true">
        <span class="diary-hero__sun"></span>
        <img
          src="/uploads/alpha-kun.png"
          alt={copy.title}
          width="256"
          height="256"
        />
      </div>
    </div>
  </header>

  <div class="diary-shell">
    <aside class="diary-sidebar" aria-label={copy.dateLabel}>
      <section class="diary-control-card">
        <div class="diary-control-card__label">
          <Icon name="calendar-days" />
          <h2>{copy.dateLabel}</h2>
        </div>
        <form class="diary-date-form" data-diary-date-form novalidate>
          <input
            type="date"
            min="0001-01-01"
            name="date"
            aria-label={copy.dateLabel}
            data-diary-date
          />
          <button type="submit" class="diary-button diary-button--gold">
            {copy.openDate}
          </button>
        </form>
        <div class="diary-day-nav">
          <button type="button" data-diary-previous>
            <Icon name="chevron-left" />
            <span>{copy.previousDay}</span>
          </button>
          <button type="button" data-diary-today>
            <Icon name="sun" />
            <span>{copy.today}</span>
          </button>
          <button type="button" data-diary-next>
            <span>{copy.nextDay}</span>
            <Icon name="chevron-right" />
          </button>
        </div>
      </section>

      <section class="diary-latest" data-diary-latest hidden>
        <p>{copy.latestAvailable}</p>
        <button type="button" data-diary-follow-latest>
          <Icon name="refresh-cw" />
          {copy.followLatest}
        </button>
      </section>

      <button type="button" class="diary-reset" data-diary-reset>
        <Icon name="eraser" />
        {copy.resetProgress}
      </button>
    </aside>

    <div class="diary-main-column">
      <article class="diary-paper" data-diary-paper data-record-kind="loading">
        <div class="diary-paper__rings" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="diary-paper__rule" aria-hidden="true"></div>

        <section class="diary-state" data-diary-state aria-live="polite">
          <div class="diary-state__spinner" aria-hidden="true">
            <img
              src="/uploads/alpha-kun.png"
              alt={copy.loadingTitle}
              width="128"
              height="128"
            />
          </div>
          <p class="diary-state__kicker">ALPHA'S RECORD</p>
          <h2 data-diary-state-title>{copy.loadingTitle}</h2>
          <p data-diary-state-body>{copy.loadingBody}</p>
          <button
            type="button"
            class="diary-button diary-button--gold"
            data-diary-retry
            hidden
          >
            <Icon name="rotate-cw" />
            {copy.retry}
          </button>
        </section>

        <div class="diary-entry" data-diary-entry hidden>
          <header class="diary-entry__header">
            <div>
              <span class="diary-kind" data-diary-kind>{copy.diaryKind}</span>
              <time data-diary-record-date></time>
            </div>
            <span class="diary-record-id" data-diary-record-id></span>
          </header>
          <h2 data-diary-title></h2>
          <figure class="diary-drawing">
            <span class="diary-tape diary-tape--left" aria-hidden="true"></span>
            <span class="diary-tape diary-tape--right" aria-hidden="true"
            ></span>
            <div class="diary-drawing__mat">
              <img
                data-diary-image
                src="/uploads/alpha-kun.png"
                alt={copy.diaryKind}
              />
            </div>
          </figure>
          <div class="diary-entry__body" data-diary-body></div>
          <section
            class="diary-questions"
            aria-labelledby="diary-question-title"
          >
            <div class="diary-questions__heading">
              <span aria-hidden="true">?</span>
              <div>
                <h3 id="diary-question-title">{copy.questionsTitle}</h3>
                <p>{copy.questionsLead}</p>
              </div>
            </div>
            <div class="diary-question-list" data-diary-questions></div>
          </section>
        </div>
      </article>

      <section class="diary-unlocked" data-diary-unlocked hidden>
        <div class="diary-unlocked__seal" aria-hidden="true">
          <Icon name="key-round" />
        </div>
        <div>
          <p>THE PAPER MOVED</p>
          <h2>{copy.unlockedTitle}</h2>
          <span>{copy.unlockedBody}</span>
        </div>
        <button type="button" data-diary-open-finale>
          <Icon name="eye" />
          <span>{copy.showHorror}</span>
        </button>
      </section>
    </div>
  </div>

  <p class="diary-live" role="status" aria-live="polite" data-diary-live></p>
  <noscript><p class="diary-noscript">{copy.noScript}</p></noscript>

  <dialog
    class="diary-dialog diary-gate"
    data-diary-gate
    aria-labelledby="diary-gate-title"
  >
    <div class="diary-dialog__page">
      <span class="diary-dialog__mark" aria-hidden="true">18+</span>
      <p class="diary-dialog__kicker">CONTENT NOTICE</p>
      <h2 id="diary-gate-title">{copy.gateTitle}</h2>
      <p>{copy.gateBody}</p>
      <p class="diary-dialog__details">{copy.gateDetails}</p>
      <div class="diary-dialog__actions">
        <button
          type="button"
          class="diary-button diary-button--ink"
          data-gate-cancel
        >
          {copy.cancelGate}
        </button>
        <button
          type="button"
          class="diary-button diary-button--gold"
          data-gate-confirm
        >
          {copy.confirmAdult}
        </button>
      </div>
    </div>
  </dialog>

  <dialog
    class="diary-dialog diary-finale-choice"
    data-diary-finale-dialog
    aria-labelledby="diary-finale-title"
  >
    <div class="diary-dialog__page">
      <span
        class="diary-dialog__mark diary-dialog__mark--key"
        aria-hidden="true"
      >
        <Icon name="key-round" />
      </span>
      <p class="diary-dialog__kicker">THE LAST PAGE</p>
      <h2 id="diary-finale-title">{copy.finaleTitle}</h2>
      <p>{copy.finaleBody}</p>
      <div class="diary-finale-modes">
        <button type="button" data-finale-mode="horror">
          <Icon name="maximize" />
          <span>{copy.showHorror}</span>
        </button>
        <button type="button" data-finale-mode="reduced">
          <Icon name="wind" />
          <span>{copy.reducedMotion}</span>
        </button>
        <button type="button" data-finale-mode="text">
          <Icon name="text" />
          <span>{copy.textOnly}</span>
        </button>
      </div>
      <button type="button" class="diary-dialog__later" data-finale-later>
        {copy.notNow}
      </button>
    </div>
  </dialog>

  <section
    class="diary-finale-overlay"
    data-diary-finale-overlay
    data-mode="horror"
    data-stage="ordinary"
    role="dialog"
    aria-modal="true"
    aria-labelledby="diary-finale-overlay-title"
    aria-describedby="diary-finale-message-accessible"
    tabindex="-1"
    hidden
  >
    <button type="button" class="finale-stop" data-finale-stop>
      <Icon name="x" />
      <span>{copy.stopExperience}</span>
      <kbd>Esc</kbd>
    </button>

    <div class="finale-visual" aria-hidden="true">
      <div class="finale-ordinary-page">
        <span>ALPHA'S PICTURE DIARY</span>
        <strong data-finale-date>2020.10.01</strong>
        <em data-finale-correction>DATE ACCEPTED</em>
      </div>
      <p class="finale-glitch" data-finale-glitch>
        RECORD DATE MISMATCH<br />SUBJECT / ALPHA
      </p>
      <p class="finale-reversal">THE RECORD IS LOOKING BACK</p>
      <div class="finale-paper-invasion"></div>
      <div class="finale-shards" data-finale-shards></div>
      <div class="finale-interference"></div>
    </div>

    <div class="finale-content">
      <section class="finale-logs">
        <p>OBSERVATION LOG / OPENED BY YOU</p>
        <h2>{copy.openedRecords}</h2>
        <ol data-finale-opened-list></ol>
      </section>

      <figure class="finale-figure">
        <img
          data-finale-image
          src="/uploads/alpha-kun.png"
          alt={copy.finaleTitle}
        />
      </figure>

      <section class="finale-message">
        <p class="finale-message__lead">TO THE ONE WHO LEARNED EVERYTHING</p>
        <h2 id="diary-finale-overlay-title">{copy.finaleTitle}</h2>
        <p
          class="finale-message__generated"
          data-finale-message-visual
          aria-hidden="true"
        >
        </p>
        <p
          id="diary-finale-message-accessible"
          class="diary-sr-only"
          data-finale-message
        >
        </p>
      </section>

      <section class="finale-hope">
        <span aria-hidden="true">2020.10.01</span>
        <div class="finale-hope__line" aria-hidden="true"></div>
        <span>{copy.today}</span>
        <p>{copy.unlockedBody}</p>
        <div class="finale-hope__actions">
          <button type="button" data-finale-return>
            <Icon name="sunrise" />
            {copy.returnToday}
          </button>
          <button type="button" data-finale-ask-today>
            <Icon name="message-circle" />
            {copy.askToday}
          </button>
        </div>
      </section>
    </div>
  </section>
</section>

<script>
  import '../scripts/alpha-diary'
</script>

<style>
  :global(body.alpha-diary-finale-active) {
    overflow: hidden;
  }

  .alpha-diary {
    --diary-ink: #292017;
    --diary-brown: #5b3c22;
    --diary-paper: #fff8df;
    --diary-blue: #6fd6f6;
    --diary-green: #65bd4a;
    --diary-gold: #f7c948;
    position: relative;
    min-height: 100vh;
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0.14) 1px, transparent 1px) 0
        0 / 32px 32px,
      linear-gradient(rgba(255, 255, 255, 0.14) 1px, transparent 1px) 0 0 / 32px
        32px,
      linear-gradient(
        180deg,
        #a8e9fa 0 16rem,
        #d9f4c6 16rem 19rem,
        #f3e4bd 19rem 100%
      );
    color: var(--diary-ink);
    overflow: clip;
  }

  .diary-hero {
    position: relative;
    border-bottom: 8px solid #5e9e3e;
    overflow: hidden;
  }

  .diary-hero::after {
    position: absolute;
    right: -5%;
    bottom: -48px;
    left: -5%;
    height: 76px;
    background: #88ce57;
    border-radius: 50% 50% 0 0;
    content: '';
  }

  .diary-hero__sky {
    position: absolute;
    inset: 0;
    opacity: 0.72;
  }

  .diary-hero__sky span {
    position: absolute;
    width: 54px;
    height: 18px;
    background: rgba(255, 255, 255, 0.8);
    box-shadow:
      18px -10px 0 rgba(255, 255, 255, 0.8),
      38px 0 0 rgba(255, 255, 255, 0.8);
  }

  .diary-hero__sky span:nth-child(1) {
    top: 24%;
    left: 7%;
  }
  .diary-hero__sky span:nth-child(2) {
    top: 15%;
    left: 44%;
    transform: scale(0.7);
  }
  .diary-hero__sky span:nth-child(3) {
    top: 40%;
    left: 64%;
    transform: scale(0.86);
  }
  .diary-hero__sky span:nth-child(4) {
    top: 12%;
    right: 5%;
    transform: scale(0.55);
  }
  .diary-hero__sky span:nth-child(5) {
    bottom: 12%;
    left: 25%;
    transform: scale(0.5);
  }

  .diary-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(210px, 0.42fr);
    align-items: end;
    width: min(1180px, calc(100% - 40px));
    min-height: 250px;
    margin: 0 auto;
    padding: 42px 0 34px;
  }

  .diary-hero__copy {
    max-width: 760px;
  }
  .diary-eyebrow {
    display: inline-flex;
    margin: 0 0 12px;
    border: 2px solid #4d341f;
    background: #fff4b7;
    padding: 5px 11px;
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    transform: rotate(-1deg);
    box-shadow: 3px 3px 0 rgba(71, 49, 28, 0.22);
  }

  .diary-hero h1 {
    max-width: 12em;
    margin: 0;
    color: #2a2117;
    font-size: clamp(2.3rem, 6vw, 4.6rem);
    font-weight: 900;
    letter-spacing: -0.055em;
    line-height: 1.05;
    text-shadow:
      3px 3px 0 rgba(255, 255, 255, 0.8),
      6px 6px 0 rgba(56, 117, 56, 0.18);
  }

  .diary-hero__portrait {
    position: relative;
    height: 205px;
  }

  .diary-hero__portrait img {
    position: absolute;
    z-index: 1;
    right: 12px;
    bottom: -36px;
    width: min(230px, 100%);
    height: 230px;
    object-fit: contain;
    filter: drop-shadow(0 10px 0 rgba(74, 84, 33, 0.18));
  }

  .diary-hero__sun {
    position: absolute;
    top: 15px;
    right: 35px;
    width: 115px;
    height: 115px;
    border: 8px solid rgba(255, 255, 255, 0.48);
    border-radius: 50%;
    background: #ffd75c;
    box-shadow: 0 0 0 18px rgba(255, 225, 108, 0.25);
  }

  .diary-shell {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 290px minmax(0, 820px);
    gap: 28px;
    justify-content: center;
    width: min(1180px, calc(100% - 32px));
    margin: 32px auto 64px;
  }

  .diary-sidebar {
    display: grid;
    align-content: start;
    gap: 18px;
  }
  .diary-control-card,
  .diary-latest {
    border: 3px solid var(--diary-brown);
    border-radius: 10px;
    background: rgba(255, 248, 223, 0.96);
    box-shadow: 7px 7px 0 rgba(74, 52, 29, 0.16);
  }

  .diary-control-card {
    padding: 18px;
  }
  .diary-control-card__label {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }
  .diary-control-card__label h2 {
    margin: 0;
    font-size: 1rem;
  }
  .diary-control-card__label :global(svg) {
    color: #137ea9;
    font-size: 1.25rem;
  }
  .diary-date-form {
    display: grid;
    gap: 9px;
  }
  .diary-date-form input {
    width: 100%;
    min-height: 48px;
    border: 2px solid #6b4a2e;
    border-radius: 5px;
    background: #fffdf5;
    padding: 8px 10px;
    color: #262017;
    font-weight: 900;
  }

  .diary-button {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    gap: 7px;
    border: 2px solid #44301d;
    border-radius: 6px;
    padding: 9px 14px;
    font-weight: 900;
    box-shadow: 0 4px 0 rgba(50, 35, 20, 0.25);
    cursor: pointer;
  }
  .diary-button--gold {
    background: var(--diary-gold);
    color: #231a11;
  }
  .diary-button--ink {
    background: #2f2922;
    color: #fff8df;
  }
  .diary-button:active {
    transform: translateY(2px);
    box-shadow: 0 2px 0 rgba(50, 35, 20, 0.25);
  }

  .diary-day-nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 5px;
    margin-top: 12px;
  }
  .diary-day-nav button,
  .diary-reset,
  .diary-latest button {
    border: 0;
    background: transparent;
    color: #523a24;
    cursor: pointer;
    font-size: 0.74rem;
    font-weight: 900;
  }
  .diary-day-nav button {
    display: grid;
    min-height: 58px;
    place-items: center;
    border-radius: 5px;
    background: #ebdfbf;
    padding: 5px;
  }
  .diary-day-nav button:hover,
  .diary-day-nav button:focus-visible {
    background: #d6edca;
  }
  .diary-latest {
    padding: 15px;
    background: #ecf9e6;
  }
  .diary-latest p {
    margin: 0 0 10px;
    font-size: 0.78rem;
  }
  .diary-latest button,
  .diary-reset {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .diary-latest button {
    width: 100%;
    justify-content: center;
    border-radius: 5px;
    background: #bce9a9;
    padding: 9px;
  }
  .diary-reset {
    justify-self: center;
    color: #695847;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .diary-main-column {
    min-width: 0;
  }
  .diary-paper {
    position: relative;
    min-height: 700px;
    border: 3px solid #684a2c;
    border-radius: 6px 14px 14px 6px;
    background:
      linear-gradient(
        90deg,
        transparent 76px,
        rgba(211, 98, 83, 0.3) 77px,
        transparent 79px
      ),
      repeating-linear-gradient(
        0deg,
        transparent 0 37px,
        rgba(75, 145, 180, 0.15) 38px 39px
      ),
      var(--diary-paper);
    padding: clamp(28px, 5vw, 52px) clamp(24px, 6vw, 68px)
      clamp(36px, 6vw, 64px) clamp(68px, 9vw, 96px);
    box-shadow:
      12px 15px 0 rgba(83, 58, 32, 0.15),
      0 25px 70px rgba(66, 45, 25, 0.2);
    transition:
      filter 400ms ease,
      background-color 400ms ease;
  }

  .diary-paper[data-record-kind='observation'] {
    background:
      linear-gradient(
        90deg,
        transparent 76px,
        rgba(108, 67, 51, 0.34) 77px,
        transparent 79px
      ),
      repeating-linear-gradient(
        0deg,
        transparent 0 37px,
        rgba(85, 75, 58, 0.13) 38px 39px
      ),
      #e6d8b3;
    filter: saturate(0.72) contrast(1.04);
  }
  .diary-paper[data-record-kind='future'] {
    background: #fffdf4;
  }

  .diary-paper__rings {
    position: absolute;
    z-index: 2;
    top: 46px;
    bottom: 46px;
    left: 22px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .diary-paper__rings span {
    width: 20px;
    height: 20px;
    border: 5px solid #856344;
    border-radius: 50%;
    background: #cab98e;
    box-shadow: inset 0 0 0 2px #f8edce;
  }
  .diary-paper__rule {
    position: absolute;
    inset: 0 auto 0 52px;
    width: 3px;
    background: rgba(187, 89, 72, 0.22);
  }

  .diary-state {
    display: grid;
    min-height: 570px;
    place-items: center;
    align-content: center;
    text-align: center;
  }
  .diary-state__spinner {
    width: 170px;
    height: 150px;
    display: grid;
    place-items: center;
    border: 3px dashed #96734d;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.44);
  }
  .diary-state__spinner img {
    width: 120px;
    height: 120px;
    object-fit: contain;
  }
  .diary-state.is-loading .diary-state__spinner {
    animation: diary-wobble 2.4s ease-in-out infinite;
  }
  .diary-state__kicker {
    margin: 24px 0 3px;
    color: #9b7040;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.16em;
  }
  .diary-state h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2.35rem);
  }
  .diary-state > p:last-of-type {
    max-width: 520px;
    color: #6e5b43;
  }

  .diary-entry__header {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 14px;
    border-bottom: 2px dashed rgba(100, 71, 41, 0.35);
    padding-bottom: 14px;
  }
  .diary-entry__header > div {
    display: grid;
    gap: 4px;
  }
  .diary-kind {
    width: fit-content;
    border: 2px solid #477c2e;
    background: #c8efa9;
    padding: 3px 9px;
    color: #315f22;
    font-size: 0.71rem;
    font-weight: 900;
    transform: rotate(-1deg);
  }
  [data-record-kind='observation'] .diary-kind {
    border-color: #66432f;
    background: #cbb991;
    color: #4e3526;
    letter-spacing: 0.08em;
  }
  .diary-entry time {
    font-size: 1.15rem;
    font-weight: 900;
  }
  .diary-record-id {
    border: 2px solid rgba(94, 58, 39, 0.6);
    padding: 5px 8px;
    color: #765642;
    font-family: ui-monospace, monospace;
    font-size: 0.68rem;
    transform: rotate(2deg);
  }
  .diary-entry > h2 {
    margin: 25px 0 26px;
    font-size: clamp(1.7rem, 4vw, 3rem);
    line-height: 1.25;
    text-align: center;
    text-decoration: underline wavy rgba(59, 135, 178, 0.36);
    text-underline-offset: 10px;
  }

  .diary-drawing {
    position: relative;
    max-width: 680px;
    margin: 0 auto 35px;
  }
  .diary-drawing__mat {
    display: grid;
    aspect-ratio: 4 / 3;
    place-items: center;
    border: 3px solid #51351e;
    background: linear-gradient(145deg, #9ee7fb, #d8f5bd);
    padding: 12px;
    box-shadow: 8px 9px 0 rgba(71, 49, 28, 0.2);
    overflow: hidden;
  }
  .diary-drawing img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: rgba(255, 255, 255, 0.32);
  }
  .diary-drawing img[src='/uploads/alpha-kun.png'] {
    object-fit: contain;
    padding: 8%;
  }
  [data-record-kind='observation'] .diary-drawing__mat {
    background: #bdb08b;
    border-color: #4b3929;
    box-shadow: 8px 9px 0 rgba(41, 32, 23, 0.28);
  }
  [data-record-kind='observation'] .diary-drawing img {
    filter: sepia(0.4) saturate(0.58) contrast(1.08);
  }
  .diary-tape {
    position: absolute;
    z-index: 2;
    top: -12px;
    width: 88px;
    height: 28px;
    background: rgba(255, 225, 126, 0.68);
    transform: rotate(-5deg);
  }
  .diary-tape--left {
    left: -22px;
  }
  .diary-tape--right {
    right: -22px;
    transform: rotate(5deg);
  }

  .diary-entry__body {
    max-width: 680px;
    margin: 0 auto;
    color: #3e3328;
    font-size: clamp(1rem, 2vw, 1.15rem);
    font-weight: 700;
    line-height: 2.1;
  }
  .diary-entry__body p {
    margin: 0 0 1.35em;
  }
  [data-record-kind='observation'] .diary-entry__body {
    color: #3b3329;
    font-family: ui-monospace, 'Noto Sans JP', monospace;
    font-size: 0.98rem;
    letter-spacing: 0.02em;
  }

  .diary-questions {
    max-width: 680px;
    margin: 40px auto 0;
    border-top: 3px double #8b6b47;
    padding-top: 24px;
  }
  .diary-questions__heading {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 12px;
  }
  .diary-questions__heading > span {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 3px solid #1e78a3;
    border-radius: 50%;
    background: #bdeeff;
    color: #12698e;
    font-size: 1.4rem;
    font-weight: 900;
  }
  .diary-questions h3 {
    margin: 0;
    font-size: 1.2rem;
  }
  .diary-questions p {
    margin: 4px 0 0;
    color: #705d46;
    font-size: 0.78rem;
  }
  .diary-question-list {
    display: grid;
    gap: 9px;
    margin-top: 16px;
  }
  :global(.diary-question) {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 14px;
    width: 100%;
    border: 2px solid #426a35;
    border-radius: 7px;
    background: #edf9e6;
    padding: 11px 13px;
    color: #2e3026;
    text-align: left;
    cursor: pointer;
  }
  :global(.diary-question:hover),
  :global(.diary-question:focus-visible) {
    background: #d8f4ca;
    border-color: #2b8b44;
  }
  :global(.diary-question strong) {
    color: #13769b;
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .diary-unlocked {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 18px;
    margin-top: 24px;
    border: 3px solid #33261a;
    border-radius: 9px;
    background: #201c18;
    padding: 20px;
    color: #fff7da;
    box-shadow: 9px 9px 0 rgba(67, 46, 25, 0.22);
  }
  .diary-unlocked__seal {
    display: grid;
    width: 62px;
    height: 62px;
    place-items: center;
    border: 3px solid #e7b832;
    border-radius: 50%;
    color: #ffd75b;
    font-size: 1.8rem;
  }
  .diary-unlocked p {
    margin: 0;
    color: #e3b83c;
    font:
      900 0.68rem/1 ui-monospace,
      monospace;
    letter-spacing: 0.14em;
  }
  .diary-unlocked h2 {
    margin: 5px 0 4px;
    font-size: 1.25rem;
  }
  .diary-unlocked span {
    font-size: 0.83rem;
  }
  .diary-unlocked button {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    gap: 8px;
    border: 2px solid #daae2c;
    border-radius: 5px;
    background: #e2b62e;
    padding: 10px 15px;
    color: #201a12;
    font-weight: 900;
    cursor: pointer;
  }

  .diary-live {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .diary-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    border: 0;
    padding: 0;
    clip-path: inset(50%);
    overflow: hidden;
    white-space: nowrap;
  }
  .diary-noscript {
    width: min(800px, calc(100% - 32px));
    margin: 20px auto;
    border: 2px solid #693b2b;
    background: #fff2d6;
    padding: 16px;
  }

  .diary-dialog {
    width: min(650px, calc(100% - 28px));
    max-height: calc(100dvh - 28px);
    border: 0;
    border-radius: 9px;
    background: transparent;
    padding: 0;
    color: var(--diary-ink);
    overflow: auto;
  }
  .diary-dialog::backdrop {
    background: rgba(14, 17, 17, 0.76);
    backdrop-filter: blur(5px);
  }
  .diary-dialog__page {
    position: relative;
    border: 4px solid #51351f;
    border-radius: 8px;
    background:
      repeating-linear-gradient(
        0deg,
        transparent 0 34px,
        rgba(75, 145, 180, 0.12) 35px
      ),
      #fff5d8;
    padding: clamp(28px, 6vw, 52px);
    box-shadow: inset 0 0 0 8px rgba(153, 116, 71, 0.12);
  }
  .diary-dialog__mark {
    display: grid;
    width: 72px;
    height: 72px;
    place-items: center;
    border: 4px solid #863d32;
    border-radius: 50%;
    color: #863d32;
    font-size: 1.35rem;
    font-weight: 900;
    transform: rotate(-8deg);
  }
  .diary-dialog__mark--key {
    border-color: #755316;
    color: #755316;
    font-size: 1.8rem;
  }
  .diary-dialog__kicker {
    margin: 18px 0 6px;
    color: #845a34;
    font:
      900 0.72rem/1 ui-monospace,
      monospace;
    letter-spacing: 0.16em;
  }
  .diary-dialog h2 {
    margin: 0 0 16px;
    font-size: clamp(1.5rem, 4vw, 2.2rem);
  }
  .diary-dialog__details {
    border-left: 4px solid #bf7a38;
    background: rgba(238, 215, 174, 0.64);
    padding: 12px 14px;
    font-size: 0.88rem;
  }
  .diary-dialog__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 25px;
  }
  .diary-finale-modes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-top: 24px;
  }
  .diary-finale-modes button {
    display: grid;
    min-height: 105px;
    place-items: center;
    gap: 8px;
    border: 2px solid #49331e;
    border-radius: 6px;
    background: #28231e;
    padding: 12px;
    color: #fff2cd;
    font-weight: 900;
    cursor: pointer;
  }
  .diary-finale-modes button:first-child {
    background: #171719;
    color: #f4e3bf;
  }
  .diary-finale-modes button:nth-child(2) {
    background: #425e62;
  }
  .diary-finale-modes button:nth-child(3) {
    background: #f2e6c7;
    color: #292219;
  }
  .diary-finale-modes :global(svg) {
    font-size: 1.5rem;
  }
  .diary-dialog__later {
    display: block;
    margin: 18px auto 0;
    border: 0;
    background: transparent;
    color: #5f4e3b;
    font-weight: 900;
    text-decoration: underline;
    cursor: pointer;
  }

  .diary-finale-overlay {
    --finale-shift-x: 0px;
    --finale-shift-y: 0px;
    position: fixed;
    z-index: 1000;
    inset: 0;
    min-height: 100dvh;
    background: radial-gradient(circle at 50% 42%, #25231e 0, #090a0b 58%);
    color: #f7eed7;
    overflow: auto;
    isolation: isolate;
    transition: background-color 1.2s ease;
  }
  .diary-finale-overlay::before,
  .diary-finale-overlay::after {
    position: fixed;
    pointer-events: none;
    content: '';
  }
  .diary-finale-overlay::before {
    z-index: 2;
    inset: -12%;
    background: repeating-linear-gradient(
      0deg,
      transparent 0 7px,
      rgba(214, 196, 156, 0.035) 8px
    );
    animation: finale-scan 9s linear infinite;
  }
  .diary-finale-overlay::after {
    z-index: 5;
    inset: 0;
    background: radial-gradient(circle, transparent 22%, rgba(0, 0, 0, 0.8));
  }
  .diary-finale-overlay[hidden] {
    display: none;
  }
  .finale-stop {
    position: fixed;
    z-index: 30;
    top: max(14px, env(safe-area-inset-top));
    right: max(14px, env(safe-area-inset-right));
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 7px;
    border: 1px solid rgba(255, 244, 216, 0.48);
    border-radius: 4px;
    background: rgba(12, 13, 14, 0.92);
    padding: 8px 11px;
    color: #fff3d6;
    font-weight: 900;
    cursor: pointer;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.42);
  }
  .finale-stop kbd {
    border: 1px solid #897d6a;
    border-radius: 3px;
    padding: 1px 5px;
    font:
      700 0.68rem/1.4 ui-monospace,
      monospace;
  }
  .finale-visual {
    position: fixed;
    z-index: 1;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    transition: opacity 900ms ease;
  }
  .finale-ordinary-page {
    position: absolute;
    z-index: 1;
    inset: 10% 12%;
    display: grid;
    grid-template-rows: auto 1fr auto;
    place-items: center;
    border: 2px solid #7c6f58;
    background:
      repeating-linear-gradient(
        0deg,
        transparent 0 39px,
        rgba(99, 82, 59, 0.11) 40px
      ),
      #e9ddbd;
    padding: clamp(24px, 5vw, 60px);
    color: #2e291f;
    font:
      900 clamp(0.8rem, 2vw, 1.3rem)/1.5 ui-monospace,
      monospace;
    box-shadow:
      0 0 100px rgba(221, 199, 151, 0.12),
      inset 0 0 80px rgba(82, 51, 34, 0.08);
    transform: translate3d(var(--finale-shift-x), var(--finale-shift-y), 0);
    transition:
      opacity 700ms ease,
      filter 900ms ease,
      transform 1.1s cubic-bezier(0.18, 0.75, 0.16, 1);
  }
  .finale-ordinary-page strong {
    align-self: center;
    font-size: clamp(1rem, 4vw, 3.5rem);
    text-align: center;
  }
  .finale-ordinary-page em {
    justify-self: end;
    border: 2px solid #8e3e38;
    padding: 5px 8px;
    color: #7a302c;
    font-size: clamp(0.6rem, 1.4vw, 0.78rem);
    font-style: normal;
    letter-spacing: 0.12em;
    transform: rotate(-2deg);
  }
  .finale-glitch,
  .finale-reversal {
    position: absolute;
    z-index: 7;
    margin: 0;
    font-family: ui-monospace, monospace;
    font-weight: 900;
    pointer-events: none;
  }
  .finale-glitch {
    top: 16%;
    right: 6%;
    max-width: min(520px, 80vw);
    color: #c24e47;
    font-size: clamp(0.72rem, 2vw, 1.25rem);
    line-height: 1.65;
    letter-spacing: 0.15em;
    opacity: 0;
    transform: translate3d(24px, -5px, 0) rotate(1deg);
    transition:
      opacity 700ms ease,
      transform 900ms ease;
  }
  .finale-reversal {
    top: 50%;
    left: 50%;
    width: min(90vw, 1000px);
    color: #d6c7a5;
    font-size: clamp(1rem, 4.5vw, 4.4rem);
    letter-spacing: 0.08em;
    text-align: center;
    opacity: 0;
    transform: translate(-50%, -44%) scale(0.82);
    transition:
      opacity 1s ease,
      transform 1.4s cubic-bezier(0.18, 0.78, 0.16, 1);
  }
  .finale-paper-invasion {
    position: absolute;
    z-index: 2;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(96, 54, 43, 0.16), transparent 24%),
      repeating-linear-gradient(
        0deg,
        transparent 0 43px,
        rgba(103, 72, 55, 0.17) 44px
      ),
      #cabd9b;
    clip-path: polygon(50% 100%, 50% 100%, 50% 100%, 50% 100%);
    transition: clip-path 2s cubic-bezier(0.66, 0, 0.18, 1);
  }
  .finale-shards {
    position: absolute;
    z-index: 6;
    inset: 0;
    transform: translate3d(var(--finale-shift-x), var(--finale-shift-y), 0);
    transition: transform 900ms ease;
  }
  .finale-shards :global(.finale-shard) {
    position: absolute;
    top: var(--shard-top);
    left: var(--shard-left);
    width: clamp(105px, 15vw, 230px);
    border: 1px solid rgba(92, 62, 44, 0.72);
    background: rgba(225, 210, 170, 0.93);
    padding: 8px 10px;
    color: #554536;
    font:
      900 clamp(0.55rem, 1.3vw, 0.76rem)/1.4 ui-monospace,
      monospace;
    letter-spacing: 0.08em;
    opacity: 0;
    transform: translate3d(var(--shard-from-x), var(--shard-from-y), 0)
      rotate(var(--shard-rotate)) scale(0.45);
    transition:
      opacity 1.1s ease var(--shard-delay),
      transform 1.7s cubic-bezier(0.16, 0.76, 0.18, 1) var(--shard-delay),
      filter 900ms ease;
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.38);
  }
  .finale-interference {
    position: absolute;
    z-index: 8;
    inset: -12%;
    background: repeating-linear-gradient(
      0deg,
      transparent 0 5px,
      rgba(69, 45, 37, 0.12) 6px
    );
    mix-blend-mode: multiply;
    opacity: 0;
    transition: opacity 900ms ease;
    animation: finale-scan 7s linear infinite reverse;
  }
  .finale-content {
    position: relative;
    z-index: 10;
    display: grid;
    min-height: 100dvh;
    place-items: center;
    padding: 80px clamp(20px, 5vw, 70px) 50px;
  }
  .finale-logs,
  .finale-figure,
  .finale-message,
  .finale-hope {
    grid-area: 1 / 1;
    width: min(900px, 100%);
    opacity: 0;
    transform: translateY(20px);
    pointer-events: none;
    transition:
      opacity 900ms ease,
      filter 900ms ease,
      transform 1.1s cubic-bezier(0.18, 0.78, 0.16, 1);
  }
  .finale-logs {
    align-self: center;
    font-family: ui-monospace, monospace;
  }
  .finale-logs > p {
    color: #c5a754;
    letter-spacing: 0.16em;
  }
  .finale-logs h2 {
    font-size: clamp(1.4rem, 4vw, 3rem);
  }
  .finale-logs ol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 8px;
    max-height: 50dvh;
    padding: 0;
    list-style: none;
    overflow: auto;
  }
  .finale-logs :global(li) {
    display: grid;
    gap: 4px;
    border: 1px solid #5d5548;
    background: rgba(22, 20, 17, 0.84);
    padding: 10px 12px;
    color: #ddd0b3;
    animation: finale-log-arrive 650ms ease both;
  }
  .finale-logs :global(li span) {
    color: #9f8b68;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
  }
  .finale-figure {
    max-width: min(1080px, 94vw);
    margin: 0;
  }
  .finale-figure img {
    width: 100%;
    max-height: 78dvh;
    border: 1px solid #655d50;
    object-fit: contain;
    filter: sepia(0.45) saturate(0.55) brightness(0.48) contrast(1.24);
    clip-path: polygon(3% 5%, 96% 0, 100% 92%, 91% 100%, 2% 96%, 0 18%);
    box-shadow: 0 40px 120px #000;
    transition:
      clip-path 1.6s ease,
      filter 1.2s ease,
      transform 1.8s cubic-bezier(0.16, 0.78, 0.12, 1);
  }
  .finale-message {
    z-index: 4;
    max-width: 800px;
    border: 1px solid rgba(238, 218, 170, 0.35);
    background: rgba(5, 6, 7, 0.93);
    padding: clamp(24px, 5vw, 54px);
    text-align: center;
    box-shadow: 0 30px 100px #000;
  }
  .finale-message__lead {
    color: #b79a4c;
    font:
      900 0.72rem/1.5 ui-monospace,
      monospace;
    letter-spacing: 0.14em;
  }
  .finale-message h2 {
    margin: 10px 0 18px;
    font-size: clamp(1.5rem, 4vw, 3rem);
    text-wrap: balance;
  }
  .finale-message__generated {
    min-height: 4em;
    margin: 0;
    color: #f6edda;
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 2;
    white-space: pre-line;
  }
  .finale-hope {
    z-index: 6;
    display: grid;
    grid-template-columns: auto minmax(50px, 1fr) auto;
    align-items: center;
    gap: 14px;
    max-width: 820px;
    border: 1px solid #6a5d42;
    background: linear-gradient(
      180deg,
      rgba(8, 10, 10, 0.97),
      rgba(29, 55, 37, 0.97)
    );
    padding: clamp(28px, 6vw, 58px);
    text-align: center;
    box-shadow: 0 36px 120px rgba(0, 0, 0, 0.7);
  }
  .finale-hope > span {
    color: #ead47f;
    font:
      900 0.76rem/1 ui-monospace,
      monospace;
  }
  .finale-hope__line {
    height: 2px;
    background: linear-gradient(90deg, #6b5542, #f0d675, #78c66b);
  }
  .finale-hope > p {
    grid-column: 1 / -1;
    max-width: 680px;
    margin: 18px auto;
    color: #e7f1db;
  }
  .finale-hope__actions {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .finale-hope__actions button {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    gap: 8px;
    border: 2px solid #d8b847;
    border-radius: 5px;
    background: #e1bf4a;
    padding: 10px 15px;
    color: #201a12;
    font-weight: 900;
    cursor: pointer;
  }
  .finale-hope__actions button:last-child {
    border-color: #4c9d52;
    background: #78c66b;
  }

  [data-stage='drift'] .finale-ordinary-page {
    filter: sepia(0.18) contrast(1.08);
    transform: translate3d(var(--finale-shift-x), var(--finale-shift-y), 0)
      rotate(0.45deg) scale(1.015);
  }
  [data-stage='drift'] .finale-glitch {
    opacity: 0.2;
  }
  [data-stage='correction'] .finale-ordinary-page {
    filter: sepia(0.42) contrast(1.18) brightness(0.82);
    transform: translate3d(var(--finale-shift-x), var(--finale-shift-y), 0)
      rotate(-0.7deg) scale(1.04);
  }
  [data-stage='correction'] .finale-glitch,
  [data-stage='logs'] .finale-glitch,
  [data-stage='invasion'] .finale-glitch,
  [data-stage='reverse'] .finale-glitch,
  [data-stage='message'] .finale-glitch {
    opacity: 0.92;
    transform: translate3d(0, 0, 0) rotate(-0.5deg);
  }
  [data-stage='correction'] .finale-interference,
  [data-stage='logs'] .finale-interference,
  [data-stage='invasion'] .finale-interference,
  [data-stage='reverse'] .finale-interference,
  [data-stage='message'] .finale-interference {
    opacity: 0.72;
  }
  [data-stage='logs'] .finale-ordinary-page,
  [data-stage='invasion'] .finale-ordinary-page,
  [data-stage='reverse'] .finale-ordinary-page,
  [data-stage='message'] .finale-ordinary-page {
    opacity: 0.14;
    filter: sepia(0.7) contrast(1.3) brightness(0.54);
    transform: translate3d(var(--finale-shift-x), var(--finale-shift-y), 0)
      rotate(-1.2deg) scale(1.14);
  }
  [data-stage='logs'] .finale-logs {
    opacity: 1;
    transform: translateY(0);
  }
  [data-stage='invasion'] .finale-logs,
  [data-stage='reverse'] .finale-logs {
    opacity: 0.14;
    filter: blur(2px);
    transform: scale(1.14);
  }
  [data-stage='invasion'] .finale-paper-invasion,
  [data-stage='reverse'] .finale-paper-invasion,
  [data-stage='message'] .finale-paper-invasion {
    clip-path: polygon(0 18%, 34% 4%, 67% 16%, 100% 0, 100% 100%, 0 100%);
  }
  [data-stage='invasion'] .finale-shards :global(.finale-shard),
  [data-stage='reverse'] .finale-shards :global(.finale-shard),
  [data-stage='message'] .finale-shards :global(.finale-shard) {
    opacity: 0.82;
    transform: translate3d(0, 0, 0) rotate(var(--shard-rotate)) scale(1);
  }
  [data-stage='invasion'] .finale-figure {
    opacity: 0.48;
    transform: translate3d(var(--finale-shift-x), var(--finale-shift-y), 0)
      scale(0.9);
  }
  [data-stage='reverse'] .finale-shards :global(.finale-shard) {
