---
import { announcements } from '../data/content'
import { externalLinkAttrs } from '../utils/links'
import Icon from './Icon.astro'
---

{
  announcements.length > 0 && (
    <aside class="announcement-stack" aria-label="お知らせ">
      {announcements.map((announcement) => (
        <section
          class:list={[
            'announcement',
            `announcement--${announcement.tone ?? 'brand'}`,
          ]}
        >
          <div class="announcement-icon" aria-hidden="true">
            <Icon name={announcement.icon ?? 'megaphone'} />
          </div>
          <div class="announcement-copy">
            <p class="announcement-title">{announcement.title}</p>
            {announcement.text && <p>{announcement.text}</p>}
          </div>
          {announcement.href && announcement.linkLabel && (
            <a
              class="announcement-link"
              href={announcement.href}
              {...externalLinkAttrs(announcement.href, announcement.external)}
            >
              <span>{announcement.linkLabel}</span>
              <Icon name="chevron-right" />
            </a>
          )}
        </section>
      ))}
    </aside>
  )
}

<style>
  .announcement-stack {
    display: grid;
    gap: 1px;
    background: #1f1710;
  }

  .announcement {
    display: grid;
    align-items: center;
    gap: 12px;
    grid-template-columns: auto minmax(0, 1fr) auto;
    border-bottom: 2px solid rgba(21, 19, 15, 0.2);
    color: #15130f;
    padding: 12px clamp(16px, 4vw, 48px);
  }

  .announcement--brand {
    background: linear-gradient(90deg, #dff7ff, #fff5dc);
  }

  .announcement--amber {
    background: linear-gradient(90deg, #fff0b8, #fff8e6);
  }

  .announcement--emerald {
    background: linear-gradient(90deg, #ddfacb, #f7ffe9);
  }

  .announcement--slate {
    background: linear-gradient(90deg, #f4efe2, #fffaf0);
  }

  .announcement-icon {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 2px solid rgba(21, 19, 15, 0.24);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.5);
    font-size: 1.25rem;
  }

  .announcement-copy {
    min-width: 0;
  }

  .announcement p {
    margin: 0;
    font-size: 0.93rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .announcement-title {
    font-size: 1rem;
    font-weight: 900;
  }

  .announcement-link {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border: 2px solid rgba(21, 19, 15, 0.28);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.55);
    color: inherit;
    font-size: 0.9rem;
    font-weight: 900;
    padding: 0 12px;
    text-decoration: none;
    white-space: nowrap;
  }

  .announcement-link:hover {
    background: rgba(255, 255, 255, 0.82);
  }

  @media (max-width: 720px) {
    .announcement {
      align-items: start;
      grid-template-columns: auto minmax(0, 1fr);
    }

    .announcement-link {
      grid-column: 2;
      justify-self: start;
      white-space: normal;
    }
  }
</style>
