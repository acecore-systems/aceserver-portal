---
import { getLocalizedNavigation, getLocalizedSettings } from '../i18n/content'
import { localizePath, type Locale } from '../i18n/config'
import { getUi } from '../i18n/translations'
import { ACECORE_ORGANIZATION } from '../data/organization'
import { externalLinkAttrs } from '../utils/links'
import { getSkinMakerUi } from '../data/skin-maker-ui'

interface Props {
  locale?: Locale
}

const { locale = 'ja' } = Astro.props
const navigation = getLocalizedNavigation(locale)
const settings = getLocalizedSettings(locale)
const ui = getUi(locale)
const acecoreHomeUrl = new URL(
  localizePath(locale, '/'),
  ACECORE_ORGANIZATION.url,
).toString()
---

<footer class="site-footer">
  <div class="footer-inner">
    <a class="footer-brand" href={localizePath(locale, '/')}>
      <img
        src={settings.logo}
        alt={settings.logoAlt}
        aria-hidden="true"
        width="36"
        height="36"
      />
      <span>{settings.shortTitle}</span>
    </a>
    <nav aria-label={ui.footerNavigation}>
      {
        navigation.map((item) => (
          <a href={item.href} {...externalLinkAttrs(item.href, item.external)}>
            {item.text}
          </a>
        ))
      }
    </nav>
    <div class="footer-meta">
      <a href={localizePath(locale, '/skin-maker/')}
        >{getSkinMakerUi(locale).title}</a
      >
      <a href={acecoreHomeUrl} {...externalLinkAttrs(acecoreHomeUrl, true)}>
        {ACECORE_ORGANIZATION.name} ({ACECORE_ORGANIZATION.legalName})
      </a>
      <span>© {new Date().getFullYear()} {ACECORE_ORGANIZATION.legalName}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 3px solid rgba(255, 216, 77, 0.62);
    background:
      linear-gradient(180deg, rgba(31, 24, 18, 0.98), rgba(15, 13, 10, 1)),
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.04) 0 1px,
        transparent 1px 24px
      );
    color: #fff7df;
    padding: 28px clamp(18px, 5vw, 56px);
  }

  .footer-inner {
    display: flex;
    max-width: 1180px;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin: 0 auto;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    font-weight: 900;
    text-decoration: none;
  }

  .footer-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    color: rgba(255, 247, 223, 0.82);
    font-size: 0.82rem;
    line-height: 1.45;
    text-align: right;
  }

  .footer-meta a {
    color: inherit;
    font-weight: 700;
    text-decoration: none;
  }

  .footer-meta a:hover {
    color: #ffd84d;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
  }

  nav a {
    color: #fff7df;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
  }

  nav a:hover {
    color: #ffd84d;
  }

  @media (max-width: 720px) {
    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
    }

    .footer-meta {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>
