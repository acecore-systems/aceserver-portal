---
import type { PortalPage } from '../types'
import { serializeCssUrl } from '../data/safe-json'
import youtubeAtomSnapshot from '../data/external/youtube-videos.json'
import { getLocalizedSettings } from '../i18n/content'
import {
  DATE_LOCALE_BY_LOCALE,
  localizePath,
  type Locale,
} from '../i18n/config'
import { getUi } from '../i18n/translations'
import { externalLinkAttrs } from '../utils/links'
import Icon from './Icon.astro'

interface Props {
  page: PortalPage
  locale?: Locale
}

const { page, locale = 'ja' } = Astro.props
const settings = getLocalizedSettings(locale)
const ui = getUi(locale)
const embed = page.sections.find((section) => section.type === 'iframe')

if (!embed || embed.type !== 'iframe') {
  throw new Error(`Embed page ${page.slug} is missing iframe data.`)
}

const isVideoPage = embed.variant === 'video'
const isMapPage = embed.variant === 'map'
const videoChannelUrl =
  embed.channelUrl ?? embed.externalUrl ?? 'https://www.youtube.com/@aceserver'
const videos = isVideoPage ? youtubeAtomSnapshot.videos : []
const fallbackImageCss = serializeCssUrl(
  embed.fallbackImage ?? '/uploads/legacy-world-map.png',
)
const mapWorlds = settings.worlds.flatMap((world) =>
  world.href ? [{ href: world.href, title: world.title }] : [],
)
const currentPageHref = localizePath(locale, `/${page.slug}/`)
const currentMapIndex = mapWorlds.findIndex(
  (world) => world.href === currentPageHref,
)
const previousMap =
  isMapPage && currentMapIndex >= 0
    ? mapWorlds[(currentMapIndex - 1 + mapWorlds.length) % mapWorlds.length]
    : undefined
const nextMap =
  isMapPage && currentMapIndex >= 0
    ? mapWorlds[(currentMapIndex + 1) % mapWorlds.length]
    : undefined
---

<section class="embed-page" data-variant={embed.variant}>
  <div class="embed-layout">
    <div class="embed-shell pixel-border">
      <div class="embed-toolbar">
        {
          previousMap ? (
            <a class="toolbar-button" href={previousMap.href}>
              <Icon name="chevron-left" />
              <span>{ui.previous}</span>
              <span class="toolbar-button__label">{previousMap.title}</span>
            </a>
          ) : (
            <a
              class="toolbar-button"
              href={localizePath(locale, '/world-map/')}
            >
              <Icon name="arrow-left" />
              <span>{ui.back}</span>
            </a>
          )
        }
        <h1>{embed.title ?? page.pageName}</h1>
        {
          nextMap ? (
            <a class="toolbar-button toolbar-button--next" href={nextMap.href}>
              <span>{ui.next}</span>
              <span class="toolbar-button__label">{nextMap.title}</span>
              <Icon name="chevron-right" />
            </a>
          ) : (
            <a
              class="toolbar-button toolbar-button--external"
              href={embed.externalUrl ?? embed.src}
              {...externalLinkAttrs(embed.externalUrl ?? embed.src, true)}
            >
              <span>{ui.openNewTab}</span>
              <Icon name="external-link" />
            </a>
          )
        }
      </div>
      <div class="embed-frame" style={`--fallback-image: ${fallbackImageCss}`}>
        <iframe
          src={embed.src}
          title={embed.title ?? page.pageName}
          loading="lazy"
          allow="fullscreen; picture-in-picture"></iframe>
      </div>
    </div>

    {
      isVideoPage && (
        <section class="video-gallery">
          <div class="video-gallery__header">
            <div>
              <p class="video-gallery__eyebrow">YouTube</p>
              <h2>{ui.latestVideos}</h2>
            </div>
            <a
              class="toolbar-button toolbar-button--external"
              href={videoChannelUrl}
              {...externalLinkAttrs(videoChannelUrl, true)}
            >
              <span>{ui.channel}</span>
              <Icon name="external-link" />
            </a>
          </div>
          <div class="video-grid">
            {videos.map((video) => (
              <a
                class="video-card"
                href={video.url}
                {...externalLinkAttrs(video.url, true)}
              >
                <span class="video-card__thumbnail">
                  <img
                    src={video.thumbnailUrl}
                    alt={ui.videoThumbnail.replace('{title}', video.title)}
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="video-card__play">▶</span>
                </span>
                <span class="video-card__body">
                  <span class="video-card__title">{video.title}</span>
                  {video.publishedAt && (
                    <span class="video-card__meta">
                      {new Intl.DateTimeFormat(DATE_LOCALE_BY_LOCALE[locale], {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                      }).format(new Date(video.publishedAt))}
                    </span>
                  )}
                </span>
              </a>
            ))}
          </div>
          <p class="video-gallery__status" hidden={videos.length > 0}>
            {ui.videoLoadError}
          </p>
        </section>
      )
    }
  </div>
</section>

<style>
  .embed-page {
    min-height: calc(100vh - 72px);
    background:
      linear-gradient(180deg, rgba(15, 18, 19, 0.94), rgba(12, 10, 8, 0.98)),
      url('/uploads/legacy-world-map.png') center / cover;
    padding: clamp(10px, 2vw, 22px);
  }

  .embed-layout {
    display: grid;
    gap: clamp(18px, 3vw, 28px);
  }

  .embed-shell {
    display: grid;
    min-height: calc(100vh - 112px);
    overflow: hidden;
    border-radius: 18px;
    background: #15110c;
  }

  .embed-toolbar {
    display: grid;
    min-height: 68px;
    align-items: center;
    gap: 12px;
    grid-template-columns: minmax(120px, 1fr) auto minmax(120px, 1fr);
    border-bottom: 3px solid rgba(255, 216, 77, 0.64);
    background: linear-gradient(
      180deg,
      rgba(48, 36, 24, 0.98),
      rgba(24, 19, 14, 0.98)
    );
    color: #fff5dc;
    padding: 10px clamp(10px, 2vw, 18px);
  }

  .embed-toolbar h1 {
    margin: 0;
    font-size: clamp(1.08rem, 2.2vw, 1.65rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1.2;
    text-align: center;
  }

  .toolbar-button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-self: start;
    gap: 8px;
    border: 2px solid rgba(255, 216, 77, 0.55);
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.2);
    color: #fff5dc;
    font-weight: 900;
    padding: 0 13px;
    text-decoration: none;
  }

  .toolbar-button__label {
    max-width: min(24vw, 180px);
    overflow: hidden;
    color: rgba(255, 245, 220, 0.72);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .toolbar-button:hover {
    background: rgba(255, 216, 77, 0.14);
    color: #ffd84d;
  }

  .toolbar-button--external,
  .toolbar-button--next {
    justify-self: end;
  }

  .embed-frame {
    position: relative;
    min-height: 60vh;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.28)),
      var(--fallback-image) center / cover;
  }

  .embed-frame iframe {
    display: block;
    width: 100%;
    height: 100%;
    min-height: calc(100vh - 180px);
    border: 0;
    background: transparent;
  }

  [data-variant='video'] .embed-shell {
    min-height: auto;
    max-width: 1180px;
    margin: 0 auto;
  }

  [data-variant='video'] .embed-frame {
    aspect-ratio: 16 / 9;
    min-height: auto;
  }

  [data-variant='video'] .embed-frame iframe {
    height: 100%;
    min-height: 0;
  }

  .video-gallery {
    width: min(1180px, 100%);
    margin: 0 auto;
    color: #fff5dc;
  }

  .video-gallery__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 14px;
  }

  .video-gallery__eyebrow,
  .video-gallery__header h2,
  .video-gallery__status {
    margin: 0;
  }

  .video-gallery__eyebrow {
    color: #ffd84d;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .video-gallery__header h2 {
    font-size: clamp(1.25rem, 2.4vw, 1.8rem);
    line-height: 1.25;
  }

  .video-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }

  .video-card {
    display: grid;
    overflow: hidden;
    border: 2px solid rgba(255, 216, 77, 0.4);
    border-radius: 8px;
    background: rgba(15, 12, 8, 0.88);
    color: #fff5dc;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      transform 160ms ease,
      background 160ms ease;
  }

  .video-card:hover {
    border-color: rgba(255, 216, 77, 0.8);
    background: rgba(42, 29, 18, 0.96);
    transform: translateY(-2px);
  }

  .video-card__thumbnail {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #050403;
  }

  .video-card__thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-card__play {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: grid;
    width: 38px;
    height: 28px;
    place-items: center;
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.78);
    color: #ffd84d;
    font-size: 0.78rem;
    line-height: 1;
  }

  .video-card__body {
    display: grid;
    gap: 8px;
    padding: 12px;
  }

  .video-card__title {
    display: -webkit-box;
    min-height: 3.2em;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    font-size: 0.94rem;
    font-weight: 900;
    line-height: 1.6;
  }

  .video-card__meta {
    color: rgba(255, 245, 220, 0.72);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .video-gallery__status {
    border: 2px solid rgba(255, 216, 77, 0.3);
    border-radius: 8px;
    background: rgba(15, 12, 8, 0.7);
    font-weight: 900;
    padding: 14px;
  }

  @media (max-width: 760px) {
    .embed-toolbar {
      grid-template-columns: 1fr;
    }
    .embed-toolbar h1,
    .toolbar-button,
    .toolbar-button--external {
      justify-self: stretch;
      text-align: left;
    }
    .toolbar-button {
      justify-content: center;
    }
    .toolbar-button__label {
      max-width: 100%;
    }

    .video-gallery__header {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
