---
import { getSkinMakerUi } from '../data/skin-maker-ui'
import { HTML_LANG_BY_LOCALE, localizePath, type Locale } from '../i18n/config'
import { getSkinMakerSeo } from '../data/skin-maker-seo'
import { serializeJsonForHtmlScript } from '../data/safe-json'
import { FACES } from '../lib/skin-maker'
import SkinMakerNav from './SkinMakerNav.astro'
import { getSkinStoreUi } from '../data/skin-store-ui'
import SkinPixelEditor from './SkinPixelEditor.astro'
import { getSkinEditorUi } from '../data/skin-editor-ui'
import { getSkinRemixUi } from '../data/skin-remix-ui'
import { getSkinUploadUi } from '../data/skin-upload-ui'
interface Props {
  locale: Locale
}
const { locale } = Astro.props
const c = getSkinMakerUi(locale)
const store = getSkinStoreUi(locale)
const edit = getSkinEditorUi(locale)
const remix = getSkinRemixUi(locale)
const upload = getSkinUploadUi(locale)
const seo = getSkinMakerSeo(locale)
const url = new URL(localizePath(locale, '/skin-maker/'), Astro.site).href
const appJsonLd = serializeJsonForHtmlScript({
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  '@id': `${url}#app`,
  url,
  name: c.title,
  description: seo.description,
  inLanguage: HTML_LANG_BY_LOCALE[locale],
  applicationCategory: 'DesignApplication',
  operatingSystem: 'Web',
  browserRequirements: 'WebGL for 3D preview',
  featureList: ['Minecraft Classic / Slim', '64×64 PNG', '3D'],
  isPartOf: { '@id': `${url}#webpage` },
})
---

<script type="application/ld+json" set:html={appJsonLd} />

<section class="skin-maker" data-skin-maker data-locale={locale}>
  <header class="maker-heading">
    <span class="eyebrow">MINECRAFT · 64 × 64</span>
    <h1>{c.title}</h1>
    <p>{c.intro}</p>
  </header>
  <SkinMakerNav locale={locale} current="maker" />
  <section class="upload" aria-labelledby="skin-upload-title">
    <h2 id="skin-upload-title">{upload.title}</h2>
    <p class="hint" id="skin-upload-hint">{upload.hint}</p>
    <fieldset class="upload-controls" data-upload-inputs>
      <label class="field">
        {c.model}
        <select data-upload-model>
          <option value="classic">Classic · 4px</option>
          <option value="slim">Slim · 3px</option>
        </select>
      </label>
      <label class="field">
        {upload.file}
        <input
          data-skin-upload
          type="file"
          accept="image/png,.png"
          aria-describedby="skin-upload-hint skin-upload-privacy"
        />
      </label>
    </fieldset>
    <p class="hint" id="skin-upload-privacy">{upload.privacy}</p>
    <p class="hint" data-upload-status role="status" aria-live="polite"></p>
  </section>
  <div class="maker-grid">
    <form class="editor" data-form>
      <fieldset data-inputs>
        <label class="field"
          >{c.model}
          <select name="model"
            ><option value="classic">Classic · 4px</option><option value="slim"
              >Slim · 3px</option
            ></select
          >
        </label>
        <label class="field"
          >{c.reference}<input
            name="reference"
            type="file"
            accept="image/png,image/jpeg,image/webp"
          /></label
        >
        <div class="reference" data-reference hidden>
          <img data-reference-image alt={c.reference} width="96" height="96" />
          <button type="button" data-remove>{c.remove}</button>
        </div>
        <label class="field"
          >{c.prompt}<textarea name="prompt" rows="4" maxlength="1200" required
          ></textarea></label
        >
        <label class="consent"
          ><input type="checkbox" name="consent" required />
          <span>{c.consent}</span></label
        >
        <div data-turnstile></div>
      </fieldset>
      <button class="primary" data-generate type="submit" disabled>
        <span
          class="loading-spinner"
          data-button-spinner
          hidden
          aria-hidden="true"></span>
        <span data-generate-label>{c.generate}</span>
      </button>
      <p data-status role="status" aria-live="polite">{c.disabled}</p>
      <p class="elapsed" data-elapsed-row hidden>
        {c.elapsed}
        <span data-elapsed role="timer" aria-live="off">0:00</span>
      </p>
    </form>
    <section class="result" aria-label={c.preview}>
      <div class="preview-heading">
        <h2>{c.preview}</h2><span>PNG · 64 × 64</span>
      </div>
      <div class="stage" data-stage>
        <canvas data-viewer aria-label={c.preview}></canvas>
        <p class="empty" data-empty>{c.empty}</p>
        <div class="loading" data-loading hidden>
          <div class="loading-pixels" aria-hidden="true">
            {
              Array.from({ length: 9 }, (_, i) => (
                <span style={`--pixel: ${i}`} />
              ))
            }
          </div>
          <strong data-loading-title>{c.generating}</strong>
          <p data-loading-message>{c.busy}</p>
          <p class="elapsed">
            {c.elapsed}
            <span data-elapsed role="timer" aria-live="off">0:00</span>
          </p>
        </div>
      </div>
      <p data-webgl hidden>{c.webgl}</p>
      <div class="view-controls">
        {
          [3, 5, 2, 4].map((i) => (
            <button type="button" data-angle={FACES[i]}>
              {c.faceNames[i]}
            </button>
          ))
        }
        <label><input type="checkbox" data-rotate />{c.rotate}</label>
        <label
          ><input type="checkbox" data-outer checked />{c.layerNames[1]}</label
        >
      </div>
      <div class="atlas-row">
        <canvas data-atlas width="64" height="64" aria-label="64×64 PNG"
        ></canvas>
        <div class="export-controls">
          <a
            class="primary"
            data-download
            aria-disabled="true"
            download="minecraft-classic.png">{c.download}</a
          >
          <button type="button" data-clear>{c.clear}</button>
          <a
            class="editor-link"
            href="#skin-editor-title"
            data-open-editor
            hidden>{edit.open}</a
          >
        </div>
      </div>
      <p class="hint">{c.note}</p>
    </section>
  </div>
  <section
    class="remix-context"
    data-remix
    hidden
    aria-labelledby="skin-copy-title"
  >
    <h2 id="skin-copy-title" tabindex="-1">{remix.title}</h2>
    <p data-remix-source hidden>
      <strong>{remix.source}:</strong>
      <span data-remix-name></span>
    </p>
    <p data-remix-status role="status" aria-live="polite">{remix.loading}</p>
    <button type="button" data-remix-retry hidden>{store.retry}</button>
    <a href={localizePath(locale, '/skin-maker/store/')}>{store.store} →</a>
  </section>
  <SkinPixelEditor locale={locale} />
  <section class="publication" data-publication hidden aria-label={store.title}>
    <h2>{store.title}</h2>
    <form class="publish-form" data-publish-form hidden>
      <label class="field"
        >{store.name}<input name="skin-name" maxlength="40" required /></label
      >
      <label class="consent"
        ><input type="checkbox" name="public-consent" required /><span
          >{store.consent}</span
        ></label
      >
      <p class="hint" data-publish-hint>{store.hint}</p>
      <button class="primary" type="submit" data-publish>{store.publish}</button
      >
    </form>
    <p class="hint" data-publish-status role="status" aria-live="polite"></p>
    <div class="publication-actions">
      <a
        data-published-link
        hidden
        href={localizePath(locale, '/skin-maker/store/')}>{store.store} →</a
      >
      <button type="button" data-unpublish hidden>{store.remove}</button>
    </div>
  </section>
  <aside class="privacy">
    <p>{edit.privacy}</p>
    <p>{c.privacy}</p><a
      href="https://developers.cloudflare.com/workers-ai/platform/data-usage/"
      target="_blank"
      rel="noopener noreferrer">Cloudflare · Workers AI</a
    >
  </aside>
</section>

<script>
  import { initSkinMaker } from '../scripts/skin-maker'
  document
    .querySelectorAll<HTMLElement>('[data-skin-maker]')
    .forEach(initSkinMaker)
</script>

<style>
  .skin-maker {
    max-width: 1180px;
    margin: 0 auto;
    padding: 44px 22px 56px;
    color: #302619;
  }
  .maker-heading {
    max-width: 780px;
    margin-bottom: 30px;
  }
  .eyebrow {
    color: #846125;
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    font-weight: 800;
  }
  h1 {
    font-size: clamp(2.1rem, 5vw, 3.5rem);
    font-weight: 900;
    margin: 8px 0;
    line-height: 1.2;
  }
  h2 {
    font-size: 1.15rem;
    font-weight: 800;
    margin: 0;
  }
  .maker-heading p {
    line-height: 1.8;
    color: #66553f;
  }
  .upload {
    background: #fffdf5;
    border: 1px solid #dbcdb1;
    border-radius: 18px;
    padding: 24px;
    margin-bottom: 24px;
  }
  .upload-controls {
    display: grid;
    grid-template-columns: minmax(140px, 180px) minmax(0, 1fr);
    gap: 18px;
  }
  .upload .field {
    margin-top: 0;
  }
  .upload [data-upload-status]:empty {
    display: none;
  }
  .maker-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }
  .editor,
  .result {
    min-width: 0;
    background: #fffdf5;
    border: 1px solid #dbcdb1;
    border-radius: 18px;
    padding: 24px;
    box-shadow: 0 5px 0 #e4d7b9;
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  fieldset:disabled {
    opacity: 0.65;
  }
  .view-controls label {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 18px;
    font-size: 0.88rem;
    font-weight: 700;
  }
  input[type='file'],
  input[name='skin-name'],
  textarea,
  select {
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    border: 1px solid #c9b994;
    border-radius: 8px;
    padding: 10px;
    background: #fff;
    color: #302619;
    font: inherit;
  }
  input[type='file'] {
    font-size: 0.8rem;
  }
  input[type='checkbox'],
  input[type='radio'] {
    accent-color: #7b5422;
    width: 17px;
    height: 17px;
    flex-shrink: 0;
  }
  textarea {
    resize: vertical;
    min-height: 110px;
  }
  details {
    margin-top: 18px;
    font-size: 0.85rem;
  }
  summary {
    cursor: pointer;
    font-weight: 700;
    padding: 8px 0;
  }
  details fieldset {
    margin: 10px 0;
  }
  legend {
    font-weight: 700;
    margin-bottom: 7px;
  }
  button,
  .primary,
  .editor-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 14px;
    border: 1px solid #c6b28b;
    border-radius: 8px;
    color: #302619;
    background: #fff9e9;
    font-weight: 700;
    font-size: 0.85rem;
    text-decoration: none;
    cursor: pointer;
    min-height: 42px;
  }
  button:hover,
  .primary:hover,
  .editor-link:hover {
    background: #fbe6a8;
  }
  button:focus-visible,
  a:focus-visible,
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible,
  summary:focus-visible {
    outline: 3px solid #257f89;
    outline-offset: 3px;
  }
  .primary {
    background: #ffd84d;
    border-color: #ae861e;
    box-shadow: 0 3px 0 #c09a32;
  }
  button:disabled,
  [aria-disabled='true'] {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
  }
  [data-generate] {
    width: 100%;
    margin-top: 16px;
    gap: 10px;
  }
  [data-generate][data-loading] {
    opacity: 1;
  }
  .loading-spinner {
    width: 16px;
    height: 16px;
    border: 2px solid #ae861e;
    border-top-color: #302619;
    border-radius: 50%;
    animation: loading-spin 1s linear infinite;
  }
  .loading {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 24px;
    background: #f8f0da;
    text-align: center;
  }
  .loading strong {
    font-size: 1.2rem;
  }
  .loading p {
    margin: 0;
    max-width: 30ch;
    font-size: 0.85rem;
    line-height: 1.8;
    color: #66553f;
  }
  .loading-pixels {
    display: grid;
    grid-template-columns: repeat(3, 18px);
    gap: 5px;
    margin-bottom: 10px;
  }
  .loading-pixels span {
    width: 18px;
    height: 18px;
    background: #c79525;
    border-radius: 3px;
    animation: loading-pixel 1.8s ease-in-out infinite;
    animation-delay: calc(var(--pixel) * -0.15s);
  }
  .elapsed {
    color: #715e42;
    font-size: 0.8rem;
    margin: 8px 0 0;
    font-variant-numeric: tabular-nums;
  }
  @keyframes loading-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes loading-pixel {
    0%,
    100% {
      opacity: 0.35;
      transform: scale(0.8);
    }
    50% {
      opacity: 1;
      transform: scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .loading-spinner,
    .loading-pixels span {
      animation: none;
    }
  }
  .consent {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-top: 20px;
    font-size: 0.78rem;
    line-height: 1.6;
  }
  [data-status] {
    font-size: 0.85rem;
    line-height: 1.7;
    margin: 18px 0 0;
    overflow-wrap: anywhere;
  }
  .preview-heading {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    align-items: center;
  }
  .preview-heading span {
    font-size: 0.7rem;
    color: #83673f;
    white-space: nowrap;
  }
  .stage {
    position: relative;
    margin: 18px 0 14px;
    height: 380px;
    background:
      radial-gradient(ellipse at 50% 75%, #d3c5a0, transparent 50%),
      linear-gradient(#f8f0da, #ebe0c3);
    border-radius: 12px;
    overflow: hidden;
  }
  [data-viewer] {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
  }
  .empty {
    position: absolute;
    inset: 40% 25px auto;
    text-align: center;
    color: #776546;
    font-size: 0.9rem;
    pointer-events: none;
    line-height: 1.8;
  }
  .view-controls {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
  }
  .view-controls button {
    padding: 8px 12px;
  }
  .view-controls label {
    font-size: 0.8rem;
  }
  .atlas-row {
    display: flex;
    gap: 20px;
    align-items: center;
    margin: 22px 0;
  }
  .export-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .export-controls .primary {
    width: 100%;
  }
  [data-atlas] {
    width: 128px;
    height: 128px;
    image-rendering: pixelated;
    flex-shrink: 0;
    border: 1px solid #c9b994;
    background: repeating-conic-gradient(#eee7d7 0 25%, #fffdf5 0 50%) 0/16px
      16px;
  }
  .hint,
  .privacy {
    font-size: 0.78rem;
    line-height: 1.8;
    color: #715e42;
  }
  .privacy {
    margin-top: 28px;
    max-width: 850px;
  }
  .privacy a {
    text-decoration: underline;
  }
  .publication {
    margin-top: 28px;
    padding: 24px;
    background: #fffdf5;
    border: 1px solid #dbcdb1;
    border-radius: 18px;
    box-shadow: 0 5px 0 #e4d7b9;
  }
  .remix-context {
    margin-top: 28px;
    padding: 20px 24px;
    border: 1px solid #c9b994;
    border-radius: 14px;
    background: #fff4ce;
    scroll-margin-top: 140px;
  }
  .remix-context p {
    font-size: 0.85rem;
    line-height: 1.8;
    margin: 12px 0;
    overflow-wrap: anywhere;
  }
  .remix-context a {
    font-size: 0.85rem;
    text-decoration: underline;
    margin-left: 12px;
  }
  .publication h2 {
    font-size: 1.15rem;
    margin: 0;
  }
  .publish-form .primary {
    width: 100%;
  }
  .publication-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .publication-actions a {
    color: #715e42;
    text-decoration: underline;
    font-size: 0.85rem;
    font-weight: 800;
  }
  .reference {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 12px;
  }
  .reference img {
    object-fit: contain;
    border-radius: 8px;
  }
  [hidden] {
    display: none !important;
  }
  [data-webgl] {
    font-size: 0.85rem;
    color: #8b391c;
  }
  @media (max-width: 760px) {
    .skin-maker {
      padding: 26px 14px 40px;
    }
    .maker-grid {
      grid-template-columns: 1fr;
      gap: 22px;
    }
    .upload-controls {
      grid-template-columns: 1fr;
    }
    .upload,
    .editor,
    .result {
      padding: 18px;
    }
    .stage {
      height: 340px;
    }
    .atlas-row {
      gap: 14px;
    }
    [data-atlas] {
      width: 96px;
      height: 96px;
    }
    .preview-heading {
      flex-wrap: wrap;
    }
  }
</style>
