---
import type { CollectionEntry } from 'astro:content'
import {
  DATE_LOCALE_BY_LOCALE,
  localizePath,
  type Locale,
} from '../i18n/config'
import { getUi } from '../i18n/translations'

interface Props {
  locale: Locale
  stories: CollectionEntry<'stories'>[]
}

const { locale, stories } = Astro.props
const ui = getUi(locale)
const dateLocale = DATE_LOCALE_BY_LOCALE[locale]
const getStorySlug = (story: CollectionEntry<'stories'>) =>
  story.id.split('/').at(-1) ?? story.id
const getStoryPath = (story: CollectionEntry<'stories'>) =>
  localizePath(locale, `/stories/${getStorySlug(story)}/`)
---

<section class="stories-hero">
  <div class="stories-shell">
    <p>ACESERVER STORIES</p>
    <h1>{ui.storiesTitle}</h1>
    <p class="stories-lead">{ui.storiesLead}</p>
  </div>
</section>

<section class="stories-list stories-shell" aria-label={ui.storyListLabel}>
  {
    stories.map((story, index) => (
      <article>
        <a
          class={`story-thumbnail${story.data.image ? '' : ' story-thumbnail--placeholder'}`}
          href={getStoryPath(story)}
          aria-label={story.data.title}
        >
          {story.data.image ? (
            <img
              src={story.data.image}
              alt={story.data.imageAlt}
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          ) : (
            <span aria-hidden="true">ACESERVER STORY</span>
          )}
        </a>
        <div class="story-content">
          <p class="stories-date">
            <time datetime={story.data.date.toISOString()}>
              {story.data.date.toLocaleDateString(dateLocale, {
                timeZone: 'Asia/Tokyo',
              })}
            </time>
          </p>
          <h2>
            <a href={getStoryPath(story)}>{story.data.title}</a>
          </h2>
          <p>{story.data.description}</p>
          <ul aria-label={ui.tagsLabel}>
            {story.data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        </div>
      </article>
    ))
  }
</section>

<style>
  .stories-shell {
    width: min(1120px, calc(100% - 36px));
    margin-inline: auto;
  }

  .stories-hero {
    border-bottom: 8px solid #1e1710;
    background:
      linear-gradient(135deg, rgba(10, 167, 226, 0.92), rgba(53, 170, 47, 0.9)),
      #0aa7e2;
    color: white;
    padding-block: clamp(70px, 10vw, 130px);
  }

  .stories-hero p:first-child {
    margin: 0 0 12px;
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  .stories-hero h1 {
    margin: 0;
    font-size: clamp(3rem, 8vw, 6.8rem);
    line-height: 1;
  }

  .stories-lead {
    max-width: 680px;
    margin: 24px 0 0;
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 700;
  }

  .stories-list {
    display: grid;
    gap: 0;
    padding-block: clamp(54px, 8vw, 96px);
  }

  .stories-list article {
    display: grid;
    grid-template-columns: minmax(210px, 0.42fr) minmax(0, 0.58fr);
    align-items: start;
    gap: clamp(18px, 3vw, 40px);
    border-top: 2px solid rgba(21, 19, 15, 0.24);
    padding-block: clamp(28px, 5vw, 48px);
  }

  .stories-list article:last-child {
    border-bottom: 2px solid rgba(21, 19, 15, 0.24);
  }

  .stories-date {
    margin: 0;
    color: #514331;
    font-weight: 900;
  }

  .story-thumbnail {
    display: grid;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    place-items: center;
    border: 3px solid #1e1710;
    border-radius: 10px;
    background: #1e1710;
    box-shadow: 0 5px 0 rgba(21, 19, 15, 0.22);
  }

  .story-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 180ms ease;
  }

  .story-thumbnail:hover img {
    transform: scale(1.035);
  }

  .story-thumbnail:focus-visible {
    outline: 4px solid #0862c4;
    outline-offset: 4px;
  }

  .story-thumbnail--placeholder {
    background:
      linear-gradient(
        135deg,
        rgba(10, 167, 226, 0.94),
        rgba(53, 170, 47, 0.92)
      ),
      #0aa7e2;
    color: white;
    font-size: clamp(0.95rem, 2vw, 1.25rem);
    font-weight: 900;
    letter-spacing: 0.1em;
    text-align: center;
  }

  .story-content {
    display: grid;
    gap: 10px;
  }

  .stories-list h2,
  .story-content > p {
    margin: 0;
  }

  .stories-list h2 {
    font-size: clamp(1.45rem, 3vw, 2.35rem);
    line-height: 1.35;
  }

  .stories-list h2 a {
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }

  .stories-list ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .stories-list li {
    border: 1px solid rgba(21, 19, 15, 0.28);
    border-radius: 999px;
    padding: 3px 10px;
    font-size: 0.82rem;
    font-weight: 700;
  }

  @media (max-width: 680px) {
    .stories-list article {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .story-thumbnail {
      max-width: 540px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .story-thumbnail img {
      transition: none;
    }
  }
</style>
