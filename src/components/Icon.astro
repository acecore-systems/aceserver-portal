---
import lucideIcons from '@iconify-json/lucide/icons.json'

interface Props {
  name: string
  class?: string
  label?: string
}

type IconRecord = {
  body: string
  width?: number
  height?: number
}

const { name, class: className = '', label } = Astro.props
const icons = lucideIcons.icons as Record<string, IconRecord>
const icon = icons[name] ?? icons.square
const width = icon?.width ?? lucideIcons.width ?? 24
const height = icon?.height ?? lucideIcons.height ?? 24
---

<svg
  class:list={['asv-icon', className]}
  viewBox={`0 0 ${width} ${height}`}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <Fragment set:html={icon?.body ?? ''} />
</svg>

<style>
  .asv-icon {
    display: inline-block;
    width: 1em;
    height: 1em;
    flex: none;
    vertical-align: -0.125em;
  }
</style>
