---
import type { LinkItem, PortalPage, PortalSection } from '../types'
import { serializeCssUrl } from '../data/safe-json'
import { localizePath, type Locale } from '../i18n/config'
import { getUi } from '../i18n/translations'
import { externalLinkAttrs } from '../utils/links'
import Icon from './Icon.astro'

interface Props {
  page: PortalPage
  locale?: Locale
}

const { page, locale = 'ja' } = Astro.props
const ui = getUi(locale)
const sections = page.sections ?? []

type FeatureSection = Extract<
  PortalSection,
  { type: 'featureImageFull' | 'featureImageRight' | 'featureImageLeft' }
>
type CtaSection = Extract<PortalSection, { type: 'cta' }>
type HeroSection = Extract<PortalSection, { type: 'hero' }>

const fallbackJoinButton: LinkItem = {
  label: ui.joinDiscord,
  href: 'https://discord.gg/acsv',
  external: true,
}
const fallbackWikiButton: LinkItem = {
  label: ui.openWiki,
  href: 'https://asv-wiki.acecore.net',
  external: true,
}
const fallbackOverview: FeatureSection = {
  type: 'featureImageFull',
  titleCopy: 'エースサーバーとは',
  text: '誰でも参加可能なマインクラフト無料公開サーバーです',
  image: '/uploads/legacy-scc.png',
  imageAlt: 'エースサーバーの街区スクリーンショット',
}
const fallbackMultiplayer: FeatureSection = {
  type: 'featureImageRight',
  titleCopy: '誰とでもマルチプレイ！',
  text: 'JAVA版・統合版どちらでも遊ぶことが可能です！',
  image: '/uploads/legacy-multiplayer.jpg',
  imageAlt: 'マルチプレイ紹介用の写真',
}
const fallbackFreePlay: FeatureSection = {
  type: 'featureImageLeft',
  titleCopy: '楽しい！',
  text: 'バニラに近い、限りなく自由なサーバーです！',
  image: '/uploads/legacy-free-play.jpg',
  imageAlt: '自由な遊び方を示す写真',
}
const fallbackJoinCta: CtaSection = {
  type: 'cta',
  titleCopy: 'エースサーバーに参加したいですか？',
  text: 'まずは公式ディスコードにご参加ください！',
  ctaButton: fallbackJoinButton,
}
const fallbackWikiCta: HeroSection = {
  type: 'hero',
  shoulderCopy: 'aceserver wiki',
  titleCopy: 'エースサーバーWIKI',
  text: '誰でも編集可能なエースサーバーのWIKIページ',
  backgroundImage: '/uploads/legacy-wiki-bg.png',
  ctaButton: fallbackWikiButton,
}

function isFeatureSection(
  section: PortalSection | undefined,
): section is FeatureSection {
  return Boolean(
    section &&
    (section.type === 'featureImageFull' ||
      section.type === 'featureImageRight' ||
      section.type === 'featureImageLeft'),
  )
}

function getFeatureSection(
  type: FeatureSection['type'],
  fallback: FeatureSection,
): FeatureSection {
  return (
    sections.find(
      (section): section is FeatureSection =>
        isFeatureSection(section) && section.type === type,
    ) ?? fallback
  )
}

function getSection<T extends PortalSection['type']>(
  type: T,
): Extract<PortalSection, { type: T }> | undefined {
  return sections.find(
    (section): section is Extract<PortalSection, { type: T }> =>
      section.type === type,
  )
}

const overview = getFeatureSection('featureImageFull', fallbackOverview)
const multiplayer = getFeatureSection('featureImageRight', fallbackMultiplayer)
const freePlay = getFeatureSection('featureImageLeft', fallbackFreePlay)
const joinCta = getSection('cta') ?? fallbackJoinCta
const wikiCta = getSection('hero') ?? fallbackWikiCta
const heroImage = overview.image ?? '/uploads/legacy-scc.png'
const wikiBackgroundImage =
  wikiCta.backgroundImage ?? '/uploads/legacy-wiki-bg.png'
const wikiBackgroundImageCss = serializeCssUrl(wikiBackgroundImage)
const heroJoinButton = joinCta.ctaButton ?? fallbackJoinButton
const heroWikiButton = wikiCta.ctaButton ?? fallbackWikiButton
const alphaLogo = '/uploads/alpha-kun.png'
const multiplayerGuidePath = localizePath(
  locale,
  '/stories/minecraft-play-with-friends/',
)
---

<section class="hero" aria-labelledby="home-title">
  <img
    class="hero-bg"
    src={heroImage}
    alt={overview.imageAlt}
    aria-hidden="true"
  />
  <div class="hero-shade"></div>
  <div class="hero-content">
    <h1 id="home-title">
      {ui.homeTitleParts.map((part) => <span>{part}</span>)}
    </h1>
    <p>{page.meta.description}</p>
    <div class="hero-actions">
      <a
        class="asv-btn-blue"
        href={heroJoinButton.href}
        {...externalLinkAttrs(heroJoinButton.href, heroJoinButton.external)}
      >
        <Icon name="message-circle" />
        <span>{heroJoinButton.label}</span>
      </a>
      <a
        class="asv-btn-green"
        href={heroWikiButton.href}
        {...externalLinkAttrs(heroWikiButton.href, heroWikiButton.external)}
      >
        <Icon name="book-open" />
        <span>{heroWikiButton.label}</span>
      </a>
      <a class="asv-btn-alpha" href="#alpha-guide" data-alpha-open>
        <img
          class="hero-alpha-icon"
          src={alphaLogo}
          alt={ui.alphaImageAlt}
          aria-hidden="true"
          width="28"
          height="28"
        />
        <span>{ui.askAlpha}</span>
      </a>
    </div>
  </div>
  <a class="scroll-cue" href="#overview" aria-label={ui.nextSection}
    ><Icon name="chevron-right" /></a
  >
</section>

<section id="overview" class="intro-section">
  <div class="floating-island">
    {overview.image && <img src={overview.image} alt={overview.imageAlt} />}
  </div>
  <div class="intro-copy asv-panel pixel-border">
    <h2>{overview.titleCopy}</h2>
    {overview.text && <p>{overview.text}</p>}
    <p>{ui.homeFreedom}</p>
  </div>
</section>

<section class="feature-band feature-band--right">
  <div class="feature-copy">
    <h2>{multiplayer.titleCopy}</h2>
    {multiplayer.text && <p>{multiplayer.text}</p>}
    <p>{ui.homeMultiplayer}</p>
  </div>
  <div class="feature-image pixel-border">
    {
      multiplayer.image && (
        <img src={multiplayer.image} alt={multiplayer.imageAlt} />
      )
    }
  </div>
</section>

<section class="crossplay-band">
  <div class="device-scene pixel-border">
    <div class="device device--desktop"><Icon name="gamepad-2" /></div>
    <Icon name="chevron-right" class="device-arrow" />
    <div class="device device--mobile"><Icon name="globe-2" /></div>
  </div>
  <div class="crossplay-copy">
    <h2>{ui.homeCrossplay}</h2>
    <a class="crossplay-guide" href={multiplayerGuidePath}>
      {ui.homeMultiplayerGuide}
      <Icon name="chevron-right" />
    </a>
  </div>
</section>

<section class="feature-band feature-band--left">
  <div class="feature-copy">
    <h2>{freePlay.titleCopy}</h2>
    {freePlay.text && <p>{freePlay.text}</p>}
  </div>
  <div class="feature-image pixel-border">
    {freePlay.image && <img src={freePlay.image} alt={freePlay.imageAlt} />}
  </div>
</section>

<section class="cta-grid" aria-label={ui.homeCtaLabel}>
  <article class="join-card pixel-border">
    <div class="cube-icon"><Icon name="message-circle" /></div>
    <div>
      <h2>{joinCta.titleCopy}</h2>
      {joinCta.text && <p>{joinCta.text}</p>}
      <a
        class="asv-btn-primary"
        href={heroJoinButton.href}
        {...externalLinkAttrs(heroJoinButton.href, heroJoinButton.external)}
      >
        <span>{heroJoinButton.label}</span>
        <Icon name="chevron-right" />
      </a>
    </div>
  </article>
  <article
    class="wiki-card pixel-border"
    style={`--wiki-image: ${wikiBackgroundImageCss}`}
  >
    <div>
      <h2>{wikiCta.titleCopy}</h2>
      {wikiCta.text && <p>{wikiCta.text}</p>}
      <a
        class="asv-btn-green"
        href={heroWikiButton.href}
        {...externalLinkAttrs(heroWikiButton.href, heroWikiButton.external)}
      >
        <Icon name="book-open" />
        <span>{heroWikiButton.label}</span>
      </a>
    </div>
    <Icon name="book-open" class="wiki-mark" />
  </article>
  <article class="shop-card pixel-border">
    <div>
      <h2>{ui.homeShopTitle}</h2>
      <p>{ui.homeShopText}</p>
      <a
        class="asv-btn-shop"
        href="https://store.acecore.net/"
        {...externalLinkAttrs('https://store.acecore.net/', true)}
      >
        <Icon name="shopping-bag" />
        <span>{ui.openShop}</span>
      </a>
    </div>
    <Icon name="shopping-bag" class="shop-mark" />
  </article>
</section>

<style>
  .hero {
    position: relative;
    min-height: clamp(620px, 88vh, 880px);
    isolation: isolate;
    overflow: hidden;
    border-bottom: 12px solid #1e1710;
    background: #6bd7ff;
  }

  .hero-bg,
  .hero-shade {
    position: absolute;
    inset: 0;
  }

  .hero-bg {
    z-index: -3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-shade {
    z-index: -2;
    background:
      linear-gradient(
        90deg,
        rgba(14, 11, 8, 0.72),
        rgba(14, 11, 8, 0.22) 48%,
        rgba(14, 11, 8, 0.06)
      ),
      linear-gradient(180deg, rgba(0, 0, 0, 0) 70%, rgba(21, 19, 15, 0.62));
  }

  .hero::after {
    position: absolute;
    inset: auto 0 0;
    z-index: -1;
    height: 120px;
    background: linear-gradient(
      90deg,
      rgba(255, 216, 77, 0.85),
      rgba(53, 170, 47, 0.88)
    );
    clip-path: polygon(
      0 58%,
      7% 58%,
      7% 50%,
      15% 50%,
      15% 62%,
      26% 62%,
      26% 46%,
      36% 46%,
      36% 58%,
      47% 58%,
      47% 50%,
      56% 50%,
      56% 62%,
      67% 62%,
      67% 46%,
      78% 46%,
      78% 58%,
      88% 58%,
      88% 50%,
      100% 50%,
      100% 100%,
      0 100%
    );
    content: '';
  }

  .hero-content {
    display: grid;
    max-width: min(94vw, 1060px);
    gap: 24px;
    padding: clamp(94px, 14vh, 150px) clamp(18px, 7vw, 96px) 120px;
    color: white;
    text-shadow:
      0 5px 0 rgba(0, 0, 0, 0.32),
      0 18px 46px rgba(0, 0, 0, 0.34);
  }

  .hero h1 {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    font-size: clamp(4rem, 8vw, 7.4rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 0.96;
    word-break: keep-all;
  }

  .hero h1 span {
    display: inline-block;
  }

  .hero p {
    max-width: 680px;
    margin: 0;
    font-size: clamp(1.12rem, 2vw, 1.55rem);
    font-weight: 900;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .asv-btn-alpha {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: 2px solid #1b24d8;
    border-radius: 8px;
    background: #ffd84d;
    color: #15130f;
    font-size: 0.875rem;
    font-weight: 900;
    line-height: 1.2;
    padding: 0.75rem 1.25rem;
    text-decoration: none;
    text-shadow: none;
    box-shadow: 0 4px 0 rgba(0, 0, 0, 0.35);
    transition:
      background-color 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .asv-btn-alpha:hover,
  .asv-btn-alpha:focus-visible {
    background: #fff06f;
    transform: translateY(-1px);
  }

  .asv-btn-alpha:active {
    transform: translateY(1px);
    box-shadow: 0 2px 0 rgba(0, 0, 0, 0.35);
  }

  .hero-alpha-icon {
    width: 28px;
    height: 28px;
    object-fit: contain;
    filter: drop-shadow(0 2px 0 rgba(0, 0, 0, 0.16));
  }

  .scroll-cue {
    position: absolute;
    bottom: 36px;
    left: 50%;
    display: grid;
    width: 58px;
    height: 58px;
    place-items: center;
    border: 2px solid rgba(255, 255, 255, 0.78);
    border-radius: 12px;
    background: rgba(53, 170, 47, 0.88);
    color: white;
    font-size: 1.5rem;
    text-decoration: none;
    transform: translateX(-50%) rotate(90deg);
  }

  .intro-section,
  .feature-band,
  .crossplay-band,
  .cta-grid {
    position: relative;
    padding: clamp(58px, 8vw, 108px) clamp(18px, 6vw, 86px);
  }

  .intro-section {
    display: grid;
    align-items: center;
    gap: clamp(28px, 6vw, 84px);
    grid-template-columns: minmax(220px, 0.92fr) minmax(280px, 1fr);
    background: linear-gradient(
      180deg,
      rgba(255, 245, 220, 0.96),
      rgba(255, 250, 237, 0.98)
    );
  }

  .floating-island img {
    width: min(100%, 560px);
    margin: 0 auto;
    filter: drop-shadow(0 20px 20px rgba(75, 47, 20, 0.24));
  }

  .intro-copy {
    padding: clamp(24px, 4vw, 46px);
  }

  .intro-copy h2,
  .feature-copy h2,
  .crossplay-band h2,
  .cta-grid h2 {
    margin: 0 0 18px;
    font-size: clamp(2rem, 4vw, 4rem);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1.1;
  }

  .intro-copy p,
  .feature-copy p,
  .cta-grid p {
    margin: 0 0 10px;
    font-size: clamp(1.02rem, 1.5vw, 1.28rem);
    font-weight: 800;
  }

  .feature-band {
    display: grid;
    align-items: center;
    gap: clamp(28px, 5vw, 70px);
    grid-template-columns: minmax(260px, 0.72fr) minmax(320px, 1.28fr);
    background: #fff8e6;
  }

  .feature-band--left {
    background: #e9f8ff;
  }

  .feature-band--left .feature-copy {
    order: 2;
  }

  .feature-copy {
    max-width: 520px;
  }

  .feature-image {
    overflow: hidden;
    border-radius: 16px;
    background: #15130f;
  }

  .feature-image img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .crossplay-band {
    display: grid;
    align-items: center;
    gap: clamp(26px, 5vw, 72px);
    grid-template-columns: minmax(260px, 0.72fr) minmax(280px, 1fr);
    background: linear-gradient(135deg, #baeaff, #f6fbff 58%, #fff2bf);
  }

  .crossplay-copy {
    display: grid;
    justify-items: start;
    gap: 18px;
  }

  .crossplay-guide {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    gap: 8px;
    border: 2px solid #1e1710;
    border-radius: 8px;
    background: #ffd84d;
    color: #15130f;
    font-weight: 900;
    padding: 0.72rem 1rem;
    text-decoration: none;
    box-shadow: 0 4px 0 rgba(21, 19, 15, 0.28);
  }

  .crossplay-guide:hover,
  .crossplay-guide:focus-visible {
    background: #fff06f;
  }

  .crossplay-guide:focus-visible {
    outline: 4px solid #0862c4;
    outline-offset: 3px;
  }

  .device-scene {
    display: flex;
    min-height: 230px;
    align-items: center;
    justify-content: center;
    gap: 22px;
    border-radius: 18px;
    background: linear-gradient(
      135deg,
      rgba(28, 21, 15, 0.92),
      rgba(50, 38, 27, 0.92)
    );
    color: #ffd84d;
  }

  .device {
    display: grid;
    place-items: center;
    border: 4px solid #0b141d;
    border-radius: 10px;
    background: linear-gradient(180deg, #dff7ff, #63d5ff);
    color: #15130f;
    box-shadow: inset 0 -10px rgba(0, 0, 0, 0.12);
  }

  .device--desktop {
    width: 148px;
    height: 98px;
    font-size: 3rem;
  }

  .device--mobile {
    width: 74px;
    height: 132px;
    font-size: 2.2rem;
  }

  :global(.device-arrow) {
    font-size: 2rem;
  }

  .cta-grid {
    display: grid;
    gap: 24px;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    background: linear-gradient(
      180deg,
      rgba(28, 21, 15, 0.98),
      rgba(13, 17, 19, 1)
    );
    color: white;
  }

  .join-card,
  .wiki-card,
  .shop-card {
    display: grid;
    min-height: 320px;
    gap: 22px;
    overflow: hidden;
    padding: clamp(24px, 4vw, 44px);
  }

  .join-card {
    grid-template-columns: auto 1fr;
    background: linear-gradient(135deg, #0862c4, #0aa7e2);
  }

  .wiki-card {
    grid-template-columns: 1fr auto;
    background:
      linear-gradient(135deg, rgba(20, 89, 28, 0.9), rgba(25, 129, 39, 0.78)),
      var(--wiki-image) center / cover;
  }

  .shop-card {
    grid-column: 1 / -1;
    grid-template-columns: 1fr auto;
    background:
      linear-gradient(135deg, rgba(39, 30, 121, 0.96), rgba(18, 76, 154, 0.94)),
      #211f4c;
  }

  .asv-btn-shop {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 12px;
    border: 2px solid #1b24d8;
    border-radius: 8px;
    background: #ffd84d;
    color: #15130f;
    font-weight: 900;
    padding: 0.75rem 1.25rem;
    text-decoration: none;
    box-shadow: 0 4px 0 rgba(0, 0, 0, 0.35);
    transition:
      background-color 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .asv-btn-shop:hover,
  .asv-btn-shop:focus-visible {
    background: #fff06f;
    transform: translateY(-1px);
  }

  .asv-btn-shop:active {
    transform: translateY(1px);
    box-shadow: 0 2px 0 rgba(0, 0, 0, 0.35);
  }

  .cube-icon,
  :global(.wiki-mark),
  :global(.shop-mark) {
    display: grid;
    place-items: center;
    color: #fff8dd;
    filter: drop-shadow(0 8px 0 rgba(0, 0, 0, 0.2));
  }

  .cube-icon {
    width: 104px;
    height: 104px;
    border: 3px solid rgba(255, 255, 255, 0.62);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.16);
    font-size: 3rem;
  }

  :global(.wiki-mark) {
    align-self: end;
    font-size: clamp(4rem, 10vw, 8rem);
    opacity: 0.88;
  }

  :global(.shop-mark) {
    align-self: end;
    font-size: clamp(4rem, 10vw, 8rem);
    opacity: 0.88;
  }

  @media (max-width: 920px) {
    .intro-section,
    .feature-band,
    .crossplay-band,
    .cta-grid {
      grid-template-columns: 1fr;
    }

    .feature-band--left .feature-copy {
      order: 0;
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 700px;
    }

    .hero-content {
      padding-top: 90px;
    }

    .hero h1 {
      flex-direction: column;
      font-size: clamp(3.45rem, 16vw, 4.8rem);
    }

    .join-card,
    .wiki-card,
    .shop-card {
      grid-template-columns: 1fr;
    }
  }
</style>
