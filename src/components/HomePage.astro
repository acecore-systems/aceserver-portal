---
import type { LinkItem, PortalPage, PortalSection } from '../types'
import { getSkinMakerUi } from '../data/skin-maker-ui'
import { getAlphaDiaryUi } from '../data/alpha-diary-ui'
import { getCommunityUi } from '../data/community-ui'
import { serializeCssUrl } from '../data/safe-json'
import { localizePath, type Locale } from '../i18n/config'
import { getUi } from '../i18n/translations'
import { externalLinkAttrs } from '../utils/links'
import Icon from './Icon.astro'
import PageHero from './PageHero.astro'
import HomeCommunity from './HomeCommunity.astro'

interface Props {
  page: PortalPage
  locale?: Locale
}

const { page, locale = 'ja' } = Astro.props
const ui = getUi(locale)
const diaryUi = getAlphaDiaryUi(locale)
const skinUi = getSkinMakerUi(locale)
const sections = page.sections ?? []

type FeatureSection = Extract<
  PortalSection,
  { type: 'featureImageFull' | 'featureImageRight' | 'featureImageLeft' }
>
type CtaSection = Extract<PortalSection, { type: 'cta' }>
type HeroSection = Extract<PortalSection, { type: 'hero' }>

const fallbackJoinButton: LinkItem = {
  label: ui.joinDiscord,
  href: 'https://discord.gg/acsv',
  external: true,
}
const fallbackWikiButton: LinkItem = {
  label: ui.openWiki,
  href: 'https://asv-wiki.acecore.net',
  external: true,
}
const fallbackOverview: FeatureSection = {
  type: 'featureImageFull',
  titleCopy: 'エースサーバーとは',
  text: '誰でも参加可能なマインクラフト無料公開サーバーです',
  image: '/uploads/legacy-scc.png',
  imageAlt: 'エースサーバーの街区スクリーンショット',
}
const fallbackMultiplayer: FeatureSection = {
  type: 'featureImageRight',
  titleCopy: '誰とでもマルチプレイ！',
  text: 'JAVA版・統合版どちらでも遊ぶことが可能です！',
  image: '/uploads/legacy-multiplayer.jpg',
  imageAlt: 'マルチプレイ紹介用の写真',
}
const fallbackFreePlay: FeatureSection = {
  type: 'featureImageLeft',
  titleCopy: '楽しい！',
  text: 'バニラに近い、限りなく自由なサーバーです！',
  image: '/uploads/legacy-free-play.jpg',
  imageAlt: '自由な遊び方を示す写真',
}
const fallbackJoinCta: CtaSection = {
  type: 'cta',
  titleCopy: 'エースサーバーに参加したいですか？',
  text: 'まずは公式ディスコードにご参加ください！',
  ctaButton: fallbackJoinButton,
}
const fallbackWikiCta: HeroSection = {
  type: 'hero',
  shoulderCopy: 'aceserver wiki',
  titleCopy: 'エースサーバーWIKI',
  text: '参加方法やルールを確認できるエースサーバー公式WIKI',
  backgroundImage: '/uploads/legacy-wiki-bg.png',
  ctaButton: fallbackWikiButton,
}

function isFeatureSection(
  section: PortalSection | undefined,
): section is FeatureSection {
  return Boolean(
    section &&
    (section.type === 'featureImageFull' ||
      section.type === 'featureImageRight' ||
      section.type === 'featureImageLeft'),
  )
}

function getFeatureSection(
  type: FeatureSection['type'],
  fallback: FeatureSection,
): FeatureSection {
  return (
    sections.find(
      (section): section is FeatureSection =>
        isFeatureSection(section) && section.type === type,
    ) ?? fallback
  )
}

function getSection<T extends PortalSection['type']>(
  type: T,
): Extract<PortalSection, { type: T }> | undefined {
  return sections.find(
    (section): section is Extract<PortalSection, { type: T }> =>
      section.type === type,
  )
}

const overview = getFeatureSection('featureImageFull', fallbackOverview)
const multiplayer = getFeatureSection('featureImageRight', fallbackMultiplayer)
const freePlay = getFeatureSection('featureImageLeft', fallbackFreePlay)
const joinCta = getSection('cta') ?? fallbackJoinCta
const wikiCta = getSection('hero') ?? fallbackWikiCta
const heroImage = overview.image ?? '/uploads/legacy-scc.png'
const wikiBackgroundImage =
  wikiCta.backgroundImage ?? '/uploads/legacy-wiki-bg.png'
const wikiBackgroundImageCss = serializeCssUrl(wikiBackgroundImage)
const heroJoinButton = joinCta.ctaButton ?? fallbackJoinButton
const heroWikiButton = wikiCta.ctaButton ?? fallbackWikiButton
const alphaLogo = '/uploads/alpha-kun.png'
const multiplayerGuidePath = localizePath(
  locale,
  '/stories/minecraft-play-with-friends/',
)
const diaryPath = localizePath(locale, '/alpha-diary/')
---

<PageHero
  variant="home"
  eyebrow="ACESERVER PORTAL"
  title={ui.homeTitleParts.join('')}
  titleId="home-title"
  lead={page.meta.description}
  backgroundImage={heroImage}
  imageAlt={overview.imageAlt}
  imageCaption={getCommunityUi(locale).heroArchiveCaption}
  scrollCue={{ href: '#overview', label: ui.nextSection }}
>
  <Fragment slot="title">
    {ui.homeTitleParts.map((part) => <span>{part}</span>)}
  </Fragment>
  <Fragment slot="actions">
    <a
      class="asv-btn-blue"
      href={heroJoinButton.href}
      {...externalLinkAttrs(heroJoinButton.href, heroJoinButton.external)}
    >
      <Icon name="message-circle" />
      <span>{heroJoinButton.label}</span>
    </a>
    <a
      class="asv-btn-green"
      href={heroWikiButton.href}
      {...externalLinkAttrs(heroWikiButton.href, heroWikiButton.external)}
    >
      <Icon name="book-open" />
      <span>{heroWikiButton.label}</span>
    </a>
    <a class="asv-btn-alpha" href="#alpha-guide" data-alpha-open>
      <img
        class="hero-alpha-icon"
        src={alphaLogo}
        alt={ui.alphaImageAlt}
        aria-hidden="true"
        width="28"
        height="28"
      />
      <span>{ui.askAlpha}</span>
    </a>
    <a class="asv-btn-diary" href={diaryPath}>
      <Icon name="notebook-pen" />
      <span>{diaryUi.navLabel}</span>
    </a>
  </Fragment>
</PageHero>

{page.community && <HomeCommunity page={page} locale={locale} mode="status" />}

<section id="overview" class="intro-section intro-section--compact">
  <div class="intro-copy">
    <h2>{overview.titleCopy}</h2>
    {overview.text && <p>{overview.text}</p>}
    <p>{ui.homeFreedom}</p>
  </div>
  <div class="intro-copy intro-copy--details">
    <h3>{multiplayer.titleCopy}</h3>
    {multiplayer.text && <p>{multiplayer.text}</p>}
    <p>{freePlay.text}</p>
    <a class="crossplay-guide" href={multiplayerGuidePath}
      >{ui.homeMultiplayerGuide}<Icon name="chevron-right" /></a
    >
  </div>
</section>

{
  page.community && (
    <HomeCommunity page={page} locale={locale} mode="discover" />
  )
}

<section class="cta-grid" aria-label={ui.homeCtaLabel}>
  <article class="join-card pixel-border">
    <div class="cube-icon"><Icon name="message-circle" /></div>
    <div>
      <h2>{joinCta.titleCopy}</h2>
      {joinCta.text && <p>{joinCta.text}</p>}
      <a
        class="asv-btn-primary"
        href={heroJoinButton.href}
        {...externalLinkAttrs(heroJoinButton.href, heroJoinButton.external)}
      >
        <span>{heroJoinButton.label}</span>
        <Icon name="chevron-right" />
      </a>
    </div>
  </article>
  <article
    class="wiki-card pixel-border"
    style={`--wiki-image: ${wikiBackgroundImageCss}`}
  >
    <div>
      <h2>{wikiCta.titleCopy}</h2>
      {wikiCta.text && <p>{wikiCta.text}</p>}
      <a
        class="asv-btn-green"
        href={heroWikiButton.href}
        {...externalLinkAttrs(heroWikiButton.href, heroWikiButton.external)}
      >
        <Icon name="book-open" />
        <span>{heroWikiButton.label}</span>
      </a>
    </div>
    <Icon name="book-open" class="wiki-mark" />
  </article>
  <article class="diary-card pixel-border">
    <div>
      <h2>{diaryUi.title}</h2>
      <p>{diaryUi.eyebrow}</p>
      <a class="asv-btn-diary" href={diaryPath}>
        <Icon name="notebook-pen" />
        <span>{diaryUi.openDate}</span>
      </a>
    </div>
    <img
      class="diary-mark"
      src={alphaLogo}
      alt={ui.alphaImageAlt}
      width="168"
      height="168"
    />
  </article>
  <article class="join-card pixel-border">
    <div class="cube-icon"><Icon name="shirt" /></div>
    <div>
      <h2>{skinUi.title}</h2>
      <p>{skinUi.intro}</p>
      <a class="asv-btn-primary" href={localizePath(locale, '/skin-maker/')}>
        <span>{skinUi.title}</span><Icon name="chevron-right" />
      </a>
    </div>
  </article>
  <article class="shop-card pixel-border">
    <div>
      <h2>{ui.homeShopTitle}</h2>
      <p>{ui.homeShopText}</p>
      <a
        class="asv-btn-shop"
        href="https://store.acecore.net/"
        {...externalLinkAttrs('https://store.acecore.net/', true)}
      >
        <Icon name="shopping-bag" />
        <span>{ui.openShop}</span>
      </a>
    </div>
    <Icon name="shopping-bag" class="shop-mark" />
  </article>
</section>

<style>
  .asv-btn-alpha {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: 2px solid #1b24d8;
    border-radius: 8px;
    background: #ffd84d;
    color: #15130f;
    font-size: 0.875rem;
    font-weight: 900;
    line-height: 1.2;
    padding: 0.75rem 1.25rem;
    text-decoration: none;
    text-shadow: none;
    box-shadow: 0 4px 0 rgba(0, 0, 0, 0.35);
    transition:
      background-color 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .asv-btn-alpha:hover,
  .asv-btn-alpha:focus-visible {
    background: #fff06f;
    transform: translateY(-1px);
  }

  .asv-btn-alpha:active {
    transform: translateY(1px);
    box-shadow: 0 2px 0 rgba(0, 0, 0, 0.35);
  }

  .asv-btn-diary {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: 2px solid #6a4d2f;
    border-radius: 8px;
    background: #fff3bd;
    color: #211910;
    font-size: 0.875rem;
    font-weight: 900;
    line-height: 1.2;
    padding: 0.75rem 1.25rem;
    text-decoration: none;
    text-shadow: none;
    box-shadow: 0 4px 0 rgba(0, 0, 0, 0.3);
    transition:
      background-color 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .asv-btn-diary:hover,
  .asv-btn-diary:focus-visible {
    background: #fff9df;
    transform: translateY(-1px);
  }

  .asv-btn-diary:focus-visible {
    outline: 4px solid #0862c4;
    outline-offset: 3px;
  }

  .asv-btn-diary:active {
    transform: translateY(1px);
    box-shadow: 0 2px 0 rgba(0, 0, 0, 0.3);
  }

  .hero-alpha-icon {
    width: 28px;
    height: 28px;
    object-fit: contain;
    filter: drop-shadow(0 2px 0 rgba(0, 0, 0, 0.16));
  }

  .intro-section,
  .cta-grid {
    position: relative;
    padding: clamp(58px, 8vw, 108px) clamp(18px, 6vw, 86px);
  }

  .intro-section {
    display: grid;
    align-items: center;
    gap: clamp(28px, 6vw, 84px);
    grid-template-columns: minmax(220px, 0.92fr) minmax(280px, 1fr);
    background: linear-gradient(
      180deg,
      rgba(255, 245, 220, 0.96),
      rgba(255, 250, 237, 0.98)
    );
  }

  .intro-section--compact {
    padding-block: clamp(28px, 4vw, 50px);
  }
  .intro-copy h2 {
    margin: 0 0 12px;
    font-size: clamp(1.45rem, 2.6vw, 2rem);
    font-weight: 900;
  }
  .intro-copy h3 {
    margin: 0 0 8px;
    font-size: 1.1rem;
    font-weight: 900;
  }
  .intro-copy p {
    margin: 0 0 8px;
    font-size: 0.94rem;
    line-height: 1.7;
  }
  .intro-copy--details {
    border-left: 2px solid #d6cdb4;
    padding-left: 28px;
  }

  .crossplay-guide {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    gap: 8px;
    border: 2px solid #1e1710;
    border-radius: 8px;
    background: #ffd84d;
    color: #15130f;
    font-weight: 900;
    padding: 0.72rem 1rem;
    text-decoration: none;
    box-shadow: 0 4px 0 rgba(21, 19, 15, 0.28);
  }

  .crossplay-guide:hover,
  .crossplay-guide:focus-visible {
    background: #fff06f;
  }

  .crossplay-guide:focus-visible {
    outline: 4px solid #0862c4;
    outline-offset: 3px;
  }

  .cta-grid {
    display: grid;
    gap: 24px;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    background: linear-gradient(
      180deg,
      rgba(28, 21, 15, 0.98),
      rgba(13, 17, 19, 1)
    );
    color: white;
  }

  .cta-grid h2 {
    margin: 0 0 12px;
    font-size: clamp(1.3rem, 2vw, 1.8rem);
    font-weight: 900;
    line-height: 1.3;
  }

  .cta-grid p {
    margin: 0 0 10px;
    font-size: 0.94rem;
    line-height: 1.7;
  }

  .join-card,
  .wiki-card,
  .shop-card,
  .diary-card {
    display: grid;
    min-height: 230px;
    gap: 22px;
    overflow: hidden;
    padding: clamp(24px, 4vw, 44px);
  }

  .join-card {
    grid-template-columns: auto 1fr;
    background: linear-gradient(135deg, #0862c4, #0aa7e2);
  }

  .wiki-card {
    grid-template-columns: 1fr auto;
    background:
      linear-gradient(135deg, rgba(20, 89, 28, 0.9), rgba(25, 129, 39, 0.78)),
      var(--wiki-image) center / cover;
  }

  .shop-card {
    grid-template-columns: 1fr auto;
    background:
      linear-gradient(135deg, rgba(39, 30, 121, 0.96), rgba(18, 76, 154, 0.94)),
      #211f4c;
  }

  .diary-card {
    grid-template-columns: 1fr auto;
    background:
      linear-gradient(
        90deg,
        transparent 0 38px,
        rgba(205, 85, 75, 0.2) 38px 41px,
        transparent 41px
      ),
      repeating-linear-gradient(
        0deg,
        rgba(55, 150, 190, 0.18) 0 2px,
        transparent 2px 34px
      ),
      linear-gradient(135deg, #fffdf0, #dff7ff);
    color: #211910;
  }

  .diary-card p {
    color: #4b3a28;
  }

  .diary-card .asv-btn-diary {
    margin-top: 12px;
  }

  .diary-mark {
    width: clamp(112px, 14vw, 168px);
    height: auto;
    align-self: end;
    filter: drop-shadow(0 9px 0 rgba(73, 50, 21, 0.16));
  }

  .asv-btn-shop {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 12px;
    border: 2px solid #1b24d8;
    border-radius: 8px;
    background: #ffd84d;
    color: #15130f;
    font-weight: 900;
    padding: 0.75rem 1.25rem;
    text-decoration: none;
    box-shadow: 0 4px 0 rgba(0, 0, 0, 0.35);
    transition:
      background-color 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .asv-btn-shop:hover,
  .asv-btn-shop:focus-visible {
    background: #fff06f;
    transform: translateY(-1px);
  }

  .asv-btn-shop:active {
    transform: translateY(1px);
    box-shadow: 0 2px 0 rgba(0, 0, 0, 0.35);
  }

  .cube-icon,
  :global(.wiki-mark),
  :global(.shop-mark) {
    display: grid;
    place-items: center;
    color: #fff8dd;
    filter: drop-shadow(0 8px 0 rgba(0, 0, 0, 0.2));
  }

  .cube-icon {
    width: 104px;
    height: 104px;
    border: 3px solid rgba(255, 255, 255, 0.62);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.16);
    font-size: 3rem;
  }

  :global(.wiki-mark) {
    align-self: end;
    font-size: clamp(4rem, 10vw, 8rem);
    opacity: 0.88;
  }

  :global(.shop-mark) {
    align-self: end;
    font-size: clamp(4rem, 10vw, 8rem);
    opacity: 0.88;
  }

  @media (max-width: 920px) {
    .intro-section,
    .cta-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .intro-copy--details {
      border-left: 0;
      padding-left: 0;
    }
  }

  @media (max-width: 640px) {
    .join-card,
    .wiki-card,
    .shop-card,
    .diary-card {
      grid-template-columns: 1fr;
    }

    .diary-mark {
      justify-self: end;
    }

    .diary-card h2 {
      font-size: 1.65rem;
    }
  }
</style>
