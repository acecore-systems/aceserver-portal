---
import { TRANSLATED_LOCALES, type TranslatedLocale } from '../../i18n/config'
import { getUi } from '../../i18n/translations'
import BaseLayout from '../../layouts/BaseLayout.astro'
import NotFoundPage from '../../components/NotFoundPage.astro'

export function getStaticPaths() {
  return TRANSLATED_LOCALES.map((locale) => ({
    params: { locale },
    props: { locale },
  }))
}

interface Props {
  locale: TranslatedLocale
}

const { locale } = Astro.props
const ui = getUi(locale)
---

<BaseLayout
  locale={locale}
  title={ui.notFoundTitle}
  description={ui.notFoundDescription}
  robots="noindex, follow"
  canonical={null}
>
  <NotFoundPage locale={locale} />
</BaseLayout>
