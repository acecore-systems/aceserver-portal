---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import { serializeJsonForHtmlScript } from '../../data/safe-json'
import BaseLayout from '../../layouts/BaseLayout.astro'

export async function getStaticPaths() {
  const stories = await getCollection('stories')

  return stories.map((story) => ({
    params: { slug: story.id },
    props: { story },
  }))
}

interface Props {
  story: CollectionEntry<'stories'>
}

const { story } = Astro.props
const { Content } = await render(story)
const storyUrl = new URL(
  `/stories/${story.id}/`,
  Astro.site ?? 'https://asv.acecore.net',
)
const homeUrl = new URL('/', storyUrl)
const articleJsonLd = serializeJsonForHtmlScript({
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${storyUrl}#article`,
  url: storyUrl.toString(),
  headline: story.data.title,
  description: story.data.description,
  datePublished: story.data.date.toISOString(),
  inLanguage: 'ja',
  mainEntityOfPage: {
    '@id': `${storyUrl}#webpage`,
  },
  author: {
    '@type': 'Person',
    name: story.data.author,
  },
  publisher: {
    '@id': `${homeUrl}#organization`,
  },
})
---

<BaseLayout
  title={story.data.title}
  description={story.data.description}
  canonical={`/stories/${story.id}/`}
  ogType="article"
>
  <script type="application/ld+json" set:html={articleJsonLd} />
  <article class="story-shell">
    <header class="story-header">
      <p class="story-kicker">ACESERVER STORY</p>
      <h1>{story.data.title}</h1>
      <p class="story-description">{story.data.description}</p>
      <div class="story-meta">
        <time datetime={story.data.date.toISOString()}>
          {
            story.data.date.toLocaleDateString('ja-JP', {
              timeZone: 'Asia/Tokyo',
            })
          }
        </time>
        <span>文：{story.data.author}</span>
      </div>
    </header>
    <div class="story-body">
      <Content />
    </div>
    <footer class="story-footer">
      <a href="/stories/">読みもの一覧へ戻る</a>
      <a href="/">エースサーバーに参加する</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .story-shell {
    width: min(880px, calc(100% - 36px));
    margin-inline: auto;
    padding-block: clamp(56px, 8vw, 104px);
  }

  .story-header {
    border-bottom: 4px solid #1e1710;
    padding-bottom: clamp(30px, 5vw, 54px);
  }

  .story-kicker {
    margin: 0 0 16px;
    color: #0862c4;
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  .story-header h1 {
    margin: 0;
    font-size: clamp(2.3rem, 6vw, 4.9rem);
    letter-spacing: -0.03em;
    line-height: 1.18;
  }

  .story-description {
    max-width: 720px;
    margin: 24px 0 0;
    color: #514331;
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-weight: 700;
  }

  .story-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin-top: 24px;
    font-size: 0.9rem;
    font-weight: 800;
  }

  .story-body {
    padding-block: clamp(36px, 6vw, 68px);
    font-size: clamp(1rem, 1.5vw, 1.08rem);
    line-height: 2;
  }

  .story-body :global(h2) {
    margin: 2.5em 0 0.8em;
    border-left: 8px solid #35aa2f;
    padding-left: 18px;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.45;
  }

  .story-body :global(p) {
    margin: 1.25em 0;
  }

  .story-body :global(a) {
    color: #0756a8;
    font-weight: 700;
    text-underline-offset: 0.18em;
  }

  .story-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    border-top: 4px solid #1e1710;
    padding-top: 28px;
  }

  .story-footer a {
    border: 2px solid #1e1710;
    border-radius: 8px;
    background: #ffd84d;
    padding: 10px 16px;
    font-weight: 900;
    text-decoration: none;
    box-shadow: 0 4px 0 rgba(21, 19, 15, 0.28);
  }
</style>
