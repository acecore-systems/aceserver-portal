---
import { getCollection } from 'astro:content'
import StoriesIndex from '../../components/StoriesIndex.astro'
import { getUi } from '../../i18n/translations'
import BaseLayout from '../../layouts/BaseLayout.astro'

const locale = 'ja'
const ui = getUi(locale)
const stories = (await getCollection('stories'))
  .filter((story) => !story.id.includes('/'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
---

<BaseLayout
  locale={locale}
  title={ui.storiesTitle}
  description={ui.storiesDescription}
>
  <StoriesIndex locale={locale} stories={stories} />
</BaseLayout>
