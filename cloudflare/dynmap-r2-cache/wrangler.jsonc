{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aceserver-dynmap-r2-cache",
  "main": "worker.js",
  "compatibility_date": "2026-06-12",
  "r2_buckets": [
    {
      "binding": "MAIN_BUCKET",
      "bucket_name": "acecore-dynmap-main",
    },
    {
      "binding": "SIGEN_BUCKET",
      "bucket_name": "acecore-dynmap-sigen",
    },
    {
      "binding": "RPG_BUCKET",
      "bucket_name": "acecore-dynmap-rpg",
    },
    {
      "binding": "SEASON_A_BUCKET",
      "bucket_name": "acecore-dynmap-season-a",
    },
  ],
}
