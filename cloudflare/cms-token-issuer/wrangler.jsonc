{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aceserver-portal-cms-token-issuer",
  "main": "worker.ts",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,
  "preview_urls": false,
  "secrets": {
    "required": [
      "CMS_GITHUB_APP_CLIENT_ID",
      "CMS_GITHUB_APP_INSTALLATION_ID",
      "CMS_GITHUB_APP_PRIVATE_KEY",
    ],
  },
}
